---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import Section from '../components/Section.astro';

import { getEntry } from 'astro:content';
const page = await getEntry('pages', 'iletisim');
const data = page?.data || { title: "İletişim" };
---
<BaseLayout title={data.title} seoTitle={data.seoTitle} seoDescription={data.seoDescription}>
  <PageHeader title={data.title} description={data.description} />

  <Section>
    <div class="contact-grid">

      <!-- ═══ Left: contact info ═══════════════════════════════ -->
      <div class="contact-info">

        <h2 class="contact-heading">Bize Ulaşın</h2>
        <p class="contact-body">
          Projeleriniz, danışmanlık talepleriniz veya herhangi bir sorunuz için
          aşağıdaki e-posta adresinden ulaşabilirsiniz.
        </p>

        <div class="contact-method">
          <div class="contact-icon" aria-hidden="true">
            <svg width="18" height="18" fill="none" stroke="currentColor"
                 stroke-width="1.5" viewBox="0 0 24 24"
                 stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="2" y="4" width="20" height="16" rx="2" />
              <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7" />
            </svg>
          </div>
          <div>
            <p class="contact-method-label">E-posta</p>
            <a href="mailto:info@akasoftware.com" class="contact-email">
              info@akasoftware.com
            </a>
          </div>
        </div>

      </div>

      <!-- ═══ Right: form card ══════════════════════════════════ -->
      <div class="card contact-card">

        <!-- Gold top accent line -->
        <div class="contact-card-accent" aria-hidden="true"></div>

        <h3 class="contact-form-heading">Mesaj Gönderin</h3>

        <!-- ── Form (hidden after successful submit) ── -->
        <form
          class="contact-form"
          id="contact-form"
          action="/api/contact"
          method="post"
          novalidate
        >

          <!-- Honeypot — bots fill this, humans don't see it -->
          <div class="hp-field" aria-hidden="true">
            <label for="website">Website</label>
            <input type="text" id="website" name="website" tabindex="-1" autocomplete="off" />
          </div>

          <!-- Name -->
          <div class="form-row">
            <label for="name" class="form-label">
              Adınız Soyadınız
              <span class="form-required" aria-hidden="true">*</span>
            </label>
            <input
              type="text"
              id="name"
              name="name"
              required
              autocomplete="name"
              maxlength="100"
              class="input-field"
              placeholder="Ahmet Yılmaz"
              aria-describedby="name-error"
            />
            <span class="field-error" id="name-error" role="alert"></span>
          </div>

          <!-- Email -->
          <div class="form-row">
            <label for="email" class="form-label">
              E-posta Adresiniz
              <span class="form-required" aria-hidden="true">*</span>
            </label>
            <input
              type="email"
              id="email"
              name="email"
              required
              autocomplete="email"
              maxlength="254"
              class="input-field"
              placeholder="ahmet@ornek.com"
              aria-describedby="email-error"
            />
            <span class="field-error" id="email-error" role="alert"></span>
          </div>

          <!-- Message -->
          <div class="form-row">
            <label for="message" class="form-label">
              Mesajınız
              <span class="form-required" aria-hidden="true">*</span>
            </label>
            <textarea
              id="message"
              name="message"
              rows="4"
              required
              maxlength="2000"
              class="input-field"
              placeholder="Projeniz veya sorunuz hakkında kısaca bilgi verin…"
              aria-describedby="message-error"
            ></textarea>
            <span class="field-error" id="message-error" role="alert"></span>
          </div>

          <!-- Form-level error (rate limit, server error, etc.) -->
          <p class="form-error-box" id="form-error" role="alert" hidden></p>

          <!-- Submit -->
          <button type="submit" class="btn-primary contact-submit" id="contact-submit">
            <span class="contact-submit-label" id="contact-submit-label">
              Gönder
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none"
                   stroke="currentColor" stroke-width="2.2"
                   stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M5 12h14M12 5l7 7-7 7"/>
              </svg>
            </span>
          </button>

        </form>

        <!-- ── Success panel (shown after successful submit) ── -->
        <div class="contact-success" id="contact-success" hidden aria-live="polite">
          <div class="cs-icon" aria-hidden="true">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none"
                 stroke="currentColor" stroke-width="2"
                 stroke-linecap="round" stroke-linejoin="round">
              <path d="M20 6L9 17l-5-5"/>
            </svg>
          </div>
          <h4 class="cs-title">Mesajınız alındı!</h4>
          <p class="cs-body">
            En kısa sürede size geri dönüş yapacağız. Ortalama yanıt süremiz 24 saattir.
          </p>
          <button type="button" class="cs-reset" id="contact-reset">
            Başka bir mesaj gönder
          </button>
        </div>

      </div>

    </div>
  </Section>
</BaseLayout>

<style>
  /* ════ Contact grid ══════════════════════════════════════════ */
  .contact-grid {
    display              : grid;
    grid-template-columns: 1fr;
    gap                  : 2.5rem;
    max-width            : 54rem;
    margin               : 0 auto;
  }
  @media (min-width: 768px) {
    .contact-grid {
      grid-template-columns: 1fr 1.45fr;
      gap                  : 4rem;
      align-items          : start;
    }
  }

  /* ════ Info column ═══════════════════════════════════════════ */
  .contact-info {
    display       : flex;
    flex-direction: column;
    gap           : 1.5rem;
  }

  .contact-heading {
    font-size     : 1.375rem;
    font-weight   : 700;
    letter-spacing: -0.022em;
    line-height   : 1.2;
    color         : rgb(var(--color-fg));
  }

  .contact-body {
    font-size  : 0.9375rem;
    line-height: 1.74;
    color      : rgb(var(--color-fg-muted));
    max-width  : 38ch;
  }

  .contact-method {
    display    : flex;
    align-items: flex-start;
    gap        : 1rem;
    margin-top : 0.5rem;
  }

  .contact-icon {
    display        : flex;
    align-items    : center;
    justify-content: center;
    width          : 2.5rem;
    height         : 2.5rem;
    flex-shrink    : 0;
    border-radius  : 0.75rem;
    background     : rgb(var(--color-accent) / 0.10);
    color          : rgb(var(--color-accent));
    border         : 1px solid rgb(var(--color-accent) / 0.22);
  }

  .contact-method-label {
    font-size     : 0.75rem;
    font-weight   : 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color         : rgb(var(--color-fg-faint));
    margin-bottom : 0.25rem;
  }

  .contact-email {
    font-size      : 0.9375rem;
    font-weight    : 500;
    color          : rgb(var(--color-accent));
    text-decoration: none;
    transition     : color 150ms ease;
  }
  .contact-email:hover { color: rgb(var(--color-accent-bright)); }
  .contact-email:focus-visible {
    outline       : 2px solid rgb(var(--color-ring));
    outline-offset: 3px;
    border-radius : 4px;
  }

  /* ════ Form card ═════════════════════════════════════════════ */
  .contact-card {
    position: relative;
    padding : 2rem;
  }
  @media (min-width: 640px) { .contact-card { padding: 2.25rem; } }

  .contact-card-accent {
    position  : absolute;
    top       : 0;
    left      : 1.5rem;
    right     : 1.5rem;
    height    : 1px;
    background: linear-gradient(
      to right,
      transparent,
      rgb(var(--color-accent) / 0.45) 30%,
      rgb(var(--color-accent) / 0.55) 50%,
      rgb(var(--color-accent) / 0.45) 70%,
      transparent
    );
  }

  .contact-form-heading {
    font-size     : 1.0625rem;
    font-weight   : 700;
    letter-spacing: -0.016em;
    color         : rgb(var(--color-fg));
    margin-bottom : 1.75rem;
  }

  /* ════ Form ══════════════════════════════════════════════════ */
  .contact-form {
    display       : flex;
    flex-direction: column;
    gap           : 1.125rem;
  }

  /* Honeypot — positioned off-screen, visually inaccessible */
  .hp-field {
    position  : absolute;
    left      : -9999px;
    width     : 1px;
    height    : 1px;
    overflow  : hidden;
    opacity   : 0;
    pointer-events: none;
    tab-index : -1;
  }

  .form-row {
    display       : flex;
    flex-direction: column;
    gap           : 0.375rem;
  }

  .form-label {
    font-size     : 0.8125rem;
    font-weight   : 500;
    letter-spacing: 0.01em;
    color         : rgb(var(--color-fg-muted));
  }

  .form-required {
    color      : rgb(var(--color-accent));
    margin-left: 0.1875rem;
  }

  /* Error state on input fields */
  .input-field.is-error {
    border-color: rgba(248, 113, 113, 0.60);
    box-shadow  : 0 0 0 3px rgba(248, 113, 113, 0.10);
  }
  .input-field.is-error:focus {
    border-color: rgba(248, 113, 113, 0.80);
    box-shadow  : 0 0 0 3px rgba(248, 113, 113, 0.15);
  }

  /* Per-field error text */
  .field-error {
    display    : block;
    font-size  : 0.75rem;
    font-weight: 500;
    color      : rgba(248, 113, 113, 0.90);
    min-height : 1rem; /* prevents layout shift */
  }

  /* Form-level error box (rate limit, server error) */
  .form-error-box {
    font-size    : 0.875rem;
    font-weight  : 500;
    padding      : 0.75rem 1rem;
    border-radius: 0.625rem;
    color        : rgba(248, 113, 113, 0.90);
    background   : rgba(248, 113, 113, 0.07);
    border       : 1px solid rgba(248, 113, 113, 0.20);
    margin-top   : 0.125rem;
  }

  /* ════ Submit button ══════════════════════════════════════════ */
  .contact-submit {
    width          : 100%;
    justify-content: center;
    padding        : 0.875rem 1.5rem;
    font-size      : 0.9375rem;
    margin-top     : 0.375rem;
  }
  .contact-submit[disabled] {
    opacity       : 0.72;
    cursor        : not-allowed;
    pointer-events: none;
  }
  .contact-submit-label {
    display    : inline-flex;
    align-items: center;
    gap        : 0.4375rem;
  }

  /* Loading spinner */
  @keyframes spin { to { transform: rotate(360deg); } }
  .spinner { animation: spin 0.75s linear infinite; }

  /* ════ Success panel ══════════════════════════════════════════ */
  @keyframes cs-enter {
    from { opacity: 0; transform: translateY(8px); }
    to   { opacity: 1; transform: translateY(0);   }
  }

  .contact-success {
    display       : flex;
    flex-direction: column;
    align-items   : center;
    text-align    : center;
    gap           : 1rem;
    padding       : 1.5rem 1rem;
    animation     : cs-enter 400ms var(--ease-expo, cubic-bezier(0.16,1,0.3,1)) both;
  }

  .cs-icon {
    display        : flex;
    align-items    : center;
    justify-content: center;
    width          : 3rem;
    height         : 3rem;
    border-radius  : 9999px;
    background     : rgba(74, 222, 128, 0.10);
    color          : rgba(74, 222, 128, 0.90);
    border         : 1px solid rgba(74, 222, 128, 0.25);
    flex-shrink    : 0;
  }

  .cs-title {
    font-size     : 1.0625rem;
    font-weight   : 700;
    letter-spacing: -0.016em;
    color         : rgb(var(--color-fg));
  }

  .cs-body {
    font-size  : 0.875rem;
    line-height: 1.72;
    color      : rgb(var(--color-fg-muted));
    max-width  : 32ch;
  }

  .cs-reset {
    display        : inline-flex;
    align-items    : center;
    font-size      : 0.8125rem;
    font-weight    : 600;
    color          : rgb(var(--color-accent));
    background     : none;
    border         : none;
    cursor         : pointer;
    padding        : 0.25rem 0;
    margin-top     : 0.25rem;
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: rgb(var(--color-accent) / 0.40);
    transition     : color 150ms ease, text-decoration-color 150ms ease;
  }
  .cs-reset:hover {
    color                : rgb(var(--color-accent-bright));
    text-decoration-color: rgb(var(--color-accent-bright) / 0.60);
  }
  .cs-reset:focus-visible {
    outline       : 2px solid rgb(var(--color-ring));
    outline-offset: 3px;
    border-radius : 4px;
  }
</style>

<script is:inline>
(function () {
  'use strict';

  var form    = document.getElementById('contact-form');
  var btn     = document.getElementById('contact-submit');
  var label   = document.getElementById('contact-submit-label');
  var errBox  = document.getElementById('form-error');
  var success = document.getElementById('contact-success');
  var resetBtn = document.getElementById('contact-reset');

  if (!form) return;

  // ── Validation rules ───────────────────────────────────────────
  var rules = {
    name: {
      el: form.elements.namedItem('name'),
      errId: 'name-error',
      check: function (v) {
        if (!v)          return 'Ad soyad zorunludur.';
        if (v.length < 2) return 'En az 2 karakter girin.';
        if (v.length > 100) return 'Ad soyad çok uzun (max 100 karakter).';
        return null;
      }
    },
    email: {
      el: form.elements.namedItem('email'),
      errId: 'email-error',
      check: function (v) {
        if (!v) return 'E-posta adresi zorunludur.';
        if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(v)) return 'Geçerli bir e-posta adresi girin.';
        return null;
      }
    },
    message: {
      el: form.elements.namedItem('message'),
      errId: 'message-error',
      check: function (v) {
        if (!v)            return 'Mesaj zorunludur.';
        if (v.length < 10) return 'En az 10 karakter girin.';
        if (v.length > 2000) return 'Mesaj 2000 karakteri aşamaz.';
        return null;
      }
    }
  };

  // ── Field helpers ──────────────────────────────────────────────
  function setFieldError(key, msg) {
    var r = rules[key];
    document.getElementById(r.errId).textContent = msg;
    r.el.classList.add('is-error');
    r.el.setAttribute('aria-invalid', 'true');
  }

  function clearFieldError(key) {
    var r = rules[key];
    document.getElementById(r.errId).textContent = '';
    r.el.classList.remove('is-error');
    r.el.removeAttribute('aria-invalid');
  }

  // Clear per-field error as user types
  Object.keys(rules).forEach(function (k) {
    rules[k].el.addEventListener('input', function () { clearFieldError(k); });
  });

  // Returns key of first invalid field, or null if all valid
  function validateAll() {
    var first = null;
    Object.keys(rules).forEach(function (k) {
      var msg = rules[k].check(rules[k].el.value.trim());
      if (msg) {
        setFieldError(k, msg);
        if (!first) first = k;
      } else {
        clearFieldError(k);
      }
    });
    return first;
  }

  // ── Loading state ──────────────────────────────────────────────
  var LABEL_DEFAULT = label.innerHTML;
  var LABEL_LOADING =
    '<svg class="spinner" width="14" height="14" viewBox="0 0 24 24" fill="none"' +
    ' stroke="currentColor" stroke-width="2.5" aria-hidden="true">' +
    '<circle cx="12" cy="12" r="10" stroke-opacity="0.25"/>' +
    '<path d="M12 2a10 10 0 0 1 10 10" stroke-linecap="round"/>' +
    '</svg> Gönderiliyor\u2026';

  function setLoading(on) {
    btn.disabled   = on;
    label.innerHTML = on ? LABEL_LOADING : LABEL_DEFAULT;
    form.querySelectorAll('.input-field').forEach(function (el) {
      el.disabled = on;
    });
  }

  // ── Submit ─────────────────────────────────────────────────────
  form.addEventListener('submit', async function (e) {
    e.preventDefault();

    // Clear any form-level error
    errBox.hidden      = true;
    errBox.textContent = '';

    // Client-side validation first
    var firstInvalid = validateAll();
    if (firstInvalid) {
      rules[firstInvalid].el.focus();
      return;
    }

    setLoading(true);

    try {
      var res  = await fetch('/api/contact', { method: 'POST', body: new FormData(form) });
      var json = await res.json().catch(function () { return {}; });

      if (res.ok && json.success) {
        // ── Success: hide form, show success panel ──────────────
        form.hidden    = true;
        success.hidden = false;
        success.querySelector('.cs-title').focus();
      } else {
        // ── API error: show form-level message ──────────────────
        // If server tells us which field, highlight it
        if (json.field && rules[json.field]) {
          setFieldError(json.field, json.error);
          rules[json.field].el.focus();
        } else {
          errBox.textContent = json.error || 'Bir hata oluştu. Lütfen tekrar deneyin.';
          errBox.hidden      = false;
        }
        setLoading(false);
      }
    } catch (_) {
      errBox.textContent = 'Bağlantı hatası. İnternet bağlantınızı kontrol edip tekrar deneyin.';
      errBox.hidden      = false;
      setLoading(false);
    }
  });

  // ── Reset (send another message) ───────────────────────────────
  if (resetBtn) {
    resetBtn.addEventListener('click', function () {
      form.reset();
      Object.keys(rules).forEach(function (k) { clearFieldError(k); });
      errBox.hidden      = true;
      success.hidden     = true;
      form.hidden        = false;
      setLoading(false);
      rules.name.el.focus();
    });
  }
}());
</script>
