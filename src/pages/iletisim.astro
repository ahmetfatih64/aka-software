---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import Section from '../components/Section.astro';

import { getEntry } from 'astro:content';
const page = await getEntry('pages', 'iletisim');
const data = page?.data || { title: "İletişim" };
---
<BaseLayout title={data.title} seoTitle={data.seoTitle} seoDescription={data.seoDescription}>
  <PageHeader title={data.title} description={data.description} />

  <Section>
    <div class="contact-grid">

      <!-- ═══ Left: contact info ═══════════════════════════════ -->
      <div class="contact-info">

        <h2 class="contact-heading">Bize Ulaşın</h2>
        <p class="contact-body">
          Projeleriniz, danışmanlık talepleriniz veya herhangi bir sorunuz için
          aşağıdaki e-posta adresinden ulaşabilirsiniz.
        </p>

        <div class="contact-method">
          <div class="contact-icon" aria-hidden="true">
            <svg width="18" height="18" fill="none" stroke="currentColor"
                 stroke-width="1.5" viewBox="0 0 24 24"
                 stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="2" y="4" width="20" height="16" rx="2" />
              <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7" />
            </svg>
          </div>
          <div>
            <p class="contact-method-label">E-posta</p>
            <a href="mailto:info@akasoftware.com" class="contact-email">
              info@akasoftware.com
            </a>
          </div>
        </div>

      </div>

      <!-- ═══ Right: form card ══════════════════════════════════ -->
      <div class="card contact-card">

        <!-- Gold top accent line -->
        <div class="contact-card-accent" aria-hidden="true"></div>

        <h3 class="contact-form-heading">Mesaj Gönderin</h3>

        <form class="contact-form" data-netlify="true" name="contact">

          <div class="form-row">
            <label for="name" class="form-label">Adınız Soyadınız</label>
            <input
              type="text"
              id="name"
              name="name"
              required
              autocomplete="name"
              class="input-field"
              placeholder="Ahmet Yılmaz"
            />
          </div>

          <div class="form-row">
            <label for="email" class="form-label">E-posta Adresiniz</label>
            <input
              type="email"
              id="email"
              name="email"
              required
              autocomplete="email"
              class="input-field"
              placeholder="ahmet@ornek.com"
            />
          </div>

          <div class="form-row">
            <label for="message" class="form-label">Mesajınız</label>
            <textarea
              id="message"
              name="message"
              rows="4"
              required
              class="input-field"
              placeholder="Projeniz veya sorunuz hakkında kısaca bilgi verin…"
            ></textarea>
          </div>

          <button type="submit" class="btn-primary contact-submit">
            Gönder
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none"
                 stroke="currentColor" stroke-width="2.2"
                 stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M5 12h14M12 5l7 7-7 7"/>
            </svg>
          </button>

        </form>
      </div>

    </div>
  </Section>
</BaseLayout>

<style>
  /* ════ Contact grid ══════════════════════════════════════════ */
  .contact-grid {
    display              : grid;
    grid-template-columns: 1fr;
    gap                  : 2.5rem;
    max-width            : 54rem;
    margin               : 0 auto;
  }
  @media (min-width: 768px) {
    .contact-grid {
      grid-template-columns: 1fr 1.45fr;
      gap                  : 4rem;
      align-items          : start;
    }
  }

  /* ════ Info column ═══════════════════════════════════════════ */
  .contact-info {
    display       : flex;
    flex-direction: column;
    gap           : 1.5rem;
  }

  .contact-heading {
    font-size     : 1.375rem;
    font-weight   : 700;
    letter-spacing: -0.022em;
    line-height   : 1.2;
    color         : rgb(var(--color-fg));
  }

  .contact-body {
    font-size  : 0.9375rem;
    line-height: 1.74;
    color      : rgb(var(--color-fg-muted));
    max-width  : 38ch;
  }

  /* Contact method row */
  .contact-method {
    display    : flex;
    align-items: flex-start;
    gap        : 1rem;
    margin-top : 0.5rem;
  }

  .contact-icon {
    display        : flex;
    align-items    : center;
    justify-content: center;
    width          : 2.5rem;
    height         : 2.5rem;
    flex-shrink    : 0;
    border-radius  : 0.75rem;
    background     : rgb(var(--color-accent) / 0.10);
    color          : rgb(var(--color-accent));
    border         : 1px solid rgb(var(--color-accent) / 0.22);
  }

  .contact-method-label {
    font-size  : 0.75rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color      : rgb(var(--color-fg-faint));
    margin-bottom: 0.25rem;
  }

  .contact-email {
    font-size     : 0.9375rem;
    font-weight   : 500;
    color         : rgb(var(--color-accent));
    text-decoration: none;
    transition    : color 150ms ease, opacity 150ms ease;
  }
  .contact-email:hover { color: rgb(var(--color-accent-bright)); }
  .contact-email:focus-visible {
    outline       : 2px solid rgb(var(--color-ring));
    outline-offset: 3px;
    border-radius : 4px;
  }

  /* ════ Form card ═════════════════════════════════════════════ */
  .contact-card {
    position: relative;
    padding : 2rem;
  }
  @media (min-width: 640px) { .contact-card { padding: 2.25rem; } }

  /* Top accent line — matches svc-card treatment */
  .contact-card-accent {
    position  : absolute;
    top       : 0;
    left      : 1.5rem;
    right     : 1.5rem;
    height    : 1px;
    background: linear-gradient(
      to right,
      transparent,
      rgb(var(--color-accent) / 0.45) 30%,
      rgb(var(--color-accent) / 0.55) 50%,
      rgb(var(--color-accent) / 0.45) 70%,
      transparent
    );
  }

  .contact-form-heading {
    font-size     : 1.0625rem;
    font-weight   : 700;
    letter-spacing: -0.016em;
    color         : rgb(var(--color-fg));
    margin-bottom : 1.75rem;
  }

  /* ════ Form elements ══════════════════════════════════════════ */
  .contact-form {
    display       : flex;
    flex-direction: column;
    gap           : 1.25rem;
  }

  .form-row {
    display       : flex;
    flex-direction: column;
    gap           : 0.5rem;
  }

  .form-label {
    font-size     : 0.8125rem;
    font-weight   : 500;
    letter-spacing: 0.01em;
    color         : rgb(var(--color-fg-muted));
  }

  /* ════ Submit button ══════════════════════════════════════════ */
  .contact-submit {
    width          : 100%;
    justify-content: center;
    padding        : 0.875rem 1.5rem;
    font-size      : 0.9375rem;
    margin-top     : 0.25rem;
  }
</style>
