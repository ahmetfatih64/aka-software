---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import Section from '../components/Section.astro';
import CardGrid from '../components/CardGrid.astro';
import CTA from '../components/CTA.astro';

import { getEntry } from 'astro:content';
const page = await getEntry('pages', 'hizmetler');
const data = page?.data || { title: "Hizmetlerimiz" };
const { services, cta } = (data as any).sections || {};

const svcIcons: Record<string, string> = {
  WB: `<svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="3" width="20" height="14" rx="2" /><path d="m8 21 4-4 4 4" /></svg>`,
  AI: `<svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 2a4 4 0 0 0-4 4v2H6a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V10a2 2 0 0 0-2-2h-2V6a4 4 0 0 0-4-4Z" /><circle cx="12" cy="15" r="2" /></svg>`,
  VID: `<svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polygon points="23 7 16 12 23 17 23 7" /><rect x="1" y="5" width="15" height="14" rx="2" /></svg>`,
  B2B: `<svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z" /><path d="M3 6h18" /><path d="M16 10a4 4 0 0 1-8 0" /></svg>`,
  PRT: `<svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" /><circle cx="9" cy="7" r="4" /><path d="M22 21v-2a4 4 0 0 0-3-3.87" /><path d="M16 3.13a4 4 0 0 1 0 7.75" /></svg>`,
  CRM: `<svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22c5.523 0 10-4.477 10-10S17.523 2 12 2 2 6.477 2 12s4.477 10 10 10z" /><path d="m9 12 2 2 4-4" /><path d="M21 12a9 9 0 1 1-9-9" /><path d="M22 2 13 11" /></svg>`,
  CTO: `<svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 20h9" /><path d="M16.376 3.622a1 1 0 0 1 3.002 3.002L7.368 18.635a2 2 0 0 1-.855.506l-2.872.838.838-2.872a2 2 0 0 1 .506-.855Z" /></svg>`,
};
---
<BaseLayout title={data.title} seoTitle={(data as any).seoTitle} seoDescription={(data as any).seoDescription}>
  <PageHeader title={data.title} description={(data as any).description}
              titleKey="page.services.title" descriptionKey="page.services.description" />

  {services?.items?.length > 0 && (
    <Section>
      <CardGrid columns={3}>
        {services.items.map((svc: any, i: number) => (
          <div class="card card-hover">
            <div class="svc-icon-wrap" set:html={svcIcons[svc.icon] ?? ''}></div>
            <h3 class="svc-title" data-i18n={`services.item${i}.title`}>{svc.title}</h3>
            <p class="svc-desc" data-i18n={`services.item${i}.desc`}>{svc.description}</p>
            {svc.features?.length > 0 && (
              <ul class="svc-features">
                {svc.features.map((f: string, j: number) => (
                  <li data-i18n={`services.item${i}.feat${j}`}>{f}</li>
                ))}
              </ul>
            )}
          </div>
        ))}
      </CardGrid>
    </Section>
  )}

  <CTA
    title={cta?.title ?? "Projeniz İçin Teknik Çözüm Arıyorsanız Görüşelim"}
    description={cta?.description ?? "Sizi dinleyelim ve iş hedeflerinize uygun teknoloji yol haritasını birlikte çıkaralım."}
    buttonText={cta?.buttonText}
    buttonLink={cta?.buttonLink}
    titleKey="services.cta.title"
    descriptionKey="services.cta.description"
    buttonKey="services.cta.button"
  />
</BaseLayout>

<style>
  .svc-icon-wrap {
    margin-bottom    : 1rem;
    display          : inline-flex;
    align-items      : center;
    justify-content  : center;
    width            : 2.5rem;
    height           : 2.5rem;
    border-radius    : 0.75rem;
    background       : rgb(var(--color-accent) / 0.10);
    color            : rgb(var(--color-accent));
    border           : 1px solid rgb(var(--color-accent) / 0.20);
  }

  .svc-title {
    font-size    : 1.0625rem;
    font-weight  : 700;
    margin-bottom: 0.5rem;
    color        : rgb(var(--color-fg));
  }

  .svc-desc {
    font-size  : 0.875rem;
    line-height: 1.72;
    margin-bottom: 1rem;
    color      : rgb(var(--color-fg-muted));
  }

  .svc-features {
    list-style : none;
    padding    : 0;
    margin     : 0;
    display    : flex;
    flex-direction: column;
    gap        : 0.375rem;
    font-size  : 0.875rem;
    color      : rgb(var(--color-fg-faint));
  }
</style>
