---
import BaseLayout           from '../layouts/BaseLayout.astro';
import Hero                 from '../components/Hero.astro';
import Section              from '../components/Section.astro';
import ProofStrip           from '../components/ProofStrip.astro';
import CapabilityShowcase   from '../components/CapabilityShowcase.astro';
import FeaturedCaseStudies  from '../components/FeaturedCaseStudies.astro';
import FeaturedInsights     from '../components/FeaturedInsights.astro';
import TestimonialList      from '../components/TestimonialList.astro';
import FinalCTA             from '../components/FinalCTA.astro';

import { getEntry } from 'astro:content';
const homeEntry = await getEntry('pages', 'home');

const data = homeEntry?.data || {
  title: "AKA Software",
  seoTitle: "AI ve Modern Yazılım Danışmanlığı | AKA Software",
  seoDescription: "AKA Software ile işletmenizi geleceğe taşıyın.",
  sections: {
    hero: {
      title: "Teknik Vizyonunuzu Çalışan Sisteme Dönüştürüyoruz",
      description: "Yapay zeka entegrasyonu, modern ürün mühendisliği ve mimari danışmanlıkla gerçek teslimat yapıyoruz — konsept değil.",
      primaryCtaText: "Keşif Görüşmesi Ayarlayalım",
      primaryCtaLink: "/iletisim",
      secondaryCtaText: "Vaka Çalışmalarını İncele",
      secondaryCtaLink: "/vaka-calismalari"
    },
    process: {
      title: "Nasıl Çalışıyoruz?",
      description: "Her projeyi dört net adımda hayata geçiriyoruz.",
      items: [
        { step: "01", title: "Keşif Görüşmesi",   description: "İhtiyaçlarınızı anlamak için ücretsiz bir ön görüşme yapıyoruz." },
        { step: "02", title: "Planlama & Teklif",  description: "Teknik mimari, zaman çizelgesi ve detaylı teklif hazırlıyoruz." },
        { step: "03", title: "Geliştirme",          description: "Agile süreçlerle iteratif geliştirme ve haftalık ilerleme paylaşımları." },
        { step: "04", title: "Teslim & Destek",    description: "Canlıya alma, dokümantasyon ve sürekli destek süreci." },
      ]
    },
    testimonials: {
      title: "Müşterilerimiz Neler Diyor?",
      items: [
        { quote: "AKA Software sayesinde süreçlerimizi %40 hızlandırdık. Harika bir iş çıkardılar.", author: "Ürün Lideri (NDA)", role: "E-Ticaret Platformu" },
        { quote: "Yapay zeka entegrasyonumuzu pürüzsüz bir şekilde canlıya aldılar.", author: "Teknoloji Yöneticisi (NDA)", role: "Finans Teknolojileri" }
      ]
    },
    cta: {
      title: "Güçlü bir teknoloji partneri arıyorsanız doğru yerdesiniz",
      description: "Projenizi anlayalım, teknik yaklaşımı birlikte tasarlayalım. İlk görüşme ücretsiz ve bağlayıcı değil.",
      buttonText: "Keşif Görüşmesi Ayarlayalım",
      buttonLink: "/iletisim"
    }
  }
};

const { hero, process: processSection, testimonials, cta } = data.sections || {};
type ProcessStep = { step: string; title: string; description: string };
const processSteps: ProcessStep[] = processSection?.items ?? [];
---

<BaseLayout title={data.title} seoTitle={data.seoTitle} seoDescription={data.seoDescription}>

  <!-- ═══ 1. Hero ══════════════════════════════════════════════ -->
  {hero && (
    <Hero
      title={hero.title}
      description={hero.description}
      primaryCtaText={hero.primaryCtaText}
      primaryCtaLink={hero.primaryCtaLink}
      secondaryCtaText={hero.secondaryCtaText}
      secondaryCtaLink={hero.secondaryCtaLink}
    />
  )}

  <!-- ═══ 2. Proof Strip ═══════════════════════════════════════ -->
  <ProofStrip />

  <!-- ═══ 3. Capability Showcase — "Neden AKA?" ════════════════ -->
  <CapabilityShowcase />

  <!-- ═══ 4. Featured Case Studies ════════════════════════════ -->
  <FeaturedCaseStudies />

  <!-- ═══ 5. Process ════════════════════════════════════════════ -->
  <Section
    title={processSection?.title ?? "Nasıl Çalışıyoruz?"}
    description={processSection?.description ?? "Her projeyi dört net adımda hayata geçiriyoruz."}
    eyebrow="Süreç"
    bg="muted"
    titleKey="process.title"
    descriptionKey="process.description"
    eyebrowKey="process.eyebrow"
  >
    <div class="proc-grid">
      {processSteps.map((item, idx) => (
        <div class="proc-step reveal" style={`transition-delay: ${idx * 70}ms`}>
          <span class="proc-bg-num" aria-hidden="true">{item.step}</span>
          <div class="proc-badge">{item.step}</div>
          {idx < processSteps.length - 1 && (
            <div class="proc-connector" aria-hidden="true"></div>
          )}
          <h3 class="proc-title" data-i18n={`process.step${idx}.title`}>{item.title}</h3>
          <p class="proc-desc" data-i18n={`process.step${idx}.desc`}>{item.description}</p>
        </div>
      ))}
    </div>
  </Section>

  <!-- ═══ 6. Featured Insights / Blog ═════════════════════════ -->
  <FeaturedInsights />

  <!-- ═══ 7. Testimonials ══════════════════════════════════════ -->
  {testimonials && testimonials.items && testimonials.items.length > 0 && (
    <Section
      title={testimonials.title ?? "Müşterilerimiz Neler Diyor?"}
      eyebrow="Referanslar"
      description="NDA kapsamında çalıştığımız müşterilerimizden geri bildirimler."
      bg="muted"
      titleKey="testimonials.title"
      descriptionKey="testimonials.description"
      eyebrowKey="testimonials.eyebrow"
    >
      <TestimonialList testimonials={testimonials.items} />
    </Section>
  )}

  <!-- ═══ 8. Final CTA ════════════════════════════════════════ -->
  <FinalCTA
    title={cta?.title}
    description={cta?.description}
    buttonText={cta?.buttonText}
    buttonLink={cta?.buttonLink}
  />

</BaseLayout>

<style>
  /* ════════════════════════════════════════════════════════════
     PROCESS STEPS
     (Kept in index.astro since it's homepage-specific layout)
  ════════════════════════════════════════════════════════════ */

  .proc-grid {
    display              : grid;
    grid-template-columns: 1fr;
    gap                  : 1rem;
  }
  @media (min-width: 640px) {
    .proc-grid { grid-template-columns: 1fr 1fr; gap: 1.25rem; }
  }
  @media (min-width: 1024px) {
    .proc-grid { grid-template-columns: repeat(4, 1fr); gap: 1.25rem; }
  }

  .proc-step {
    position     : relative;
    padding      : 1.5rem;
    border-radius: 1rem;
    border       : 1px solid rgb(var(--color-border));
    background   : rgb(var(--color-card));
    overflow     : hidden;
    transition   :
      border-color 220ms ease,
      box-shadow   220ms ease,
      transform    220ms cubic-bezier(0.22, 1, 0.36, 1);
    background-image: linear-gradient(to bottom, rgb(var(--color-accent) / 0.05) 0px, transparent 1px);
  }
  .proc-step:hover {
    border-color: rgb(var(--color-accent) / 0.28);
    box-shadow  : 0 0 18px rgb(var(--color-glow) / 0.10), 0 8px 28px rgba(0,0,0,0.16);
    transform   : translateY(-2px);
  }

  .proc-bg-num {
    position      : absolute;
    bottom        : -0.625rem;
    right         : 0.75rem;
    font-size     : 5.5rem;
    font-weight   : 900;
    line-height   : 1;
    letter-spacing: -0.04em;
    color         : rgb(var(--color-accent) / 0.055);
    user-select   : none;
    pointer-events: none;
  }

  .proc-badge {
    display        : inline-flex;
    align-items    : center;
    justify-content: center;
    width          : 2rem;
    height         : 2rem;
    border-radius  : 0.5rem;
    background     : rgb(var(--color-accent) / 0.10);
    color          : rgb(var(--color-accent));
    border         : 1px solid rgb(var(--color-accent) / 0.24);
    font-size      : 0.6875rem;
    font-weight    : 700;
    letter-spacing : 0.02em;
    margin-bottom  : 1rem;
    position       : relative;
    z-index        : 1;
  }

  .proc-connector { display: none; }
  @media (min-width: 1024px) {
    .proc-connector {
      display   : block;
      position  : absolute;
      top       : 2.375rem;
      right     : -0.625rem;
      width     : 1.25rem;
      height    : 1px;
      background: linear-gradient(to right, rgb(var(--color-accent) / 0.28), rgb(var(--color-border)));
      z-index   : 10;
    }
  }

  .proc-title {
    font-size     : 1rem;
    font-weight   : 700;
    letter-spacing: -0.016em;
    color         : rgb(var(--color-fg));
    margin-bottom : 0.5rem;
    position      : relative;
    z-index       : 1;
  }
  .proc-desc {
    font-size  : 0.875rem;
    line-height: 1.72;
    color      : rgb(var(--color-fg-muted));
    position   : relative;
    z-index    : 1;
  }
</style>
