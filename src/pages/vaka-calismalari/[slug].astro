---
export const prerender = false;
// SSR dynamic route — fetch at request time
import { getEntry } from 'astro:content';
import BaseLayout      from '../../layouts/BaseLayout.astro';
import MarkdownContent from '../../components/MarkdownContent.astro';
import FinalCTA        from '../../components/FinalCTA.astro';

const { slug } = Astro.params;
const study = await getEntry('case-studies', slug!);

if (!study) {
  return Astro.redirect('/404');
}

const { Content } = await study.render();
---

<BaseLayout
  title={`${study.data.title} | Vaka Çalışması`}
  description={study.data.description}
>

  <!-- ═══ Page Header ═══════════════════════════════════════════ -->
  <header class="cs-header">
    <!-- Background layers -->
    <div class="cs-header-bg" aria-hidden="true">
      <div class="cs-hbg-bloom"></div>
      <div class="cs-hbg-horizon"></div>
    </div>

    <div class="site-container cs-header-inner">

      <!-- Back link + industry badge -->
      <div class="cs-meta">
        <a href="/vaka-calismalari" class="cs-back">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M19 12H5M12 19l-7-7 7-7"/>
          </svg>
          <span data-i18n="nav.caseStudies">Vaka Çalışmaları</span>
        </a>
        <span class="cs-sep" aria-hidden="true"></span>
        <span class="cs-industry" data-i18n={`cases.${slug}.industry`}>{study.data.industry}</span>
      </div>

      <!-- Title -->
      <h1 class="cs-title" data-i18n={`cases.${slug}.title`}>{study.data.title}</h1>

      <!-- Description -->
      <p class="cs-desc" data-i18n={`cases.${slug}.description`}>{study.data.description}</p>

    </div>
  </header>

  <!-- ═══ Meta: Services + Tech Stack ══════════════════════════ -->
  <div class="cs-meta-strip">
    <div class="site-container">
      <div class="cs-meta-grid">

        <div class="cs-meta-col">
          <h3 class="cs-meta-label" data-i18n="cases.servicesLabel">Sunulan Hizmetler</h3>
          <div class="cs-tags">
            {study.data.services.map((s: string, i: number) => (
              <span class="cs-tag cs-tag--service" data-i18n={`cases.${slug}.service${i}`}>{s}</span>
            ))}
          </div>
        </div>

        <div class="cs-meta-divider" aria-hidden="true"></div>

        <div class="cs-meta-col">
          <h3 class="cs-meta-label" data-i18n="cases.techLabel">Kullanılan Teknolojiler</h3>
          <div class="cs-tags">
            {study.data.tech.map((t: string) => (
              <span class="cs-tag cs-tag--tech">{t}</span>
            ))}
          </div>
        </div>

      </div>
    </div>
  </div>

  <!-- ═══ Main Content ══════════════════════════════════════════ -->
  <div class="cs-body">
    <div class="site-container cs-body-inner">

      <!-- Highlights panel -->
      {study.data.highlights && study.data.highlights.length > 0 && (
        <div class="cs-highlights reveal">
          <div class="cs-hl-glow"   aria-hidden="true"></div>
          <div class="cs-hl-rule-t" aria-hidden="true"></div>
          <div class="cs-hl-rule-b" aria-hidden="true"></div>

          <h3 class="cs-hl-title" data-i18n="cases.highlightsLabel">
            <span class="cs-hl-title-dot" aria-hidden="true"></span>
            Öne Çıkan Sonuçlar
          </h3>
          <ul class="cs-hl-list" role="list">
            {study.data.highlights.map((h: string, i: number) => (
              <li class="cs-hl-item" role="listitem">
                <span class="cs-hl-check" aria-hidden="true">
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="20 6 9 17 4 12"/>
                  </svg>
                </span>
                <span data-i18n={`cases.${slug}.highlight${i}`}>{h}</span>
              </li>
            ))}
          </ul>
        </div>
      )}

      <!-- Markdown body -->
      <MarkdownContent>
        <div data-i18n-html={`cases.${slug}.body`}>
          <Content />
        </div>
      </MarkdownContent>

    </div>
  </div>

  <!-- ═══ Final CTA ════════════════════════════════════════════ -->
  <FinalCTA
    title="Benzer sonuçlar için konuşalım"
    description="Projenizi anlayalım, uygun teknik yaklaşımı birlikte tasarlayalım."
    titleKey="cases.ctaTitle"
    descriptionKey="cases.ctaDescription"
  />

</BaseLayout>

<style>
  /* ════ Page Header ══════════════════════════════════════════ */
  .cs-header {
    position      : relative;
    overflow      : hidden;
    padding-top   : 8rem;
    padding-bottom: 4rem;
  }
  @media (min-width: 768px)  { .cs-header { padding-top: 10rem;   padding-bottom: 5rem; } }
  @media (min-width: 1024px) { .cs-header { padding-top: 11.5rem; padding-bottom: 6rem; } }

  .cs-header-bg {
    position      : absolute;
    inset         : 0;
    z-index       : 1;
    pointer-events: none;
  }
  .cs-hbg-bloom {
    position  : absolute;
    inset     : 0;
    background: radial-gradient(
      ellipse 100% 70% at 40% -10%,
      rgba(217, 161, 40, 0.13) 0%,
      rgba(161, 116, 24, 0.05) 45%,
      transparent 65%
    );
  }
  .cs-hbg-horizon {
    position  : absolute;
    bottom    : 0; left: 0; right: 0;
    height    : 1px;
    background: linear-gradient(to right, transparent 0%, rgba(217,161,40,0.14) 18%, rgba(217,161,40,0.28) 50%, rgba(217,161,40,0.14) 82%, transparent 100%);
  }

  .cs-header-inner {
    position : relative;
    z-index  : 10;
    max-width: 52rem;
  }

  /* Back + industry row */
  .cs-meta {
    display      : flex;
    align-items  : center;
    gap          : 0.875rem;
    margin-bottom: 1.75rem;
    flex-wrap    : wrap;
  }
  .cs-back {
    display        : inline-flex;
    align-items    : center;
    gap            : 0.375rem;
    font-size      : 0.8125rem;
    font-weight    : 600;
    color          : rgb(var(--color-fg-muted));
    text-decoration: none;
    transition     : color 180ms ease;
  }
  .cs-back:hover { color: rgb(var(--color-accent)); }
  .cs-back:focus-visible { outline: 2px solid rgb(var(--color-ring)); outline-offset: 3px; border-radius: 4px; }

  .cs-sep { width: 1px; height: 12px; background: rgb(var(--color-border)); flex-shrink: 0; }

  .cs-industry {
    font-size     : 0.6875rem;
    font-weight   : 700;
    letter-spacing: 0.10em;
    text-transform: uppercase;
    color         : rgb(var(--color-accent));
    padding       : 0.25rem 0.625rem;
    border-radius : 0.3125rem;
    background    : rgb(var(--color-accent) / 0.10);
    border        : 1px solid rgb(var(--color-accent) / 0.22);
  }

  /* Title */
  .cs-title {
    font-size     : 2rem;
    font-weight   : 800;
    letter-spacing: -0.036em;
    line-height   : 1.1;
    color         : rgb(var(--color-fg));
    margin-bottom : 1.25rem;
    text-wrap     : balance;
  }
  @media (min-width: 640px)  { .cs-title { font-size: 2.5rem;   letter-spacing: -0.038em; } }
  @media (min-width: 768px)  { .cs-title { font-size: 2.875rem; letter-spacing: -0.040em; } }
  @media (min-width: 1024px) { .cs-title { font-size: 3.125rem; } }

  /* Description */
  .cs-desc {
    font-size  : 1rem;
    line-height: 1.76;
    color      : rgb(var(--color-fg-muted));
    max-width  : 52ch;
  }
  @media (min-width: 768px) { .cs-desc { font-size: 1.0625rem; } }

  /* ════ Meta strip ═══════════════════════════════════════════ */
  .cs-meta-strip {
    background   : rgb(var(--color-card) / 0.50);
    border-top   : 1px solid rgb(var(--color-border) / 0.5);
    border-bottom: 1px solid rgb(var(--color-border) / 0.5);
    padding      : 1.5rem 0;
  }
  .cs-meta-grid {
    display  : flex;
    align-items: flex-start;
    gap      : 2rem;
    flex-wrap: wrap;
  }
  @media (min-width: 768px) {
    .cs-meta-grid { flex-wrap: nowrap; align-items: center; gap: 3rem; }
  }
  .cs-meta-col { display: flex; flex-direction: column; gap: 0.75rem; }
  .cs-meta-divider { display: none; }
  @media (min-width: 768px) {
    .cs-meta-divider { display: block; width: 1px; height: 3rem; flex-shrink: 0; background: rgb(var(--color-border)); }
  }
  .cs-meta-label {
    font-size     : 0.6875rem;
    font-weight   : 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color         : rgb(var(--color-fg-faint));
  }
  .cs-tags { display: flex; flex-wrap: wrap; gap: 0.375rem; }
  .cs-tag  { font-size: 0.8125rem; font-weight: 500; padding: 0.3125rem 0.75rem; border-radius: 0.375rem; white-space: nowrap; }
  .cs-tag--service { color: rgb(var(--color-accent)); background: rgb(var(--color-accent) / 0.09); border: 1px solid rgb(var(--color-accent) / 0.22); }
  .cs-tag--tech    { color: rgb(var(--color-fg-muted)); background: rgb(var(--color-muted)); border: 1px solid rgb(var(--color-border)); }

  /* ════ Body ═════════════════════════════════════════════════ */
  .cs-body { padding: 4rem 0; }
  @media (min-width: 768px) { .cs-body { padding: 5rem 0; } }
  .cs-body-inner { max-width: 48rem; display: flex; flex-direction: column; gap: 3rem; }

  /* ════ Highlights panel ═════════════════════════════════════ */
  .cs-highlights {
    position     : relative;
    overflow     : hidden;
    padding      : 1.75rem 2rem;
    border-radius: 1.25rem;
    background   : rgb(var(--color-card));
    border       : 1px solid rgb(var(--color-accent) / 0.25);
    box-shadow   :
      0 0 0 1px rgb(var(--color-accent) / 0.06) inset,
      0 0 40px rgb(var(--color-glow) / 0.08);
  }
  .cs-hl-glow {
    position  : absolute;
    inset     : 0;
    background: radial-gradient(ellipse 80% 60% at 50% 0%, rgba(217,161,40,0.08) 0%, transparent 65%);
    pointer-events: none;
  }
  .cs-hl-rule-t, .cs-hl-rule-b {
    position  : absolute;
    left      : 1.5rem; right: 1.5rem;
    height    : 1px;
    background: linear-gradient(to right, transparent, rgb(var(--color-accent) / 0.40) 30%, rgb(var(--color-accent) / 0.55) 50%, rgb(var(--color-accent) / 0.40) 70%, transparent);
    pointer-events: none;
  }
  .cs-hl-rule-t { top: 0; }
  .cs-hl-rule-b { bottom: 0; }

  .cs-hl-title {
    display       : flex;
    align-items   : center;
    gap           : 0.625rem;
    font-size     : 0.8125rem;
    font-weight   : 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color         : rgb(var(--color-accent));
    margin-bottom : 1.25rem;
    position      : relative;
    z-index       : 1;
  }
  .cs-hl-title-dot {
    width        : 6px;
    height       : 6px;
    border-radius: 9999px;
    background   : rgb(var(--color-accent));
    flex-shrink  : 0;
    box-shadow   : 0 0 8px rgb(var(--color-glow) / 0.50);
  }

  .cs-hl-list {
    display       : flex;
    flex-direction: column;
    gap           : 0.75rem;
    position      : relative;
    z-index       : 1;
    list-style    : none;
    padding       : 0;
    margin        : 0;
  }
  .cs-hl-item {
    display    : flex;
    align-items: flex-start;
    gap        : 0.75rem;
    font-size  : 0.9375rem;
    line-height: 1.6;
    color      : rgb(var(--color-fg));
  }
  .cs-hl-check {
    display        : inline-flex;
    align-items    : center;
    justify-content: center;
    width          : 1.375rem;
    height         : 1.375rem;
    border-radius  : 9999px;
    flex-shrink    : 0;
    background     : rgb(var(--color-accent) / 0.12);
    color          : rgb(var(--color-accent));
    border         : 1px solid rgb(var(--color-accent) / 0.24);
    margin-top     : 0.125em;
  }
</style>
