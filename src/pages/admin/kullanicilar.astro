---
import AdminLayout from '../../layouts/AdminLayout.astro';

const adminUser  = import.meta.env.ADMIN_USER ?? 'admin';
const createdEnv = import.meta.env.ADMIN_CREATED ?? null;

interface TeamMember {
  name: string;
  email: string;
  role: string;
  status: 'aktif' | 'pasif';
  initials: string;
}

const teamMembers: TeamMember[] = [
  {
    name: adminUser,
    email: `${adminUser}@akasoftware.com.tr`,
    role: 'Süper Yönetici',
    status: 'aktif',
    initials: adminUser.charAt(0).toUpperCase(),
  },
];
---

<AdminLayout title="Kullanıcılar" section="kullanicilar">

<style>
  .page-header { display:flex; align-items:center; justify-content:space-between; margin-bottom:1.75rem; gap:1rem; flex-wrap:wrap; }
  .page-title  { font-size:1.25rem; font-weight:700; color:var(--adm-text); }
  .page-sub    { font-size:0.8125rem; color:var(--adm-muted); margin-top:0.2rem; }

  .btn-new {
    display:inline-flex; align-items:center; gap:0.5rem;
    padding:0.5rem 1rem; border-radius:0.625rem;
    background:var(--adm-gold); color:#0b0a09;
    font-size:0.8125rem; font-weight:600; cursor:pointer; border:none; transition:background 150ms;
  }
  .btn-new:hover { background:var(--adm-gold-b); }

  /* Stats */
  .stats { display:grid; grid-template-columns:repeat(auto-fit,minmax(160px,1fr)); gap:1rem; margin-bottom:2rem; }
  .stat-card {
    background:var(--adm-card); border:1px solid var(--adm-border); border-radius:0.875rem;
    padding:1.25rem 1.5rem; display:flex; flex-direction:column; gap:0.375rem;
  }
  .stat-label { font-size:0.6875rem; font-weight:600; letter-spacing:0.08em; text-transform:uppercase; color:var(--adm-faint); }
  .stat-value { font-size:1.875rem; font-weight:700; color:var(--adm-text); }
  .stat-sub   { font-size:0.75rem; color:var(--adm-muted); }

  /* User cards */
  .users-grid { display:flex; flex-direction:column; gap:0.875rem; }
  .user-card {
    background:var(--adm-card); border:1px solid var(--adm-border); border-radius:0.875rem;
    padding:1.25rem 1.5rem; display:flex; align-items:center; gap:1rem;
    transition:border-color 150ms, background 150ms;
  }
  .user-card:hover { border-color:var(--adm-border-h); background:var(--adm-card-h); }

  .avatar {
    width:2.75rem; height:2.75rem; border-radius:9999px;
    background:rgba(217,161,40,0.14); border:1px solid rgba(217,161,40,0.28);
    display:inline-flex; align-items:center; justify-content:center;
    font-size:1rem; font-weight:700; color:var(--adm-gold); flex-shrink:0;
  }
  .user-info { flex:1; min-width:0; }
  .user-name { font-size:0.9375rem; font-weight:600; color:var(--adm-text); }
  .user-email { font-size:0.8125rem; color:var(--adm-muted); }
  .user-role  { font-size:0.75rem; color:var(--adm-faint); margin-top:0.125rem; }
  .badge-aktif { display:inline-flex; align-items:center; gap:.25rem; padding:.2rem .625rem; border-radius:9999px; font-size:.6875rem; font-weight:600; background:rgba(74,222,128,0.10); color:rgba(74,222,128,0.9); border:1px solid rgba(74,222,128,0.22); }
  .badge-pasif { display:inline-flex; align-items:center; gap:.25rem; padding:.2rem .625rem; border-radius:9999px; font-size:.6875rem; font-weight:600; background:rgba(120,110,90,0.12); color:var(--adm-faint); border:1px solid rgba(120,110,90,0.20); }

  .user-actions { display:flex; gap:0.375rem; align-items:center; flex-shrink:0; }
  .act-btn {
    display:inline-flex; align-items:center; gap:0.25rem;
    padding:0.375rem 0.75rem; border-radius:0.5rem; border:1px solid var(--adm-border);
    font-size:0.75rem; font-weight:500; color:var(--adm-muted);
    background:transparent; cursor:pointer; text-decoration:none; transition:all 120ms;
  }
  .act-btn:hover { color:var(--adm-text); border-color:var(--adm-border-h); }

  /* Dialog */
  dialog {
    background:var(--adm-card); color:var(--adm-text);
    border:1px solid var(--adm-border); border-radius:1rem;
    padding:0; max-width:480px; width:90vw; box-shadow:0 24px 64px rgba(0,0,0,0.6);
  }
  dialog::backdrop { background:rgba(0,0,0,0.65); backdrop-filter:blur(4px); }
  .dlg-head { display:flex; align-items:center; justify-content:space-between; padding:1.25rem 1.5rem; border-bottom:1px solid var(--adm-border); }
  .dlg-title { font-size:1rem; font-weight:700; }
  .dlg-close { background:transparent; border:none; color:var(--adm-muted); cursor:pointer; padding:.25rem; border-radius:.375rem; transition:color 120ms; }
  .dlg-close:hover { color:var(--adm-text); }
  .dlg-body { padding:1.5rem; display:flex; flex-direction:column; gap:1rem; }
  .field label { display:block; font-size:.6875rem; font-weight:600; letter-spacing:.06em; text-transform:uppercase; color:var(--adm-faint); margin-bottom:.375rem; }
  .field input, .field select {
    width:100%; padding:.5625rem .75rem;
    background:var(--adm-card-h); border:1px solid var(--adm-border);
    border-radius:.5rem; color:var(--adm-text); font-size:.875rem; outline:none;
    transition:border-color 150ms;
  }
  .field input:focus, .field select:focus { border-color:rgba(217,161,40,.35); }
  .dlg-foot { padding:1rem 1.5rem; border-top:1px solid var(--adm-border); display:flex; gap:.75rem; justify-content:flex-end; }
  .btn-save {
    padding:.5rem 1.25rem; border-radius:.625rem;
    background:var(--adm-gold); color:#0b0a09;
    font-size:.875rem; font-weight:600; border:none; cursor:pointer; transition:background 150ms;
  }
  .btn-save:hover { background:var(--adm-gold-b); }
  .btn-cancel {
    padding:.5rem 1rem; border-radius:.625rem;
    background:transparent; border:1px solid var(--adm-border);
    color:var(--adm-muted); font-size:.875rem; cursor:pointer; transition:all 150ms;
  }
  .btn-cancel:hover { color:var(--adm-text); border-color:var(--adm-border-h); }

  /* Info notice */
  .notice {
    display:flex; align-items:flex-start; gap:0.75rem;
    padding:0.875rem 1rem; border-radius:0.625rem;
    background:rgba(217,161,40,0.06); border:1px solid rgba(217,161,40,0.16);
    font-size:0.8125rem; color:var(--adm-muted); margin-top:1.5rem;
  }
  .notice svg { color:var(--adm-gold); flex-shrink:0; margin-top:0.0625rem; }

  /* Change password section */
  .section-title {
    font-size:0.875rem; font-weight:600; color:var(--adm-text);
    padding-bottom:0.75rem; border-bottom:1px solid var(--adm-border);
    margin-bottom:1.25rem;
  }
</style>

<div class="page-header">
  <div>
    <div class="page-title">Kullanıcılar</div>
    <div class="page-sub">Panel erişim hesapları</div>
  </div>
  <button class="btn-new" onclick="document.getElementById('newUserDlg').showModal()">
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
    Kullanıcı Ekle
  </button>
</div>

<!-- Stats -->
<div class="stats">
  <div class="stat-card">
    <div class="stat-label">Toplam</div>
    <div class="stat-value">{teamMembers.length}</div>
    <div class="stat-sub">Kayıtlı kullanıcı</div>
  </div>
  <div class="stat-card">
    <div class="stat-label">Aktif</div>
    <div class="stat-value">{teamMembers.filter(u => u.status === 'aktif').length}</div>
    <div class="stat-sub">Aktif hesap</div>
  </div>
  <div class="stat-card">
    <div class="stat-label">Rol</div>
    <div class="stat-value">1</div>
    <div class="stat-sub">Süper Yönetici</div>
  </div>
</div>

<!-- User list -->
<div class="section-title">Hesaplar</div>
<div class="users-grid">
  {teamMembers.map(u => (
    <div class="user-card">
      <div class="avatar">{u.initials}</div>
      <div class="user-info">
        <div class="user-name">{u.name}</div>
        <div class="user-email">{u.email}</div>
        <div class="user-role">{u.role}</div>
      </div>
      <span class={`badge-${u.status}`}>
        <svg width="6" height="6" viewBox="0 0 6 6" fill="currentColor"><circle cx="3" cy="3" r="3"/></svg>
        {u.status === 'aktif' ? 'Aktif' : 'Pasif'}
      </span>
      <div class="user-actions">
        <button class="act-btn" onclick="document.getElementById('pwDlg').showModal()">Şifre Değiştir</button>
      </div>
    </div>
  ))}
</div>

<div class="notice">
  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
    <circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/>
  </svg>
  <span>Kullanıcı kimlik bilgileri güvenlik amacıyla <strong>.env</strong> dosyasında saklanmaktadır. Şifre değişikliği sunucunun yeniden başlatılmasını gerektirir.</span>
</div>

<!-- Password change dialog (informational) -->
<dialog id="pwDlg">
  <div class="dlg-head">
    <div class="dlg-title">Şifre Değiştir</div>
    <button class="dlg-close" onclick="document.getElementById('pwDlg').close()">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
    </button>
  </div>
  <form method="post" action="/api/admin/change-password">
    <div class="dlg-body">
      <div class="field">
        <label>Mevcut Şifre</label>
        <input type="password" name="current" required placeholder="••••••••"/>
      </div>
      <div class="field">
        <label>Yeni Şifre</label>
        <input type="password" name="newpass" required placeholder="••••••••" minlength="8"/>
      </div>
      <div class="field">
        <label>Yeni Şifre (Tekrar)</label>
        <input type="password" name="confirm" required placeholder="••••••••" minlength="8"/>
      </div>
    </div>
    <div class="dlg-foot">
      <button type="button" class="btn-cancel" onclick="document.getElementById('pwDlg').close()">İptal</button>
      <button type="submit" class="btn-save">Değiştir</button>
    </div>
  </form>
</dialog>

<!-- New user dialog (informational) -->
<dialog id="newUserDlg">
  <div class="dlg-head">
    <div class="dlg-title">Kullanıcı Ekle</div>
    <button class="dlg-close" onclick="document.getElementById('newUserDlg').close()">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
    </button>
  </div>
  <div class="dlg-body">
    <div class="field"><label>Kullanıcı Adı</label><input type="text" name="username" placeholder="kullanici"/></div>
    <div class="field"><label>E-posta</label><input type="email" name="email" placeholder="ornek@akasoftware.com.tr"/></div>
    <div class="field">
      <label>Rol</label>
      <select>
        <option>Süper Yönetici</option>
        <option>Editör</option>
        <option>Görüntüleyici</option>
      </select>
    </div>
    <div class="notice" style="margin-top:0">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/>
      </svg>
      <span>Çoklu kullanıcı desteği için kimlik doğrulama sistemi DB tabanlı hale getirilmelidir.</span>
    </div>
  </div>
  <div class="dlg-foot">
    <button type="button" class="btn-cancel" onclick="document.getElementById('newUserDlg').close()">İptal</button>
    <button type="button" class="btn-save" onclick="document.getElementById('newUserDlg').close()">Tamam</button>
  </div>
</dialog>

</AdminLayout>
