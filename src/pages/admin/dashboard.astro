---
export const prerender = false;
import AdminLayout from '../../layouts/AdminLayout.astro';
import { db, ContactMessages, ServiceRequests, Leads, Proposals, Projects, Invoices, Payments, TimeEntries } from 'astro:db';
import { desc } from 'astro:db';

// ── Veri çekme ────────────────────────────────────────────────
const allMsgs      = (await db.select().from(ContactMessages)) as any[];
const allReqs      = (await db.select().from(ServiceRequests)) as any[];
const allLeads     = (await db.select().from(Leads)) as any[];
const allProposals = (await db.select().from(Proposals)) as any[];
const allProjects  = (await db.select().from(Projects)) as any[];
const allInvoices  = (await db.select().from(Invoices)) as any[];
const allPayments  = (await db.select().from(Payments)) as any[];
const allTime      = (await db.select().from(TimeEntries)) as any[];

const recent = allMsgs
  .sort((a: any, b: any) => new Date(b.createdAt).getTime() - new Date(a.createdAt).getTime())
  .slice(0, 5);

// ── Mesaj istatistikleri ───────────────────────────────────────
const unread  = allMsgs.filter((m: any) => !m.isRead).length;
const today   = new Date();
const todayMsgs = allMsgs.filter((m: any) => new Date(m.createdAt).toDateString() === today.toDateString()).length;

// ── Lead & Satış ──────────────────────────────────────────────
const activeLeads    = allLeads.filter(l => !['won','lost'].includes(l.status)).length;
const pipelineValue  = allLeads.filter(l => !['won','lost'].includes(l.status) && l.estimatedValue)
  .reduce((s, l) => s + (l.estimatedValue ?? 0), 0);
const wonLeads       = allLeads.filter(l => l.status === 'won').length;
const totalLeads     = allLeads.length;

const sentProposals  = allProposals.filter(p => p.status === 'sent').length;
const acceptedProposals = allProposals.filter(p => p.status === 'accepted').length;
const convRate       = allProposals.length > 0
  ? Math.round((acceptedProposals / allProposals.length) * 100) : 0;

// ── Proje ─────────────────────────────────────────────────────
const activeProjects = allProjects.filter(p => p.status === 'active').length;
const noContract     = allProjects.filter(p => p.status === 'active' && !p.contractId).length;

// Bütçe kullanım ortalaması (aktif projeler)
const activePs = allProjects.filter(p => p.status === 'active' && p.budgetHours);
const budgetUsage = activePs.length > 0
  ? Math.round(activePs.map(p => {
      const logged = allTime.filter(t => t.projectId === p.id).reduce((s, t) => s + t.hours, 0);
      return (logged / (p.budgetHours ?? 1)) * 100;
    }).reduce((s, v) => s + v, 0) / activePs.length) : 0;

// ── Finans ────────────────────────────────────────────────────
const paidPerInvoice: Record<number, number> = {};
for (const p of allPayments) {
  paidPerInvoice[p.invoiceId] = (paidPerInvoice[p.invoiceId] ?? 0) + p.amount;
}

const thisMonth   = today.getMonth();
const thisYear    = today.getFullYear();

const monthInvoiced = allInvoices
  .filter(i => {
    const d = new Date(i.issueDate);
    return d.getMonth() === thisMonth && d.getFullYear() === thisYear && i.status !== 'cancelled';
  })
  .reduce((s, i) => s + i.totalAmount, 0);

const totalCollected = allPayments.reduce((s, p) => s + p.amount, 0);

const pendingAmount = allInvoices
  .filter(i => !['paid','cancelled'].includes(i.status))
  .reduce((s, i) => s + (i.totalAmount - (paidPerInvoice[i.id] ?? 0)), 0);

const overdueCount = allInvoices.filter(i => {
  const due  = new Date(i.dueDate);
  const paid = paidPerInvoice[i.id] ?? 0;
  return due < today && paid < i.totalAmount && !['paid','cancelled'].includes(i.status);
}).length;

// Onay bekleyen zaman kayıtları
const pendingTime = allTime.filter(t => t.status === 'submitted').length;

// ── Formatlar ─────────────────────────────────────────────────
function fmtMoney(n: number) {
  if (n >= 1_000_000) return (n / 1_000_000).toFixed(1) + 'M';
  if (n >= 1_000)     return (n / 1_000).toFixed(0) + 'K';
  return n.toLocaleString('tr-TR', { maximumFractionDigits: 0 });
}
function fmtDate(d: Date | string) {
  return new Date(d).toLocaleDateString('tr-TR', { day:'numeric', month:'short', year:'numeric' });
}
---

<AdminLayout title="Dashboard" section="dashboard">
<style>
  .page-header { margin-bottom: 2rem; }
  .page-header h1 { font-size: 1.5rem; font-weight: 700; letter-spacing: -0.028em; color: rgba(242,236,224,0.96); }
  .page-header p  { font-size: 0.875rem; color: rgba(140,128,108,0.70); margin-top: 0.25rem; }

  /* ── Grid layouts ── */
  .grid-4 { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1rem; margin-bottom: 1.25rem; }
  .grid-3 { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; margin-bottom: 1.25rem; }
  .grid-2 { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1.25rem; margin-bottom: 1.25rem; }
  @media (max-width: 900px) { .grid-4 { grid-template-columns: repeat(2, 1fr); } .grid-3 { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 600px) { .grid-4,.grid-3,.grid-2 { grid-template-columns: 1fr; } }

  /* ── Stat card ── */
  .stat-card {
    background: #161310; border: 1px solid rgba(161,116,24,0.14);
    border-radius: 1rem; padding: 1.25rem; position: relative; overflow: hidden;
    box-shadow: 0 1px 0 0 rgba(245,214,92,0.12) inset;
  }
  .stat-card::before {
    content: ''; position: absolute; top: 0; left: 1.25rem; right: 1.25rem; height: 1px;
    background: linear-gradient(to right, transparent, rgba(217,161,40,0.35) 30%, rgba(245,214,92,0.55) 50%, rgba(217,161,40,0.35) 70%, transparent);
  }
  .stat-label { font-size: 0.6875rem; font-weight: 600; letter-spacing: 0.07em; text-transform: uppercase; color: rgba(140,128,108,0.70); margin-bottom: 0.625rem; }
  .stat-value { font-size: 2rem; font-weight: 800; letter-spacing: -0.04em; line-height: 1; color: rgb(245,214,92); }
  .stat-value.green { color: rgba(74,222,128,0.90); }
  .stat-value.amber { color: rgba(251,191,36,0.90); }
  .stat-value.red   { color: rgba(248,113,113,0.88); }
  .stat-value.muted { color: rgba(178,164,144,0.75); }
  .stat-desc  { font-size: 0.75rem; color: rgba(178,164,144,0.60); margin-top: 0.4rem; }
  .stat-icon  {
    position: absolute; top: 1.125rem; right: 1.125rem;
    width: 2rem; height: 2rem; background: rgba(217,161,40,0.09);
    border: 1px solid rgba(217,161,40,0.18); border-radius: 0.5rem;
    display: flex; align-items: center; justify-content: center; color: rgb(217,161,40);
  }
  .stat-link { display: inline-block; margin-top: 0.5rem; font-size: 0.6875rem; font-weight: 600; color: rgba(217,161,40,0.75); text-decoration: none; }
  .stat-link:hover { color: rgb(245,214,92); }
  .warn-dot { display: inline-block; width: 6px; height: 6px; border-radius: 9999px; background: rgba(248,113,113,0.85); margin-right: 0.3rem; vertical-align: middle; }

  /* ── Section ── */
  .section-title {
    font-size: 0.875rem; font-weight: 700; letter-spacing: -0.015em;
    color: rgba(242,236,224,0.85); margin-bottom: 0.875rem;
    display: flex; align-items: center; justify-content: space-between;
  }
  .view-all { font-size: 0.6875rem; font-weight: 600; color: rgb(217,161,40); text-decoration: none; padding: 0.25rem 0.625rem; border: 1px solid rgba(217,161,40,0.22); border-radius: 0.375rem; background: rgba(217,161,40,0.06); transition: background 150ms; }
  .view-all:hover { background: rgba(217,161,40,0.12); }
  .section-sep { height: 1px; background: rgba(161,116,24,0.12); margin: 1.5rem 0; }

  /* ── Table ── */
  .table-wrap { background: #161310; border: 1px solid rgba(161,116,24,0.14); border-radius: 1rem; overflow: hidden; box-shadow: 0 1px 0 0 rgba(245,214,92,0.10) inset; }
  table { width: 100%; border-collapse: collapse; }
  thead th { padding: 0.625rem 1.125rem; font-size: 0.6875rem; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; color: rgba(140,128,108,0.70); background: rgba(255,255,255,0.02); border-bottom: 1px solid rgba(161,116,24,0.12); text-align: left; }
  tbody tr { border-bottom: 1px solid rgba(161,116,24,0.07); transition: background 120ms; }
  tbody tr:last-child { border-bottom: none; }
  tbody tr:hover { background: rgba(217,161,40,0.04); }
  td { padding: 0.75rem 1.125rem; font-size: 0.8125rem; color: rgba(178,164,144,0.85); vertical-align: middle; }
  td.name { font-weight: 600; color: rgba(242,236,224,0.90); }

  .badge-new  { display: inline-flex; align-items: center; gap: 0.3rem; padding: 0.175rem 0.5rem; border-radius: 9999px; font-size: 0.625rem; font-weight: 700; letter-spacing: 0.04em; text-transform: uppercase; background: rgba(251,191,36,0.12); color: rgb(251,191,36); border: 1px solid rgba(251,191,36,0.28); }
  .badge-read { display: inline-flex; align-items: center; gap: 0.3rem; padding: 0.175rem 0.5rem; border-radius: 9999px; font-size: 0.625rem; font-weight: 700; letter-spacing: 0.04em; text-transform: uppercase; background: rgba(120,110,90,0.10); color: rgba(140,128,108,0.70); border: 1px solid rgba(120,110,90,0.18); }
  .badge-dot { width: 5px; height: 5px; border-radius: 9999px; flex-shrink: 0; }
  .badge-new  .badge-dot { background: rgb(251,191,36); }
  .badge-read .badge-dot { background: rgba(140,128,108,0.60); }

  .empty-state { padding: 2.5rem; text-align: center; color: rgba(120,110,90,0.60); font-size: 0.875rem; }

  /* ── Alert cards ── */
  .alerts { display: flex; flex-direction: column; gap: 0.625rem; margin-bottom: 1.25rem; }
  .alert-card { display: flex; align-items: center; gap: 0.875rem; padding: 0.875rem 1rem; border-radius: 0.75rem; font-size: 0.8125rem; text-decoration: none; transition: background 150ms; }
  .alert-card.red   { background: rgba(248,113,113,0.07); border: 1px solid rgba(248,113,113,0.20); color: rgba(248,113,113,0.88); }
  .alert-card.amber { background: rgba(251,191,36,0.07);  border: 1px solid rgba(251,191,36,0.20);  color: rgba(251,191,36,0.88); }
  .alert-card.blue  { background: rgba(99,179,237,0.07);  border: 1px solid rgba(99,179,237,0.18);  color: rgba(99,179,237,0.85); }
  .alert-card:hover { filter: brightness(1.1); }
  .alert-icon { font-size: 1rem; flex-shrink: 0; }
  .group-label { font-size: 0.6875rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: rgba(140,128,108,0.55); margin-bottom: 0.625rem; margin-top: 0.25rem; }
</style>

<div class="page-header">
  <h1>Dashboard</h1>
  <p>Genel bakış — {today.toLocaleDateString('tr-TR', { day:'numeric', month:'long', year:'numeric' })}</p>
</div>

<!-- ── Uyarılar ──────────────────────────────────── -->
{(overdueCount > 0 || noContract > 0 || pendingTime > 0) && (
  <div class="alerts">
    {overdueCount > 0 && (
      <a href="/admin/faturalar?filter=overdue" class="alert-card red">
        <span class="alert-icon">⚠</span>
        <strong>{overdueCount} faturanın</strong>&nbsp;vadesi geçti — tahsilat bekliyor.
      </a>
    )}
    {noContract > 0 && (
      <a href="/admin/projeler?filter=active" class="alert-card amber">
        <span class="alert-icon">⚠</span>
        <strong>{noContract} aktif proje</strong>&nbsp;sözleşmesiz çalışıyor.
      </a>
    )}
    {pendingTime > 0 && (
      <a href="/admin/zaman-takibi?filter=submitted" class="alert-card blue">
        <span class="alert-icon">ℹ</span>
        <strong>{pendingTime} zaman kaydı</strong>&nbsp;onay bekliyor.
      </a>
    )}
  </div>
)}

<!-- ── Finans Özeti ────────────────────────────── -->
<div class="group-label">Finans</div>
<div class="grid-3">
  <div class="stat-card">
    <div class="stat-icon">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><rect x="1" y="4" width="22" height="16" rx="2"/><line x1="1" y1="10" x2="23" y2="10"/></svg>
    </div>
    <div class="stat-label">Bu Ay Faturalandı</div>
    <div class="stat-value">{fmtMoney(monthInvoiced)} ₺</div>
    <div class="stat-desc">Cari ay fatura toplamı</div>
    <a href="/admin/faturalar" class="stat-link">Faturalara git →</a>
  </div>
  <div class="stat-card">
    <div class="stat-icon">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><polyline points="20 12 20 22 4 22 4 12"/><rect x="2" y="7" width="20" height="5"/><path d="M12 22V7"/><path d="M12 7H7.5a2.5 2.5 0 0 1 0-5C11 2 12 7 12 7z"/><path d="M12 7h4.5a2.5 2.5 0 0 0 0-5C13 2 12 7 12 7z"/></svg>
    </div>
    <div class="stat-label">Tahsil Edildi</div>
    <div class="stat-value green">{fmtMoney(totalCollected)} ₺</div>
    <div class="stat-desc">Toplam nakit tahsilat</div>
  </div>
  <div class="stat-card">
    <div class="stat-icon">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
    </div>
    <div class="stat-label">Tahsilat Bekleyen</div>
    <div class={`stat-value ${overdueCount > 0 ? 'amber' : 'muted'}`}>{fmtMoney(pendingAmount)} ₺</div>
    <div class="stat-desc">
      {overdueCount > 0 && <><span class="warn-dot"></span>{overdueCount} vadesi geçmiş — </>}
      Açık bakiye
    </div>
    <a href="/admin/faturalar" class="stat-link">Faturalara git →</a>
  </div>
</div>

<!-- ── Satış Boru Hattı ────────────────────────── -->
<div class="section-sep"></div>
<div class="group-label">Satış</div>
<div class="grid-4">
  <div class="stat-card">
    <div class="stat-label">Aktif Lead</div>
    <div class="stat-value">{activeLeads}</div>
    <div class="stat-desc">Pipeline değeri: {fmtMoney(pipelineValue)} ₺</div>
    <a href="/admin/leads" class="stat-link">Leadlere git →</a>
  </div>
  <div class="stat-card">
    <div class="stat-label">Bekleyen Teklif</div>
    <div class="stat-value">{sentProposals}</div>
    <div class="stat-desc">Müşteri kararı bekleniyor</div>
    <a href="/admin/teklifler?filter=sent" class="stat-link">Tekliflere git →</a>
  </div>
  <div class="stat-card">
    <div class="stat-label">Dönüşüm Oranı</div>
    <div class={`stat-value ${convRate >= 50 ? 'green' : convRate >= 25 ? 'amber' : 'red'}`}>{convRate}%</div>
    <div class="stat-desc">Kabul edilen / toplam teklif</div>
  </div>
  <div class="stat-card">
    <div class="stat-label">Aktif Proje</div>
    <div class="stat-value">{activeProjects}</div>
    <div class="stat-desc">Bütçe kullanım ort. {budgetUsage}%</div>
    <a href="/admin/projeler?filter=active" class="stat-link">Projelere git →</a>
  </div>
</div>

<!-- ── Genel İstatistikler ─────────────────────── -->
<div class="section-sep"></div>
<div class="group-label">İletişim</div>
<div class="grid-3">
  <div class="stat-card">
    <div class="stat-label">Toplam Mesaj</div>
    <div class="stat-value muted">{allMsgs.length}</div>
    <div class="stat-desc">Okunmamış: {unread}</div>
    <a href="/admin/mesajlar" class="stat-link">Mesajlara git →</a>
  </div>
  <div class="stat-card">
    <div class="stat-label">Bekleyen Talep</div>
    <div class="stat-value muted">{allReqs.filter(r => r.status === 'beklemede').length}</div>
    <div class="stat-desc">Toplam: {allReqs.length} talep</div>
    <a href="/admin/talepler" class="stat-link">Taleplere git →</a>
  </div>
  <div class="stat-card">
    <div class="stat-label">Bugün Gelen</div>
    <div class="stat-value muted">{todayMsgs}</div>
    <div class="stat-desc">Yeni mesaj</div>
  </div>
</div>

<!-- ── Son Mesajlar ───────────────────────────── -->
<div class="section-sep"></div>
<div class="section-title">
  Son Mesajlar
  <a href="/admin/mesajlar" class="view-all">Tümünü Gör →</a>
</div>
<div class="table-wrap">
  {recent.length === 0 ? (
    <div class="empty-state">Henüz mesaj yok.</div>
  ) : (
    <table>
      <thead>
        <tr>
          <th>Durum</th><th>Ad Soyad</th><th>E-posta</th><th>Mesaj</th><th>Tarih</th>
        </tr>
      </thead>
      <tbody>
        {recent.map((m: any) => (
          <tr>
            <td>{m.isRead
              ? <span class="badge-read"><span class="badge-dot"></span>Okundu</span>
              : <span class="badge-new"><span class="badge-dot"></span>Yeni</span>}
            </td>
            <td class="name">{m.name}</td>
            <td>{m.email}</td>
            <td style="max-width:240px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">{m.message}</td>
            <td>{fmtDate(m.createdAt)}</td>
          </tr>
        ))}
      </tbody>
    </table>
  )}
</div>
</AdminLayout>
