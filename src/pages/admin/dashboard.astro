---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { db, ContactMessages } from 'astro:db';

const allMsgs = await db.select().from(ContactMessages);
allMsgs.sort((a: any, b: any) => new Date(b.createdAt).getTime() - new Date(a.createdAt).getTime());

const total   = allMsgs.length;
const unread  = allMsgs.filter((m: any) => !m.isRead).length;
const today   = allMsgs.filter((m: any) => {
  const d = new Date(m.createdAt);
  const n = new Date();
  return d.toDateString() === n.toDateString();
}).length;
const recent  = allMsgs.slice(0, 5);

function fmtDate(d: Date | string) {
  return new Date(d).toLocaleDateString('tr-TR', { day:'numeric', month:'short', year:'numeric' });
}
---

<AdminLayout title="Dashboard" section="dashboard">
  <style>
    .page-header { margin-bottom: 2rem; }
    .page-header h1 { font-size: 1.5rem; font-weight: 700; letter-spacing: -0.028em; color: rgba(242,236,224,0.96); }
    .page-header p  { font-size: 0.875rem; color: rgba(140,128,108,0.70); margin-top: 0.25rem; }

    .stats-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 1.25rem;
      margin-bottom: 2rem;
    }
    @media (max-width: 640px) { .stats-grid { grid-template-columns: 1fr; } }

    .stat-card {
      background   : #161310;
      border       : 1px solid rgba(161,116,24,0.14);
      border-radius: 1rem;
      padding      : 1.5rem;
      position     : relative;
      overflow     : hidden;
      box-shadow   : 0 1px 0 0 rgba(245,214,92,0.12) inset;
    }
    .stat-card::before {
      content : '';
      position: absolute;
      top: 0; left: 1.25rem; right: 1.25rem;
      height: 1px;
      background: linear-gradient(to right, transparent, rgba(217,161,40,0.35) 30%, rgba(245,214,92,0.55) 50%, rgba(217,161,40,0.35) 70%, transparent);
    }
    .stat-label { font-size: 0.75rem; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; color: rgba(140,128,108,0.70); margin-bottom: 0.75rem; }
    .stat-value { font-size: 2.5rem; font-weight: 800; letter-spacing: -0.04em; line-height: 1; color: rgb(245,214,92); }
    .stat-desc  { font-size: 0.75rem; color: rgba(178,164,144,0.60); margin-top: 0.5rem; }
    .stat-icon  {
      position: absolute; top: 1.25rem; right: 1.25rem;
      width: 2.25rem; height: 2.25rem;
      background: rgba(217,161,40,0.09);
      border: 1px solid rgba(217,161,40,0.18);
      border-radius: 0.625rem;
      display: flex; align-items: center; justify-content: center;
      color: rgb(217,161,40);
    }

    .section-title {
      font-size: 1rem; font-weight: 700; letter-spacing: -0.018em;
      color: rgba(242,236,224,0.92); margin-bottom: 1rem;
      display: flex; align-items: center; justify-content: space-between;
    }
    .view-all {
      font-size: 0.75rem; font-weight: 600; color: rgb(217,161,40);
      text-decoration: none;
      padding: 0.3125rem 0.75rem;
      border: 1px solid rgba(217,161,40,0.22);
      border-radius: 0.375rem;
      background: rgba(217,161,40,0.06);
      transition: background 150ms ease;
    }
    .view-all:hover { background: rgba(217,161,40,0.12); }

    .table-wrap {
      background: #161310;
      border: 1px solid rgba(161,116,24,0.14);
      border-radius: 1rem;
      overflow: hidden;
      box-shadow: 0 1px 0 0 rgba(245,214,92,0.10) inset;
    }
    table { width: 100%; border-collapse: collapse; }
    thead th {
      padding: 0.75rem 1.25rem;
      font-size: 0.6875rem; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase;
      color: rgba(140,128,108,0.70);
      background: rgba(255,255,255,0.02);
      border-bottom: 1px solid rgba(161,116,24,0.12);
      text-align: left;
    }
    tbody tr {
      border-bottom: 1px solid rgba(161,116,24,0.07);
      transition: background 120ms ease;
    }
    tbody tr:last-child { border-bottom: none; }
    tbody tr:hover { background: rgba(217,161,40,0.04); }
    td { padding: 0.875rem 1.25rem; font-size: 0.8125rem; color: rgba(178,164,144,0.85); vertical-align: middle; }
    td.name { font-weight: 600; color: rgba(242,236,224,0.90); }
    td.msg  { max-width: 280px; }
    .msg-preview { display: -webkit-box; -webkit-line-clamp: 1; -webkit-box-orient: vertical; overflow: hidden; }

    .badge-new  { display: inline-flex; align-items: center; gap: 0.3125rem; padding: 0.1875rem 0.5rem; border-radius: 9999px; font-size: 0.625rem; font-weight: 700; letter-spacing: 0.04em; text-transform: uppercase; background: rgba(251,191,36,0.12); color: rgb(251,191,36); border: 1px solid rgba(251,191,36,0.28); }
    .badge-read { display: inline-flex; align-items: center; gap: 0.3125rem; padding: 0.1875rem 0.5rem; border-radius: 9999px; font-size: 0.625rem; font-weight: 700; letter-spacing: 0.04em; text-transform: uppercase; background: rgba(120,110,90,0.10); color: rgba(140,128,108,0.70); border: 1px solid rgba(120,110,90,0.18); }
    .badge-dot { width: 5px; height: 5px; border-radius: 9999px; flex-shrink: 0; }
    .badge-new  .badge-dot { background: rgb(251,191,36); }
    .badge-read .badge-dot { background: rgba(140,128,108,0.60); }

    .empty-state { padding: 3rem; text-align: center; color: rgba(120,110,90,0.60); font-size: 0.875rem; }
  </style>

  <div class="page-header">
    <h1>Dashboard</h1>
    <p>Genel bakış ve son aktiviteler</p>
  </div>

  <!-- Stats -->
  <div class="stats-grid">
    <div class="stat-card">
      <div class="stat-icon">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
      </div>
      <div class="stat-label">Toplam Mesaj</div>
      <div class="stat-value">{total}</div>
      <div class="stat-desc">Tüm zamanlar</div>
    </div>
    <div class="stat-card">
      <div class="stat-icon">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
      </div>
      <div class="stat-label">Okunmamış</div>
      <div class="stat-value">{unread}</div>
      <div class="stat-desc">Bekleyen mesaj</div>
    </div>
    <div class="stat-card">
      <div class="stat-icon">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
      </div>
      <div class="stat-label">Bugün</div>
      <div class="stat-value">{today}</div>
      <div class="stat-desc">Yeni gelen mesaj</div>
    </div>
  </div>

  <!-- Recent messages -->
  <div class="section-title">
    Son Mesajlar
    <a href="/admin/mesajlar" class="view-all">Tümünü Gör →</a>
  </div>
  <div class="table-wrap">
    {recent.length === 0 ? (
      <div class="empty-state">Henüz mesaj yok.</div>
    ) : (
      <table>
        <thead>
          <tr>
            <th>Durum</th>
            <th>Ad Soyad</th>
            <th>E-posta</th>
            <th>Mesaj</th>
            <th>Tarih</th>
          </tr>
        </thead>
        <tbody>
          {recent.map((m: any) => (
            <tr>
              <td>{m.isRead ? <span class="badge-read"><span class="badge-dot"></span>Okundu</span> : <span class="badge-new"><span class="badge-dot"></span>Yeni</span>}</td>
              <td class="name">{m.name}</td>
              <td>{m.email}</td>
              <td class="msg"><div class="msg-preview">{m.message}</div></td>
              <td>{fmtDate(m.createdAt)}</td>
            </tr>
          ))}
        </tbody>
      </table>
    )}
  </div>
</AdminLayout>
