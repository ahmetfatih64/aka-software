---
export const prerender = false;
import AdminLayout from '../../layouts/AdminLayout.astro';
import { db, SiteSettings } from 'astro:db';

const settings = await db.select().from(SiteSettings);
const byKey = Object.fromEntries(settings.map(s => [s.key, s.value]));

const groups = [
  {
    id:    'iletisim',
    label: 'İletişim Bilgileri',
    icon:  `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.6 1.27h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9a16 16 0 0 0 6.29 6.29l.61-.61a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>`,
    keys:  [
      { key:'contact.email',   label:'E-posta Adresi',   type:'email',  placeholder:'info@akasoftware.com.tr' },
      { key:'contact.phone',   label:'Telefon Numarası', type:'tel',    placeholder:'+90 (555) 000 00 00' },
      { key:'contact.address', label:'Adres',            type:'text',   placeholder:'İstanbul, Türkiye' },
      { key:'contact.hours',   label:'Çalışma Saatleri', type:'text',   placeholder:'Pzt–Cum, 09:00–18:00' },
    ],
  },
  {
    id:    'sosyal',
    label: 'Sosyal Medya',
    icon:  `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><line x1="8.59" y1="13.51" x2="15.42" y2="17.49"/><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"/></svg>`,
    keys:  [
      { key:'social.linkedin',  label:'LinkedIn URL',   type:'url', placeholder:'https://linkedin.com/company/…' },
      { key:'social.twitter',   label:'Twitter / X URL', type:'url', placeholder:'https://x.com/…' },
      { key:'social.github',    label:'GitHub URL',     type:'url', placeholder:'https://github.com/…' },
      { key:'social.instagram', label:'Instagram URL',  type:'url', placeholder:'https://instagram.com/…' },
    ],
  },
  {
    id:    'site',
    label: 'Site Bilgileri',
    icon:  `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>`,
    keys:  [
      { key:'site.name',    label:'Site Adı',           type:'text', placeholder:'AKA Software' },
      { key:'site.tagline', label:'Slogan',              type:'text', placeholder:'Teknik Vizyonunuzu…' },
      { key:'site.lang',    label:'Varsayılan Dil (tr/en)', type:'text', placeholder:'tr' },
    ],
  },
];

const saved = Astro.url.searchParams.get('saved') === '1';
---

<AdminLayout title="Ayarlar" section="ayarlar">

<style>
  .page-header { display:flex; align-items:center; justify-content:space-between; margin-bottom:1.75rem; gap:1rem; flex-wrap:wrap; }
  .page-title  { font-size:1.25rem; font-weight:700; color:var(--adm-text); }
  .page-sub    { font-size:0.8125rem; color:var(--adm-muted); margin-top:0.2rem; }

  .toast {
    display:flex; align-items:center; gap:0.625rem;
    padding:0.75rem 1rem; border-radius:0.625rem; margin-bottom:1.5rem;
    background:rgba(74,222,128,0.10); border:1px solid rgba(74,222,128,0.22);
    color:rgba(74,222,128,0.9); font-size:0.875rem; font-weight:500;
    animation: fadein .3s ease;
  }
  @keyframes fadein { from { opacity:0; transform:translateY(-6px); } to { opacity:1; transform:translateY(0); } }

  .settings-layout { display:flex; flex-direction:column; gap:1.5rem; }

  .settings-card {
    background:var(--adm-card); border:1px solid var(--adm-border); border-radius:0.875rem; overflow:hidden;
  }
  .card-head {
    display:flex; align-items:center; gap:0.625rem;
    padding:1rem 1.5rem; border-bottom:1px solid var(--adm-border);
    background:rgba(255,255,255,0.015);
  }
  .card-icon { color:var(--adm-gold); }
  .card-title { font-size:0.9375rem; font-weight:600; color:var(--adm-text); }

  .card-body { padding:1.5rem; display:flex; flex-direction:column; gap:1.25rem; }

  .field { display:flex; flex-direction:column; gap:0.375rem; }
  .field label {
    font-size:0.6875rem; font-weight:600; letter-spacing:0.07em;
    text-transform:uppercase; color:var(--adm-faint);
  }
  .field input {
    padding:0.5625rem 0.75rem;
    background:var(--adm-card-h); border:1px solid var(--adm-border);
    border-radius:0.5rem; color:var(--adm-text); font-size:0.875rem;
    outline:none; transition:border-color 150ms, background 150ms;
  }
  .field input:focus { border-color:rgba(217,161,40,0.40); background:rgba(217,161,40,0.03); }
  .field input::placeholder { color:var(--adm-faint); }

  .card-foot {
    padding:1rem 1.5rem; border-top:1px solid var(--adm-border);
    display:flex; justify-content:flex-end;
    background:rgba(255,255,255,0.01);
  }
  .btn-save {
    display:inline-flex; align-items:center; gap:0.5rem;
    padding:0.5625rem 1.25rem; border-radius:0.625rem;
    background:var(--adm-gold); color:#0b0a09;
    font-size:0.875rem; font-weight:600; border:none; cursor:pointer;
    transition:background 150ms;
  }
  .btn-save:hover { background:var(--adm-gold-b); }

  @media (min-width:640px) {
    .card-body { display:grid; grid-template-columns:1fr 1fr; }
    .field.full { grid-column:1/-1; }
  }
</style>

<div class="page-header">
  <div>
    <div class="page-title">Ayarlar</div>
    <div class="page-sub">Site genelinde geçerli ayarlar</div>
  </div>
</div>

{saved && (
  <div class="toast">
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
    Ayarlar başarıyla kaydedildi.
  </div>
)}

<div class="settings-layout">
  {groups.map(group => (
    <form method="post" action="/api/admin/ayarlar-update" class="settings-card">
      <input type="hidden" name="group" value={group.id}/>

      <div class="card-head">
        <span class="card-icon" set:html={group.icon}/>
        <span class="card-title">{group.label}</span>
      </div>

      <div class="card-body">
        {group.keys.map((f, i) => (
          <div class={`field${i >= 2 ? ' full' : ''}`}>
            <label for={f.key.replace('.', '-')}>{f.label}</label>
            <input
              id={f.key.replace('.', '-')}
              type={f.type}
              name={f.key}
              value={byKey[f.key] ?? ''}
              placeholder={f.placeholder}
            />
          </div>
        ))}
      </div>

      <div class="card-foot">
        <button type="submit" class="btn-save">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/><polyline points="17 21 17 13 7 13 7 21"/><polyline points="7 3 7 8 15 8"/></svg>
          Kaydet
        </button>
      </div>
    </form>
  ))}
</div>

</AdminLayout>
