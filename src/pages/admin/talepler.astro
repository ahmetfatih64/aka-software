---
export const prerender = false;
import AdminLayout from '../../layouts/AdminLayout.astro';
import { db, ServiceRequests } from 'astro:db';
import { desc, eq } from 'astro:db';

const filter = Astro.url.searchParams.get('filter') ?? 'tumu';

let rows = await db.select().from(ServiceRequests).orderBy(desc(ServiceRequests.createdAt));

const counts = {
  tumu:        rows.length,
  beklemede:   rows.filter(r => r.status === 'beklemede').length,
  inceleniyor: rows.filter(r => r.status === 'inceleniyor').length,
  tamamlandi:  rows.filter(r => r.status === 'tamamlandi').length,
  reddedildi:  rows.filter(r => r.status === 'reddedildi').length,
};

if (filter !== 'tumu') rows = rows.filter(r => r.status === filter);

const statusLabel: Record<string, string> = {
  beklemede:   'Beklemede',
  inceleniyor: 'İnceleniyor',
  tamamlandi:  'Tamamlandı',
  reddedildi:  'Reddedildi',
};
const statusColor: Record<string, string> = {
  beklemede:   'amber',
  inceleniyor: 'blue',
  tamamlandi:  'green',
  reddedildi:  'red',
};
const serviceLabel: Record<string, string> = {
  web:        'Web Uygulaması',
  mobile:     'Mobil Uygulama',
  api:        'API / Backend',
  consulting: 'Danışmanlık',
  other:      'Diğer',
};

function fmt(d: Date) {
  return new Date(d).toLocaleDateString('tr-TR', { day:'2-digit', month:'short', year:'numeric' });
}
---

<AdminLayout title="Talepler" section="talepler">

<style>
  .page-header { display:flex; align-items:center; justify-content:space-between; margin-bottom:1.75rem; gap:1rem; flex-wrap:wrap; }
  .page-title  { font-size:1.25rem; font-weight:700; color:var(--adm-text); }
  .page-sub    { font-size:0.8125rem; color:var(--adm-muted); margin-top:0.2rem; }

  /* Filter tabs */
  .filter-bar  { display:flex; gap:0.375rem; flex-wrap:wrap; margin-bottom:1.5rem; }
  .filter-btn  {
    display:inline-flex; align-items:center; gap:0.375rem;
    padding:0.4375rem 0.875rem; border-radius:0.5rem; border:1px solid var(--adm-border);
    font-size:0.8125rem; font-weight:500; color:var(--adm-muted);
    background:transparent; cursor:pointer; text-decoration:none; transition:all 150ms;
  }
  .filter-btn:hover { color:var(--adm-text); background:rgba(255,255,255,0.04); }
  .filter-btn.active { color:var(--adm-text); background:rgba(217,161,40,0.10); border-color:rgba(217,161,40,0.30); }
  .filter-count {
    background:rgba(255,255,255,0.08); color:var(--adm-muted);
    font-size:0.625rem; font-weight:700; padding:0.0625rem 0.375rem;
    border-radius:9999px;
  }
  .filter-btn.active .filter-count { background:rgba(217,161,40,0.20); color:var(--adm-gold); }

  /* New request button */
  .btn-new {
    display:inline-flex; align-items:center; gap:0.5rem;
    padding:0.5rem 1rem; border-radius:0.625rem;
    background:var(--adm-gold); color:#0b0a09;
    font-size:0.8125rem; font-weight:600; cursor:pointer; border:none;
    transition:background 150ms;
  }
  .btn-new:hover { background:var(--adm-gold-b); }

  /* Search */
  .search-wrap { position:relative; margin-bottom:1rem; }
  .search-icon { position:absolute; left:0.75rem; top:50%; transform:translateY(-50%); color:var(--adm-faint); pointer-events:none; }
  .search-input {
    width:100%; padding:0.5625rem 0.75rem 0.5625rem 2.25rem;
    background:var(--adm-card); border:1px solid var(--adm-border);
    border-radius:0.625rem; color:var(--adm-text); font-size:0.875rem;
    outline:none; transition:border-color 150ms;
  }
  .search-input::placeholder { color:var(--adm-faint); }
  .search-input:focus { border-color:rgba(217,161,40,0.35); }

  /* Table */
  .tbl-wrap { overflow-x:auto; border-radius:0.75rem; border:1px solid var(--adm-border); }
  table { width:100%; border-collapse:collapse; font-size:0.875rem; }
  th {
    padding:0.75rem 1rem; text-align:left; font-size:0.6875rem; font-weight:600;
    letter-spacing:0.07em; text-transform:uppercase; color:var(--adm-faint);
    background:var(--adm-card); border-bottom:1px solid var(--adm-border);
    white-space:nowrap;
  }
  td { padding:0.875rem 1rem; border-bottom:1px solid rgba(161,116,24,0.07); vertical-align:middle; }
  tr:last-child td { border-bottom:none; }
  tr { cursor:pointer; transition:background 120ms; }
  tr:hover td { background:var(--adm-card-h); }

  .badge {
    display:inline-flex; align-items:center; gap:0.25rem;
    padding:0.1875rem 0.625rem; border-radius:9999px;
    font-size:0.6875rem; font-weight:600; white-space:nowrap;
  }
  .badge-amber  { background:rgba(251,191,36,0.12);  color:rgba(251,191,36,0.9);  border:1px solid rgba(251,191,36,0.22); }
  .badge-blue   { background:rgba(96,165,250,0.12);  color:rgba(96,165,250,0.9);  border:1px solid rgba(96,165,250,0.22); }
  .badge-green  { background:rgba(74,222,128,0.12);  color:rgba(74,222,128,0.9);  border:1px solid rgba(74,222,128,0.22); }
  .badge-red    { background:rgba(248,113,113,0.12); color:rgba(248,113,113,0.9); border:1px solid rgba(248,113,113,0.22); }

  .truncate { max-width:220px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
  .text-muted { color:var(--adm-muted); font-size:0.8125rem; }
  .text-faint { color:var(--adm-faint); font-size:0.75rem; }

  .actions { display:flex; gap:0.375rem; align-items:center; }
  .act-btn {
    display:inline-flex; align-items:center; gap:0.25rem;
    padding:0.3125rem 0.625rem; border-radius:0.5rem; border:1px solid var(--adm-border);
    font-size:0.75rem; font-weight:500; color:var(--adm-muted);
    background:transparent; cursor:pointer; text-decoration:none; transition:all 120ms; white-space:nowrap;
  }
  .act-btn:hover { color:var(--adm-text); border-color:var(--adm-border-h); background:rgba(255,255,255,0.04); }
  .act-btn.danger:hover { color:var(--adm-red); border-color:rgba(248,113,113,0.28); background:rgba(248,113,113,0.06); }

  .empty { padding:4rem 2rem; text-align:center; color:var(--adm-faint); }
  .empty svg { margin:0 auto 1rem; opacity:.3; display:block; }

  /* Dialog */
  dialog {
    background:var(--adm-card); color:var(--adm-text);
    border:1px solid var(--adm-border); border-radius:1rem;
    padding:0; max-width:620px; width:90vw; box-shadow:0 24px 64px rgba(0,0,0,0.6);
  }
  dialog::backdrop { background:rgba(0,0,0,0.65); backdrop-filter:blur(4px); }
  .dlg-head { display:flex; align-items:center; justify-content:space-between; padding:1.25rem 1.5rem; border-bottom:1px solid var(--adm-border); }
  .dlg-title { font-size:1rem; font-weight:700; }
  .dlg-close { background:transparent; border:none; color:var(--adm-muted); cursor:pointer; padding:0.25rem; border-radius:0.375rem; transition:color 120ms; }
  .dlg-close:hover { color:var(--adm-text); }
  .dlg-body { padding:1.5rem; display:flex; flex-direction:column; gap:1rem; }
  .dlg-grid { display:grid; grid-template-columns:1fr 1fr; gap:0.75rem; }
  .dlg-field label { display:block; font-size:0.6875rem; font-weight:600; letter-spacing:0.06em; text-transform:uppercase; color:var(--adm-faint); margin-bottom:0.25rem; }
  .dlg-field p { font-size:0.875rem; color:var(--adm-text); line-height:1.5; }
  .dlg-msg { grid-column:1/-1; }
  .dlg-foot { padding:1rem 1.5rem; border-top:1px solid var(--adm-border); display:flex; gap:0.75rem; flex-wrap:wrap; }
  .status-form { display:inline-flex; align-items:center; gap:0.5rem; }
  .status-select {
    padding:0.375rem 0.625rem; border-radius:0.5rem;
    background:var(--adm-card-h); border:1px solid var(--adm-border);
    color:var(--adm-text); font-size:0.8125rem; cursor:pointer;
  }
  .btn-save {
    padding:0.375rem 0.875rem; border-radius:0.5rem;
    background:var(--adm-gold); color:#0b0a09;
    font-size:0.8125rem; font-weight:600; border:none; cursor:pointer; transition:background 150ms;
  }
  .btn-save:hover { background:var(--adm-gold-b); }
  .btn-del {
    margin-left:auto; padding:0.375rem 0.875rem; border-radius:0.5rem;
    background:transparent; border:1px solid rgba(248,113,113,0.25);
    color:var(--adm-red); font-size:0.8125rem; font-weight:500; cursor:pointer; transition:all 150ms;
  }
  .btn-del:hover { background:rgba(248,113,113,0.08); }
</style>

<!-- Header -->
<div class="page-header">
  <div>
    <div class="page-title">Talepler</div>
    <div class="page-sub">Gelen proje ve hizmet talepleri</div>
  </div>
  <button class="btn-new" onclick="document.getElementById('newReqDlg').showModal()">
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
    Yeni Talep
  </button>
</div>

<!-- Filter tabs -->
<div class="filter-bar">
  {[
    { key:'tumu',        label:'Tümü'        },
    { key:'beklemede',   label:'Beklemede'   },
    { key:'inceleniyor', label:'İnceleniyor' },
    { key:'tamamlandi',  label:'Tamamlandı'  },
    { key:'reddedildi',  label:'Reddedildi'  },
  ].map(f => (
    <a href={`?filter=${f.key}`} class={`filter-btn${filter === f.key ? ' active' : ''}`}>
      {f.label}
      <span class="filter-count">{counts[f.key as keyof typeof counts]}</span>
    </a>
  ))}
</div>

<!-- Search -->
<div class="search-wrap">
  <svg class="search-icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
    <circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/>
  </svg>
  <input id="srch" type="text" class="search-input" placeholder="Ad, e-posta veya şirket ara…">
</div>

<!-- Table -->
<div class="tbl-wrap">
  {rows.length === 0 ? (
    <div class="empty">
      <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round">
        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
        <polyline points="14 2 14 8 20 8"/>
      </svg>
      <p>Bu filtre için talep bulunamadı.</p>
    </div>
  ) : (
    <table id="req-table">
      <thead>
        <tr>
          <th>Durum</th>
          <th>Ad Soyad</th>
          <th>Şirket</th>
          <th>Hizmet</th>
          <th>Mesaj</th>
          <th>Tarih</th>
          <th>İşlemler</th>
        </tr>
      </thead>
      <tbody>
        {rows.map(r => (
          <tr
            data-search={`${r.name} ${r.email} ${r.company ?? ''} ${r.service}`}
            onclick={`showReq(${JSON.stringify(JSON.stringify(r))})`}
          >
            <td>
              <span class={`badge badge-${statusColor[r.status] ?? 'amber'}`}>
                {statusLabel[r.status] ?? r.status}
              </span>
            </td>
            <td>
              <div style="font-weight:500">{r.name}</div>
              <div class="text-faint">{r.email}</div>
            </td>
            <td class="text-muted">{r.company ?? '—'}</td>
            <td class="text-muted">{serviceLabel[r.service] ?? r.service}</td>
            <td><div class="truncate text-muted">{r.message}</div></td>
            <td class="text-faint" style="white-space:nowrap">{fmt(r.createdAt)}</td>
            <td onclick="event.stopPropagation()">
              <div class="actions">
                <button class="act-btn" onclick={`showReq(${JSON.stringify(JSON.stringify(r))})`}>Görüntüle</button>
                <form method="post" action="/api/admin/talepler-delete" onsubmit="return confirm('Bu talep silinsin mi?')">
                  <input type="hidden" name="id" value={r.id}/>
                  <input type="hidden" name="back" value={Astro.url.pathname + Astro.url.search}/>
                  <button type="submit" class="act-btn danger">Sil</button>
                </form>
              </div>
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  )}
</div>

<!-- Detail dialog -->
<dialog id="reqDlg">
  <div class="dlg-head">
    <div class="dlg-title" id="dlg-name">—</div>
    <button class="dlg-close" onclick="document.getElementById('reqDlg').close()">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
    </button>
  </div>
  <div class="dlg-body">
    <div class="dlg-grid">
      <div class="dlg-field"><label>E-posta</label><p id="dlg-email">—</p></div>
      <div class="dlg-field"><label>Telefon</label><p id="dlg-phone">—</p></div>
      <div class="dlg-field"><label>Şirket</label><p id="dlg-company">—</p></div>
      <div class="dlg-field"><label>Hizmet</label><p id="dlg-service">—</p></div>
      <div class="dlg-field"><label>Tarih</label><p id="dlg-date">—</p></div>
      <div class="dlg-field"><label>Durum</label><p id="dlg-status-text">—</p></div>
      <div class="dlg-field dlg-msg"><label>Mesaj</label><p id="dlg-message" style="white-space:pre-wrap">—</p></div>
    </div>
  </div>
  <div class="dlg-foot">
    <form id="dlg-status-form" class="status-form" method="post" action="/api/admin/talepler-update">
      <input type="hidden" name="id" id="dlg-id"/>
      <input type="hidden" name="back" value={Astro.url.pathname + Astro.url.search}/>
      <select name="status" class="status-select" id="dlg-status-sel">
        <option value="beklemede">Beklemede</option>
        <option value="inceleniyor">İnceleniyor</option>
        <option value="tamamlandi">Tamamlandı</option>
        <option value="reddedildi">Reddedildi</option>
      </select>
      <button type="submit" class="btn-save">Kaydet</button>
    </form>
    <form id="dlg-del-form" method="post" action="/api/admin/talepler-delete" onsubmit="return confirm('Bu talep silinsin mi?')" style="margin-left:auto">
      <input type="hidden" name="id" id="dlg-del-id"/>
      <input type="hidden" name="back" value={Astro.url.pathname + Astro.url.search}/>
      <button type="submit" class="btn-del">Sil</button>
    </form>
  </div>
</dialog>

<!-- New request dialog -->
<dialog id="newReqDlg">
  <div class="dlg-head">
    <div class="dlg-title">Yeni Talep Ekle</div>
    <button class="dlg-close" onclick="document.getElementById('newReqDlg').close()">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
    </button>
  </div>
  <form method="post" action="/api/admin/talepler-create">
    <input type="hidden" name="back" value={Astro.url.pathname}/>
    <div class="dlg-body">
      <div class="dlg-grid">
        <div class="dlg-field">
          <label>Ad Soyad *</label>
          <input type="text" name="name" required style="width:100%;padding:.5rem .75rem;background:var(--adm-card-h);border:1px solid var(--adm-border);border-radius:.5rem;color:var(--adm-text);font-size:.875rem;outline:none"/>
        </div>
        <div class="dlg-field">
          <label>E-posta *</label>
          <input type="email" name="email" required style="width:100%;padding:.5rem .75rem;background:var(--adm-card-h);border:1px solid var(--adm-border);border-radius:.5rem;color:var(--adm-text);font-size:.875rem;outline:none"/>
        </div>
        <div class="dlg-field">
          <label>Şirket</label>
          <input type="text" name="company" style="width:100%;padding:.5rem .75rem;background:var(--adm-card-h);border:1px solid var(--adm-border);border-radius:.5rem;color:var(--adm-text);font-size:.875rem;outline:none"/>
        </div>
        <div class="dlg-field">
          <label>Telefon</label>
          <input type="text" name="phone" style="width:100%;padding:.5rem .75rem;background:var(--adm-card-h);border:1px solid var(--adm-border);border-radius:.5rem;color:var(--adm-text);font-size:.875rem;outline:none"/>
        </div>
        <div class="dlg-field">
          <label>Hizmet *</label>
          <select name="service" required class="status-select" style="width:100%">
            <option value="web">Web Uygulaması</option>
            <option value="mobile">Mobil Uygulama</option>
            <option value="api">API / Backend</option>
            <option value="consulting">Danışmanlık</option>
            <option value="other">Diğer</option>
          </select>
        </div>
        <div class="dlg-field">
          <label>Durum</label>
          <select name="status" class="status-select" style="width:100%">
            <option value="beklemede">Beklemede</option>
            <option value="inceleniyor">İnceleniyor</option>
            <option value="tamamlandi">Tamamlandı</option>
            <option value="reddedildi">Reddedildi</option>
          </select>
        </div>
        <div class="dlg-field dlg-msg">
          <label>Mesaj *</label>
          <textarea name="message" required rows="4" style="width:100%;padding:.5rem .75rem;background:var(--adm-card-h);border:1px solid var(--adm-border);border-radius:.5rem;color:var(--adm-text);font-size:.875rem;outline:none;resize:vertical"></textarea>
        </div>
      </div>
    </div>
    <div class="dlg-foot">
      <button type="button" class="act-btn" onclick="document.getElementById('newReqDlg').close()">İptal</button>
      <button type="submit" class="btn-save">Kaydet</button>
    </div>
  </form>
</dialog>

<script is:inline>
var SVC = { web:'Web Uygulaması', mobile:'Mobil Uygulama', api:'API / Backend', consulting:'Danışmanlık', other:'Diğer' };
var STS = { beklemede:'Beklemede', inceleniyor:'İnceleniyor', tamamlandi:'Tamamlandı', reddedildi:'Reddedildi' };

function showReq(raw) {
  var r = JSON.parse(raw);
  document.getElementById('dlg-name').textContent    = r.name;
  document.getElementById('dlg-email').textContent   = r.email;
  document.getElementById('dlg-phone').textContent   = r.phone || '—';
  document.getElementById('dlg-company').textContent = r.company || '—';
  document.getElementById('dlg-service').textContent = SVC[r.service] || r.service;
  document.getElementById('dlg-message').textContent = r.message;
  document.getElementById('dlg-status-text').textContent = STS[r.status] || r.status;
  document.getElementById('dlg-date').textContent = new Date(r.createdAt).toLocaleDateString('tr-TR',{day:'2-digit',month:'long',year:'numeric'});
  document.getElementById('dlg-id').value     = r.id;
  document.getElementById('dlg-del-id').value = r.id;
  document.getElementById('dlg-status-sel').value = r.status;
  document.getElementById('reqDlg').showModal();
}

// Client-side search
document.getElementById('srch').addEventListener('input', function() {
  var q = this.value.toLowerCase();
  document.querySelectorAll('#req-table tbody tr').forEach(function(tr) {
    tr.style.display = tr.dataset.search.toLowerCase().includes(q) ? '' : 'none';
  });
});
</script>

</AdminLayout>
