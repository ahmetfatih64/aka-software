---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { db, Projects, Leads, Contracts, TimeEntries } from 'astro:db';
import { desc, eq } from 'astro:db';

const filter = Astro.url.searchParams.get('filter') ?? 'tumu';
const saved  = Astro.url.searchParams.get('saved');

const allProjects  = (await db.select().from(Projects).orderBy(desc(Projects.createdAt))) as any[];
const allLeads     = (await db.select().from(Leads)) as any[];
const allContracts = (await db.select().from(Contracts)) as any[];
const allTime      = (await db.select().from(TimeEntries)) as any[];

const leadsMap    = Object.fromEntries(allLeads.map(l    => [l.id, l]));
const contractMap = Object.fromEntries(allContracts.map(c => [c.id, c]));

// Toplam logged saat / proje
const hoursPerProject: Record<number, number> = {};
for (const t of allTime) {
  hoursPerProject[t.projectId] = (hoursPerProject[t.projectId] ?? 0) + t.hours;
}

const counts = {
  tumu:      allProjects.length,
  planning:  allProjects.filter(p => p.status === 'planning').length,
  active:    allProjects.filter(p => p.status === 'active').length,
  on_hold:   allProjects.filter(p => p.status === 'on_hold').length,
  completed: allProjects.filter(p => p.status === 'completed').length,
  cancelled: allProjects.filter(p => p.status === 'cancelled').length,
};

let rows = filter === 'tumu' ? allProjects : allProjects.filter(p => p.status === filter);

const statusLabel: Record<string, string> = {
  planning: 'Planlama', active: 'Aktif', on_hold: 'Beklemede',
  completed: 'Tamamlandı', cancelled: 'İptal',
};
const typeLabel: Record<string, string> = {
  fixed_price: 'Sabit', time_material: 'T&M', retainer: 'Retainer',
};

function fmt(d: Date | null | string) {
  if (!d) return '—';
  return new Date(d).toLocaleDateString('tr-TR', { day: '2-digit', month: 'short', year: 'numeric' });
}
function fmtMoney(n: number) {
  return n.toLocaleString('tr-TR', { minimumFractionDigits: 0, maximumFractionDigits: 0 });
}
function budgetPct(logged: number, budget: number | null | undefined) {
  if (!budget || budget === 0) return null;
  return Math.round((logged / budget) * 100);
}
---

<AdminLayout title="Projeler" section="projeler">
<style>
  .page-header { display:flex; align-items:center; justify-content:space-between; margin-bottom:1.75rem; gap:1rem; flex-wrap:wrap; }
  .page-title  { font-size:1.25rem; font-weight:700; color:var(--adm-text); }
  .page-sub    { font-size:0.8125rem; color:var(--adm-muted); margin-top:0.2rem; }
  .filter-bar { display:flex; gap:0.375rem; flex-wrap:wrap; margin-bottom:1.5rem; }
  .filter-btn { display:inline-flex; align-items:center; gap:0.375rem; padding:0.4375rem 0.875rem; border-radius:0.5rem; border:1px solid var(--adm-border); font-size:0.8125rem; font-weight:500; color:var(--adm-muted); background:transparent; cursor:pointer; text-decoration:none; transition:all 150ms; }
  .filter-btn:hover { color:var(--adm-text); background:rgba(255,255,255,0.04); }
  .filter-btn.active { color:var(--adm-gold); border-color:rgba(217,161,40,0.35); background:rgba(217,161,40,0.07); }
  .filter-count { font-size:0.6875rem; padding:0.125rem 0.375rem; border-radius:9999px; background:rgba(255,255,255,0.07); }
  .btn-primary { display:inline-flex; align-items:center; gap:0.375rem; padding:0.5rem 1rem; border-radius:0.625rem; background:var(--adm-gold); color:#0b0a09; font-size:0.8125rem; font-weight:600; border:none; cursor:pointer; text-decoration:none; transition:background 150ms; white-space:nowrap; }
  .btn-primary:hover { background:var(--adm-gold-b); }
  .cards { display:grid; grid-template-columns:repeat(auto-fill, minmax(320px, 1fr)); gap:1rem; }
  .card {
    background:var(--adm-card); border:1px solid var(--adm-border); border-radius:1rem;
    padding:1.25rem; display:flex; flex-direction:column; gap:0.875rem;
    transition:border-color 150ms;
  }
  .card:hover { border-color:var(--adm-border-h); }
  .card-head { display:flex; align-items:flex-start; justify-content:space-between; gap:0.75rem; }
  .card-code { font-size:0.6875rem; font-family:monospace; color:var(--adm-faint); margin-bottom:0.25rem; }
  .card-name { font-size:0.9375rem; font-weight:700; color:var(--adm-text); line-height:1.3; }
  .card-client { font-size:0.75rem; color:var(--adm-muted); margin-top:0.2rem; }
  .badge { display:inline-flex; align-items:center; gap:0.3rem; padding:0.2rem 0.6rem; border-radius:9999px; font-size:0.6875rem; font-weight:600; white-space:nowrap; flex-shrink:0; }
  .badge-dot { width:5px; height:5px; border-radius:9999px; flex-shrink:0; }
  .badge-planning  { background:rgba(120,110,90,0.15); color:rgba(178,164,144,0.80); border:1px solid rgba(120,110,90,0.22); }
  .badge-active    { background:rgba(74,222,128,0.12);  color:rgb(74,222,128);  border:1px solid rgba(74,222,128,0.25); }
  .badge-on_hold   { background:rgba(251,191,36,0.12);  color:rgb(251,191,36);  border:1px solid rgba(251,191,36,0.25); }
  .badge-completed { background:rgba(217,161,40,0.12);  color:rgb(217,161,40);  border:1px solid rgba(217,161,40,0.25); }
  .badge-cancelled { background:rgba(248,113,113,0.10); color:rgb(248,113,113); border:1px solid rgba(248,113,113,0.22); }
  .card-meta { display:grid; grid-template-columns:1fr 1fr; gap:0.5rem; }
  .meta-item label { font-size:0.625rem; font-weight:600; letter-spacing:0.06em; text-transform:uppercase; color:var(--adm-faint); display:block; margin-bottom:0.2rem; }
  .meta-item span  { font-size:0.8125rem; color:var(--adm-muted); }
  .meta-item .val  { font-weight:600; color:var(--adm-text); }
  .meta-item .money { color:var(--adm-gold); font-weight:700; }
  .progress-wrap { display:flex; flex-direction:column; gap:0.375rem; }
  .progress-label { display:flex; justify-content:space-between; font-size:0.75rem; color:var(--adm-muted); }
  .progress-bar { height:4px; background:rgba(255,255,255,0.07); border-radius:9999px; overflow:hidden; }
  .progress-fill { height:100%; border-radius:9999px; transition:width 300ms; }
  .progress-ok   { background:rgba(74,222,128,0.7); }
  .progress-warn { background:rgba(251,191,36,0.8); }
  .progress-over { background:rgba(248,113,113,0.8); }
  .card-actions { display:flex; gap:0.5rem; flex-wrap:wrap; margin-top:auto; }
  .action-btn { padding:0.3125rem 0.625rem; border-radius:0.375rem; font-size:0.75rem; font-weight:500; border:1px solid var(--adm-border); background:transparent; color:var(--adm-muted); cursor:pointer; text-decoration:none; transition:all 150ms; white-space:nowrap; }
  .action-btn:hover { color:var(--adm-text); border-color:var(--adm-border-h); background:rgba(255,255,255,0.04); }
  .action-btn.gold  { color:var(--adm-gold); border-color:rgba(217,161,40,0.30); }
  .action-btn.gold:hover { background:rgba(217,161,40,0.08); }
  .no-contract { font-size:0.6875rem; color:var(--adm-amber); }
  .empty-state { padding:3rem; text-align:center; color:var(--adm-faint); font-size:0.875rem; background:var(--adm-card); border:1px solid var(--adm-border); border-radius:1rem; }
  .toast { position:fixed; top:1.25rem; right:1.25rem; z-index:9999; background:var(--adm-card); border:1px solid rgba(74,222,128,0.30); border-radius:0.75rem; padding:0.875rem 1.25rem; font-size:0.875rem; color:var(--adm-green); box-shadow:0 8px 32px rgba(0,0,0,0.4); animation:toastIn 300ms ease, toastOut 300ms ease 2.5s forwards; }
  @keyframes toastIn  { from{opacity:0;transform:translateY(-8px)} to{opacity:1;transform:translateY(0)} }
  @keyframes toastOut { to{opacity:0;transform:translateY(-8px)} }
  dialog { background:var(--adm-card); border:1px solid var(--adm-border); border-radius:1.25rem; padding:0; max-width:500px; width:94vw; color:var(--adm-text); box-shadow:0 24px 64px rgba(0,0,0,0.6); }
  dialog::backdrop { background:rgba(0,0,0,0.55); }
  .dlg-head { display:flex; align-items:center; justify-content:space-between; padding:1.25rem 1.5rem; border-bottom:1px solid var(--adm-border); }
  .dlg-title { font-size:1rem; font-weight:700; }
  .dlg-close { background:none; border:none; color:var(--adm-faint); cursor:pointer; font-size:1.25rem; line-height:1; }
  .dlg-body  { padding:1.5rem; display:flex; flex-direction:column; gap:1rem; }
  .dlg-row   { display:grid; grid-template-columns:1fr 1fr; gap:0.75rem; }
  .dlg-field label { font-size:0.6875rem; font-weight:600; letter-spacing:0.06em; text-transform:uppercase; color:var(--adm-faint); display:block; margin-bottom:0.375rem; }
  .dlg-field input, .dlg-field select, .dlg-field textarea { width:100%; padding:0.5625rem 0.75rem; background:rgba(255,255,255,0.04); border:1px solid var(--adm-border); border-radius:0.5rem; color:var(--adm-text); font-size:0.875rem; outline:none; transition:border-color 150ms; font-family:inherit; }
  .dlg-field input:focus, .dlg-field select:focus { border-color:var(--adm-border-h); }
  .dlg-field select option { background:#1a1710; }
  .dlg-field textarea { resize:vertical; min-height:64px; }
  .dlg-foot { padding:1rem 1.5rem; border-top:1px solid var(--adm-border); display:flex; gap:0.75rem; justify-content:flex-end; }
  .btn-ghost { padding:0.5rem 1rem; border-radius:0.5rem; font-size:0.875rem; background:transparent; border:1px solid var(--adm-border); color:var(--adm-muted); cursor:pointer; }
  .btn-save  { padding:0.5rem 1.25rem; border-radius:0.5rem; font-size:0.875rem; font-weight:600; background:var(--adm-gold); color:#0b0a09; border:none; cursor:pointer; }
  .btn-save:hover { background:var(--adm-gold-b); }
</style>

{saved && <div class="toast">✓ Proje kaydedildi.</div>}

<div class="page-header">
  <div>
    <div class="page-title">Projeler</div>
    <div class="page-sub">Aktif ve geçmiş projeler</div>
  </div>
  <button class="btn-primary" onclick="document.getElementById('dlg-new').showModal()">
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
    Manuel Proje
  </button>
</div>

<div class="filter-bar">
  {[
    { key: 'tumu',      label: 'Tümü' },
    { key: 'planning',  label: 'Planlama' },
    { key: 'active',    label: 'Aktif' },
    { key: 'on_hold',   label: 'Beklemede' },
    { key: 'completed', label: 'Tamamlandı' },
    { key: 'cancelled', label: 'İptal' },
  ].map(f => (
    <a href={`/admin/projeler?filter=${f.key}`} class={`filter-btn${filter === f.key ? ' active' : ''}`}>
      {f.label}
      <span class="filter-count">{counts[f.key as keyof typeof counts]}</span>
    </a>
  ))}
</div>

{rows.length === 0 ? (
  <div class="empty-state">
    {filter === 'tumu'
      ? 'Henüz proje yok. Sözleşmeler sayfasından "Proje Oluştur" ile başlayın.'
      : 'Bu filtrede proje yok.'}
  </div>
) : (
  <div class="cards">
    {rows.map(p => {
      const lead     = p.leadId     ? leadsMap[p.leadId]       : null;
      const contract = p.contractId ? contractMap[p.contractId] : null;
      const logged   = hoursPerProject[p.id] ?? 0;
      const pct      = budgetPct(logged, p.budgetHours);
      return (
        <div class="card">
          <div class="card-head">
            <div>
              <div class="card-code">{p.projectCode}</div>
              <div class="card-name">{p.name}</div>
              <div class="card-client">
                {lead ? `${lead.contactName}${lead.companyName ? ` — ${lead.companyName}` : ''}` : '—'}
              </div>
              {!p.contractId && <div class="no-contract">⚠ Sözleşmesiz proje</div>}
            </div>
            <span class={`badge badge-${p.status}`}>
              <span class="badge-dot"></span>
              {statusLabel[p.status]}
            </span>
          </div>

          <div class="card-meta">
            <div class="meta-item">
              <label>Tür</label>
              <span class="val">{typeLabel[p.projectType]}</span>
            </div>
            <div class="meta-item">
              <label>Bütçe</label>
              <span class="money">
                {p.budgetAmount ? `${fmtMoney(p.budgetAmount)} ₺` : '—'}
              </span>
            </div>
            <div class="meta-item">
              <label>Başlangıç</label>
              <span>{fmt(p.startDate)}</span>
            </div>
            <div class="meta-item">
              <label>Bitiş</label>
              <span>{fmt(p.endDate)}</span>
            </div>
          </div>

          {p.budgetHours && p.budgetHours > 0 && (
            <div class="progress-wrap">
              <div class="progress-label">
                <span>Saat: {logged.toFixed(1)} / {p.budgetHours}</span>
                <span>{pct}%</span>
              </div>
              <div class="progress-bar">
                <div
                  class={`progress-fill ${pct! > 100 ? 'progress-over' : pct! >= 80 ? 'progress-warn' : 'progress-ok'}`}
                  style={`width:${Math.min(pct!, 100)}%`}
                ></div>
              </div>
            </div>
          )}

          <div class="card-actions">
            <button class="action-btn gold" onclick={`openEdit(${JSON.stringify(p)})`}>Düzenle</button>
            <a href={`/admin/zaman-takibi?projectId=${p.id}`} class="action-btn">
              Zaman Girişi
            </a>
          </div>
        </div>
      );
    })}
  </div>
)}

<!-- Manuel Proje Dialog -->
<dialog id="dlg-new">
  <div class="dlg-head">
    <div class="dlg-title">Manuel Proje Oluştur</div>
    <button class="dlg-close" onclick="document.getElementById('dlg-new').close()">×</button>
  </div>
  <form method="POST" action="/api/admin/project-create">
    <div class="dlg-body">
      <div class="dlg-field">
        <label>Proje Adı *</label>
        <input name="name" required placeholder="Proje adı…"/>
      </div>
      <div class="dlg-row">
        <div class="dlg-field">
          <label>Tür</label>
          <select name="projectType">
            <option value="fixed_price">Sabit Fiyat</option>
            <option value="time_material">Zaman & Malzeme</option>
            <option value="retainer">Retainer</option>
          </select>
        </div>
        <div class="dlg-field">
          <label>Bütçe (₺)</label>
          <input name="budgetAmount" type="number" min="0" step="0.01" placeholder="0"/>
        </div>
      </div>
      <div class="dlg-row">
        <div class="dlg-field">
          <label>Planlanan Saat</label>
          <input name="budgetHours" type="number" min="0" step="0.5" placeholder="0"/>
        </div>
        <div class="dlg-field">
          <label>Saatlik Ücret (₺)</label>
          <input name="hourlyRate" type="number" min="0" step="0.01" placeholder="0"/>
        </div>
      </div>
      <div class="dlg-row">
        <div class="dlg-field">
          <label>Başlangıç</label>
          <input name="startDate" type="date"/>
        </div>
        <div class="dlg-field">
          <label>Bitiş</label>
          <input name="endDate" type="date"/>
        </div>
      </div>
      <div class="dlg-field">
        <label>Açıklama</label>
        <textarea name="description" placeholder="Proje kapsamı…"></textarea>
      </div>
    </div>
    <div class="dlg-foot">
      <button type="button" class="btn-ghost" onclick="document.getElementById('dlg-new').close()">İptal</button>
      <button type="submit" class="btn-save">Oluştur</button>
    </div>
  </form>
</dialog>

<!-- Düzenle Dialog -->
<dialog id="dlg-edit">
  <div class="dlg-head">
    <div class="dlg-title">Proje Düzenle</div>
    <button class="dlg-close" onclick="document.getElementById('dlg-edit').close()">×</button>
  </div>
  <form method="POST" action="/api/admin/project-update">
    <input type="hidden" name="id" id="edit-id"/>
    <div class="dlg-body">
      <div class="dlg-field">
        <label>Proje Adı *</label>
        <input id="edit-name" name="name" required/>
      </div>
      <div class="dlg-row">
        <div class="dlg-field">
          <label>Durum</label>
          <select id="edit-status" name="status">
            <option value="planning">Planlama</option>
            <option value="active">Aktif</option>
            <option value="on_hold">Beklemede</option>
            <option value="completed">Tamamlandı</option>
            <option value="cancelled">İptal</option>
          </select>
        </div>
        <div class="dlg-field">
          <label>Tür</label>
          <select id="edit-type" name="projectType">
            <option value="fixed_price">Sabit Fiyat</option>
            <option value="time_material">Zaman & Malzeme</option>
            <option value="retainer">Retainer</option>
          </select>
        </div>
      </div>
      <div class="dlg-row">
        <div class="dlg-field">
          <label>Bütçe (₺)</label>
          <input id="edit-budget" name="budgetAmount" type="number" min="0" step="0.01"/>
        </div>
        <div class="dlg-field">
          <label>Saatlik Ücret (₺)</label>
          <input id="edit-hourly" name="hourlyRate" type="number" min="0" step="0.01"/>
        </div>
      </div>
      <div class="dlg-row">
        <div class="dlg-field">
          <label>Başlangıç</label>
          <input id="edit-start" name="startDate" type="date"/>
        </div>
        <div class="dlg-field">
          <label>Bitiş</label>
          <input id="edit-end" name="endDate" type="date"/>
        </div>
      </div>
      <div class="dlg-field">
        <label>Açıklama</label>
        <textarea id="edit-desc" name="description"></textarea>
      </div>
    </div>
    <div class="dlg-foot">
      <button type="button" class="btn-ghost" onclick="document.getElementById('dlg-edit').close()">İptal</button>
      <button type="submit" class="btn-save">Kaydet</button>
    </div>
  </form>
</dialog>

<script is:inline>
  function openEdit(p) {
    document.getElementById('edit-id').value     = p.id;
    document.getElementById('edit-name').value   = p.name        ?? '';
    document.getElementById('edit-status').value = p.status      ?? 'planning';
    document.getElementById('edit-type').value   = p.projectType ?? 'fixed_price';
    document.getElementById('edit-budget').value = p.budgetAmount ?? '';
    document.getElementById('edit-hourly').value = p.hourlyRate   ?? '';
    document.getElementById('edit-desc').value   = p.description  ?? '';
    function d(v) { return v ? new Date(v).toISOString().split('T')[0] : ''; }
    document.getElementById('edit-start').value = d(p.startDate);
    document.getElementById('edit-end').value   = d(p.endDate);
    document.getElementById('dlg-edit').showModal();
  }
</script>
</AdminLayout>
