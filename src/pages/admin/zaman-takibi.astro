---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { db, TimeEntries, Projects } from 'astro:db';
import { desc, eq } from 'astro:db';

const filter    = Astro.url.searchParams.get('filter')    ?? 'tumu';
const projectId = Astro.url.searchParams.get('projectId');
const saved     = Astro.url.searchParams.get('saved');

const activeProjects = (await db.select().from(Projects)
  .where(eq(Projects.status, 'active'))) as any[];
const allProjects    = (await db.select().from(Projects)) as any[];
const projectMap     = Object.fromEntries(allProjects.map((p: any) => [p.id, p]));

let allEntries = (await db.select().from(TimeEntries).orderBy(desc(TimeEntries.entryDate))) as any[];
if (projectId) allEntries = allEntries.filter(e => e.projectId === Number(projectId));

const counts = {
  tumu:      allEntries.length,
  draft:     allEntries.filter(e => e.status === 'draft').length,
  submitted: allEntries.filter(e => e.status === 'submitted').length,
  approved:  allEntries.filter(e => e.status === 'approved').length,
  invoiced:  allEntries.filter(e => e.status === 'invoiced').length,
  rejected:  allEntries.filter(e => e.status === 'rejected').length,
};

let rows = filter === 'tumu' ? allEntries : allEntries.filter(e => e.status === filter);

const totalHours     = rows.reduce((s, e) => s + e.hours, 0);
const billableHours  = rows.filter(e => e.isBillable === 1).reduce((s, e) => s + e.hours, 0);
const billableAmount = rows.filter(e => e.isBillable === 1 && e.billableAmount)
  .reduce((s, e) => s + (e.billableAmount ?? 0), 0);

const statusLabel: Record<string, string> = {
  draft: 'Taslak', submitted: 'Onay Bekliyor', approved: 'Onaylandı',
  invoiced: 'Faturalandı', rejected: 'Reddedildi',
};

function fmt(d: Date | null | string) {
  if (!d) return '—';
  return new Date(d).toLocaleDateString('tr-TR', { day: '2-digit', month: 'short', year: 'numeric' });
}
function fmtMoney(n: number) {
  return n.toLocaleString('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
}

const selectedProject = projectId ? projectMap[Number(projectId)] : null;
---

<AdminLayout title="Zaman Takibi" section="zaman-takibi">
<style>
  .page-header { display:flex; align-items:center; justify-content:space-between; margin-bottom:1.75rem; gap:1rem; flex-wrap:wrap; }
  .page-title  { font-size:1.25rem; font-weight:700; color:var(--adm-text); }
  .page-sub    { font-size:0.8125rem; color:var(--adm-muted); margin-top:0.2rem; }
  .btn-primary { display:inline-flex; align-items:center; gap:0.375rem; padding:0.5rem 1rem; border-radius:0.625rem; background:var(--adm-gold); color:#0b0a09; font-size:0.8125rem; font-weight:600; border:none; cursor:pointer; text-decoration:none; transition:background 150ms; white-space:nowrap; }
  .btn-primary:hover { background:var(--adm-gold-b); }
  .filter-bar { display:flex; gap:0.375rem; flex-wrap:wrap; margin-bottom:1.5rem; }
  .filter-btn { display:inline-flex; align-items:center; gap:0.375rem; padding:0.4375rem 0.875rem; border-radius:0.5rem; border:1px solid var(--adm-border); font-size:0.8125rem; font-weight:500; color:var(--adm-muted); background:transparent; cursor:pointer; text-decoration:none; transition:all 150ms; }
  .filter-btn:hover { color:var(--adm-text); background:rgba(255,255,255,0.04); }
  .filter-btn.active { color:var(--adm-gold); border-color:rgba(217,161,40,0.35); background:rgba(217,161,40,0.07); }
  .filter-count { font-size:0.6875rem; padding:0.125rem 0.375rem; border-radius:9999px; background:rgba(255,255,255,0.07); }
  .summary-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:1rem; margin-bottom:1.5rem; }
  @media(max-width:640px) { .summary-grid { grid-template-columns:1fr; } }
  .sum-card { background:var(--adm-card); border:1px solid var(--adm-border); border-radius:0.875rem; padding:1.125rem 1.25rem; }
  .sum-label { font-size:0.6875rem; font-weight:600; letter-spacing:0.07em; text-transform:uppercase; color:var(--adm-faint); margin-bottom:0.5rem; }
  .sum-value { font-size:1.625rem; font-weight:800; color:var(--adm-gold); letter-spacing:-0.03em; }
  .sum-sub   { font-size:0.75rem; color:var(--adm-muted); margin-top:0.25rem; }
  .table-wrap { background:var(--adm-card); border:1px solid var(--adm-border); border-radius:1rem; overflow:hidden; }
  table { width:100%; border-collapse:collapse; }
  thead th { padding:0.75rem 1rem; font-size:0.6875rem; font-weight:600; letter-spacing:0.08em; text-transform:uppercase; color:var(--adm-faint); background:rgba(255,255,255,0.02); border-bottom:1px solid var(--adm-border); text-align:left; }
  tbody tr { border-bottom:1px solid rgba(161,116,24,0.07); transition:background 120ms; }
  tbody tr:last-child { border-bottom:none; }
  tbody tr:hover { background:rgba(217,161,40,0.04); }
  td { padding:0.875rem 1rem; font-size:0.8125rem; color:var(--adm-muted); vertical-align:middle; }
  td.primary { font-weight:600; color:var(--adm-text); }
  .badge { display:inline-flex; align-items:center; gap:0.3rem; padding:0.2rem 0.6rem; border-radius:9999px; font-size:0.6875rem; font-weight:600; white-space:nowrap; }
  .badge-dot { width:5px; height:5px; border-radius:9999px; flex-shrink:0; }
  .badge-draft     { background:rgba(120,110,90,0.15); color:rgba(178,164,144,0.80); border:1px solid rgba(120,110,90,0.22); }
  .badge-submitted { background:rgba(251,191,36,0.12); color:rgb(251,191,36); border:1px solid rgba(251,191,36,0.28); }
  .badge-approved  { background:rgba(74,222,128,0.12); color:rgb(74,222,128); border:1px solid rgba(74,222,128,0.25); }
  .badge-invoiced  { background:rgba(217,161,40,0.12); color:rgb(217,161,40); border:1px solid rgba(217,161,40,0.25); }
  .badge-rejected  { background:rgba(248,113,113,0.10); color:rgb(248,113,113); border:1px solid rgba(248,113,113,0.22); }
  .billable-yes { color:var(--adm-green); font-size:0.75rem; font-weight:600; }
  .billable-no  { color:var(--adm-faint); font-size:0.75rem; }
  .hours-val { font-weight:700; color:var(--adm-text); }
  .money { font-weight:700; color:var(--adm-gold); }
  .actions { display:flex; gap:0.5rem; flex-wrap:wrap; }
  .action-btn { padding:0.3125rem 0.625rem; border-radius:0.375rem; font-size:0.75rem; font-weight:500; border:1px solid var(--adm-border); background:transparent; color:var(--adm-muted); cursor:pointer; text-decoration:none; transition:all 150ms; white-space:nowrap; }
  .action-btn:hover { color:var(--adm-text); border-color:var(--adm-border-h); background:rgba(255,255,255,0.04); }
  .action-btn.green { color:var(--adm-green); border-color:rgba(74,222,128,0.28); }
  .action-btn.green:hover { background:rgba(74,222,128,0.07); }
  .action-btn.amber { color:var(--adm-amber); border-color:rgba(251,191,36,0.28); }
  .action-btn.amber:hover { background:rgba(251,191,36,0.07); }
  .action-btn.danger { color:var(--adm-red); border-color:rgba(248,113,113,0.22); }
  .action-btn.danger:hover { background:rgba(248,113,113,0.07); }
  .empty-state { padding:3rem; text-align:center; color:var(--adm-faint); font-size:0.875rem; }
  .project-filter { display:flex; align-items:center; gap:0.75rem; margin-bottom:1.25rem; flex-wrap:wrap; }
  .project-filter label { font-size:0.8125rem; color:var(--adm-muted); }
  .project-filter select { padding:0.4375rem 0.75rem; background:var(--adm-card); border:1px solid var(--adm-border); border-radius:0.5rem; color:var(--adm-text); font-size:0.8125rem; outline:none; cursor:pointer; }
  .toast { position:fixed; top:1.25rem; right:1.25rem; z-index:9999; background:var(--adm-card); border:1px solid rgba(74,222,128,0.30); border-radius:0.75rem; padding:0.875rem 1.25rem; font-size:0.875rem; color:var(--adm-green); box-shadow:0 8px 32px rgba(0,0,0,0.4); animation:toastIn 300ms ease, toastOut 300ms ease 2.5s forwards; }
  @keyframes toastIn  { from{opacity:0;transform:translateY(-8px)} to{opacity:1;transform:translateY(0)} }
  @keyframes toastOut { to{opacity:0;transform:translateY(-8px)} }
  dialog { background:var(--adm-card); border:1px solid var(--adm-border); border-radius:1.25rem; padding:0; max-width:520px; width:94vw; color:var(--adm-text); box-shadow:0 24px 64px rgba(0,0,0,0.6); }
  dialog::backdrop { background:rgba(0,0,0,0.55); }
  .dlg-head { display:flex; align-items:center; justify-content:space-between; padding:1.25rem 1.5rem; border-bottom:1px solid var(--adm-border); }
  .dlg-title { font-size:1rem; font-weight:700; }
  .dlg-close { background:none; border:none; color:var(--adm-faint); cursor:pointer; font-size:1.25rem; line-height:1; }
  .dlg-body  { padding:1.5rem; display:flex; flex-direction:column; gap:1rem; }
  .dlg-row   { display:grid; grid-template-columns:1fr 1fr; gap:0.75rem; }
  .dlg-field label { font-size:0.6875rem; font-weight:600; letter-spacing:0.06em; text-transform:uppercase; color:var(--adm-faint); display:block; margin-bottom:0.375rem; }
  .dlg-field input, .dlg-field select, .dlg-field textarea { width:100%; padding:0.5625rem 0.75rem; background:rgba(255,255,255,0.04); border:1px solid var(--adm-border); border-radius:0.5rem; color:var(--adm-text); font-size:0.875rem; outline:none; transition:border-color 150ms; font-family:inherit; }
  .dlg-field input:focus, .dlg-field select:focus, .dlg-field textarea:focus { border-color:var(--adm-border-h); }
  .dlg-field select option { background:#1a1710; }
  .dlg-field textarea { resize:vertical; min-height:72px; }
  .dlg-foot { padding:1rem 1.5rem; border-top:1px solid var(--adm-border); display:flex; gap:0.75rem; justify-content:flex-end; }
  .btn-ghost { padding:0.5rem 1rem; border-radius:0.5rem; font-size:0.875rem; background:transparent; border:1px solid var(--adm-border); color:var(--adm-muted); cursor:pointer; }
  .btn-save  { padding:0.5rem 1.25rem; border-radius:0.5rem; font-size:0.875rem; font-weight:600; background:var(--adm-gold); color:#0b0a09; border:none; cursor:pointer; }
  .btn-save:hover { background:var(--adm-gold-b); }
</style>

{saved && <div class="toast">✓ Zaman kaydı güncellendi.</div>}

<div class="page-header">
  <div>
    <div class="page-title">Zaman Takibi</div>
    <div class="page-sub">
      {selectedProject ? `Proje: ${selectedProject.name}` : 'Tüm projelerin zaman kayıtları'}
    </div>
  </div>
  <button class="btn-primary" onclick="openNew()">
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
    Zaman Girişi
  </button>
</div>

<!-- Proje filtresi -->
<div class="project-filter">
  <label>Proje:</label>
  <select onchange="window.location.href='/admin/zaman-takibi?projectId=' + this.value">
    <option value="" selected={!projectId}>Tümü</option>
    {allProjects.map(p => (
      <option value={p.id} selected={projectId === String(p.id)}>{p.projectCode} — {p.name}</option>
    ))}
  </select>
  {projectId && (
    <a href="/admin/zaman-takibi" style="font-size:0.8125rem;color:var(--adm-gold);">Filtreyi Temizle</a>
  )}
</div>

<!-- Özet -->
<div class="summary-grid">
  <div class="sum-card">
    <div class="sum-label">Toplam Saat</div>
    <div class="sum-value">{totalHours.toFixed(1)}</div>
    <div class="sum-sub">{rows.length} kayıt</div>
  </div>
  <div class="sum-card">
    <div class="sum-label">Faturalanabilir Saat</div>
    <div class="sum-value">{billableHours.toFixed(1)}</div>
    <div class="sum-sub">{totalHours > 0 ? Math.round((billableHours / totalHours) * 100) : 0}% oran</div>
  </div>
  <div class="sum-card">
    <div class="sum-label">Faturalanabilir Tutar</div>
    <div class="sum-value">{fmtMoney(billableAmount)}</div>
    <div class="sum-sub">₺ (onaylı kayıtlar)</div>
  </div>
</div>

<!-- Filter tabs -->
<div class="filter-bar">
  {[
    { key: 'tumu',      label: 'Tümü' },
    { key: 'draft',     label: 'Taslak' },
    { key: 'submitted', label: 'Onay Bekliyor' },
    { key: 'approved',  label: 'Onaylandı' },
    { key: 'invoiced',  label: 'Faturalandı' },
    { key: 'rejected',  label: 'Reddedildi' },
  ].map(f => (
    <a href={`/admin/zaman-takibi?filter=${f.key}${projectId ? `&projectId=${projectId}` : ''}`}
       class={`filter-btn${filter === f.key ? ' active' : ''}`}>
      {f.label}
      <span class="filter-count">{counts[f.key as keyof typeof counts]}</span>
    </a>
  ))}
</div>

<div class="table-wrap">
  {rows.length === 0 ? (
    <div class="empty-state">Kayıt yok. "Zaman Girişi" ile başlayın.</div>
  ) : (
    <table>
      <thead>
        <tr>
          <th>Tarih</th>
          <th>Proje</th>
          <th>Açıklama</th>
          <th>Saat</th>
          <th>Faturalanabilir</th>
          <th>Tutar</th>
          <th>Durum</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        {rows.map(e => {
          const proj = projectMap[e.projectId];
          return (
            <tr>
              <td>{fmt(e.entryDate)}</td>
              <td>
                <div class="primary" style="font-size:0.75rem;">{proj?.projectCode ?? '—'}</div>
                <div style="font-size:0.6875rem;color:var(--adm-faint);">{proj?.name ?? ''}</div>
              </td>
              <td style="max-width:200px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;" title={e.description}>
                {e.description}
              </td>
              <td><span class="hours-val">{e.hours.toFixed(1)}</span></td>
              <td>
                {e.isBillable === 1
                  ? <span class="billable-yes">✓ Evet</span>
                  : <span class="billable-no">Hayır</span>}
              </td>
              <td>
                {e.billableAmount && e.isBillable === 1
                  ? <span class="money">{fmtMoney(e.billableAmount)} ₺</span>
                  : <span style="color:var(--adm-faint)">—</span>}
              </td>
              <td>
                <span class={`badge badge-${e.status}`}>
                  <span class="badge-dot"></span>
                  {statusLabel[e.status]}
                </span>
              </td>
              <td>
                <div class="actions">
                  {e.status === 'draft' && (
                    <>
                      <button class="action-btn" onclick={`openEdit(${JSON.stringify(e)})`}>Düzenle</button>
                      <form method="POST" action="/api/admin/time-status" style="display:inline">
                        <input type="hidden" name="id" value={e.id}/>
                        <input type="hidden" name="status" value="submitted"/>
                        <button type="submit" class="action-btn amber">Onaya Gönder</button>
                      </form>
                    </>
                  )}
                  {e.status === 'submitted' && (
                    <>
                      <form method="POST" action="/api/admin/time-status" style="display:inline">
                        <input type="hidden" name="id" value={e.id}/>
                        <input type="hidden" name="status" value="approved"/>
                        <button type="submit" class="action-btn green">Onayla</button>
                      </form>
                      <form method="POST" action="/api/admin/time-status" style="display:inline">
                        <input type="hidden" name="id" value={e.id}/>
                        <input type="hidden" name="status" value="rejected"/>
                        <button type="submit" class="action-btn danger">Reddet</button>
                      </form>
                    </>
                  )}
                  {e.status === 'rejected' && (
                    <button class="action-btn" onclick={`openEdit(${JSON.stringify(e)})`}>Düzenle</button>
                  )}
                </div>
              </td>
            </tr>
          );
        })}
      </tbody>
    </table>
  )}
</div>

<!-- Yeni Giriş Dialog -->
<dialog id="dlg-new">
  <div class="dlg-head">
    <div class="dlg-title">Zaman Girişi</div>
    <button class="dlg-close" onclick="document.getElementById('dlg-new').close()">×</button>
  </div>
  <form method="POST" action="/api/admin/time-create">
    <div class="dlg-body">
      <div class="dlg-row">
        <div class="dlg-field">
          <label>Proje *</label>
          <select name="projectId" id="new-projectId" required onchange="updateHourlyRate(this)">
            <option value="">Proje seçin…</option>
            {activeProjects.map(p => (
              <option value={p.id} data-rate={p.hourlyRate ?? 0}
                selected={projectId === String(p.id)}>
                {p.projectCode} — {p.name}
              </option>
            ))}
          </select>
        </div>
        <div class="dlg-field">
          <label>Tarih *</label>
          <input name="entryDate" type="date" required id="new-date"/>
        </div>
      </div>
      <div class="dlg-row">
        <div class="dlg-field">
          <label>Saat *</label>
          <input name="hours" type="number" min="0.25" max="24" step="0.25" required placeholder="1.5" oninput="calcAmount()"/>
        </div>
        <div class="dlg-field">
          <label>Saatlik Ücret (₺)</label>
          <input name="hourlyRate" type="number" min="0" step="0.01" id="new-rate" placeholder="0" oninput="calcAmount()"/>
        </div>
      </div>
      <div class="dlg-row">
        <div class="dlg-field">
          <label>Faturalanabilir</label>
          <select name="isBillable" id="new-billable" onchange="calcAmount()">
            <option value="1">Evet</option>
            <option value="0">Hayır</option>
          </select>
        </div>
        <div class="dlg-field">
          <label>Tahmini Tutar</label>
          <input id="calc-amount" readonly style="background:rgba(217,161,40,0.06);color:var(--adm-gold);font-weight:700;" value="0,00 ₺"/>
        </div>
      </div>
      <div class="dlg-field">
        <label>Açıklama *</label>
        <textarea name="description" required placeholder="Yapılan iş açıklaması…"></textarea>
      </div>
    </div>
    <div class="dlg-foot">
      <button type="button" class="btn-ghost" onclick="document.getElementById('dlg-new').close()">İptal</button>
      <button type="submit" class="btn-save">Kaydet</button>
    </div>
  </form>
</dialog>

<!-- Düzenle Dialog -->
<dialog id="dlg-edit">
  <div class="dlg-head">
    <div class="dlg-title">Zaman Girişi Düzenle</div>
    <button class="dlg-close" onclick="document.getElementById('dlg-edit').close()">×</button>
  </div>
  <form method="POST" action="/api/admin/time-update">
    <input type="hidden" name="id" id="edit-id"/>
    <div class="dlg-body">
      <div class="dlg-row">
        <div class="dlg-field">
          <label>Saat *</label>
          <input id="edit-hours" name="hours" type="number" min="0.25" max="24" step="0.25" required/>
        </div>
        <div class="dlg-field">
          <label>Tarih *</label>
          <input id="edit-date" name="entryDate" type="date" required/>
        </div>
      </div>
      <div class="dlg-field">
        <label>Açıklama *</label>
        <textarea id="edit-desc" name="description" required></textarea>
      </div>
      <div class="dlg-field">
        <label>Faturalanabilir</label>
        <select id="edit-billable" name="isBillable">
          <option value="1">Evet</option>
          <option value="0">Hayır</option>
        </select>
      </div>
    </div>
    <div class="dlg-foot">
      <button type="button" class="btn-ghost" onclick="document.getElementById('dlg-edit').close()">İptal</button>
      <button type="submit" class="btn-save">Güncelle</button>
    </div>
  </form>
</dialog>

<script is:inline>
  function openNew() {
    var today = new Date().toISOString().split('T')[0];
    document.getElementById('new-date').value = today;
    calcAmount();
    document.getElementById('dlg-new').showModal();
  }

  function updateHourlyRate(sel) {
    var rate = sel.options[sel.selectedIndex].dataset.rate || 0;
    document.getElementById('new-rate').value = rate;
    calcAmount();
  }

  function calcAmount() {
    var hours    = parseFloat(document.querySelector('[name="hours"]')?.value || 0);
    var rate     = parseFloat(document.getElementById('new-rate')?.value || 0);
    var billable = document.getElementById('new-billable')?.value === '1';
    var amt      = billable ? hours * rate : 0;
    document.getElementById('calc-amount').value = amt.toLocaleString('tr-TR', { minimumFractionDigits:2 }) + ' ₺';
  }

  function openEdit(e) {
    document.getElementById('edit-id').value       = e.id;
    document.getElementById('edit-hours').value    = e.hours;
    document.getElementById('edit-desc').value     = e.description ?? '';
    document.getElementById('edit-billable').value = String(e.isBillable ?? 1);
    document.getElementById('edit-date').value     = e.entryDate ? new Date(e.entryDate).toISOString().split('T')[0] : '';
    document.getElementById('dlg-edit').showModal();
  }
</script>
</AdminLayout>
