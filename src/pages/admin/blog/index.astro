---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { listPosts } from '../../../lib/blogFs';

const filter = Astro.url.searchParams.get('filter') ?? 'tumu';
const saved  = Astro.url.searchParams.get('saved') === '1';
const deleted = Astro.url.searchParams.get('deleted') === '1';

let posts = listPosts();
const counts = {
  tumu:     posts.length,
  yayinda:  posts.filter(p => !p.fm.draft).length,
  taslak:   posts.filter(p =>  p.fm.draft).length,
};
if (filter === 'yayinda') posts = posts.filter(p => !p.fm.draft);
if (filter === 'taslak')  posts = posts.filter(p =>  p.fm.draft);

function fmt(d: string) {
  return new Date(d).toLocaleDateString('tr-TR', { day:'2-digit', month:'short', year:'numeric' });
}
---

<AdminLayout title="Blog Yazıları" section="blog">

<style>
  .page-header { display:flex; align-items:center; justify-content:space-between; margin-bottom:1.75rem; gap:1rem; flex-wrap:wrap; }
  .page-title  { font-size:1.25rem; font-weight:700; color:var(--adm-text); }
  .page-sub    { font-size:0.8125rem; color:var(--adm-muted); margin-top:0.2rem; }

  .btn-new {
    display:inline-flex; align-items:center; gap:0.5rem;
    padding:0.5rem 1rem; border-radius:0.625rem;
    background:var(--adm-gold); color:#0b0a09;
    font-size:0.8125rem; font-weight:600; cursor:pointer; border:none;
    text-decoration:none; transition:background 150ms;
  }
  .btn-new:hover { background:var(--adm-gold-b); }

  .toast {
    display:flex; align-items:center; gap:0.625rem; padding:0.75rem 1rem;
    border-radius:0.625rem; margin-bottom:1.25rem;
    font-size:0.875rem; font-weight:500; animation:fadein .3s ease;
  }
  .toast-green { background:rgba(74,222,128,0.10); border:1px solid rgba(74,222,128,0.22); color:rgba(74,222,128,0.9); }
  .toast-red   { background:rgba(248,113,113,0.10); border:1px solid rgba(248,113,113,0.22); color:rgba(248,113,113,0.9); }
  @keyframes fadein { from { opacity:0; transform:translateY(-6px); } to { opacity:1; transform:translateY(0); } }

  .filter-bar  { display:flex; gap:0.375rem; flex-wrap:wrap; margin-bottom:1.5rem; }
  .filter-btn  {
    display:inline-flex; align-items:center; gap:0.375rem;
    padding:0.4375rem 0.875rem; border-radius:0.5rem; border:1px solid var(--adm-border);
    font-size:0.8125rem; font-weight:500; color:var(--adm-muted);
    background:transparent; text-decoration:none; transition:all 150ms;
  }
  .filter-btn:hover { color:var(--adm-text); background:rgba(255,255,255,0.04); }
  .filter-btn.active { color:var(--adm-text); background:rgba(217,161,40,0.10); border-color:rgba(217,161,40,0.30); }
  .filter-count { background:rgba(255,255,255,0.08); color:var(--adm-muted); font-size:0.625rem; font-weight:700; padding:0.0625rem 0.375rem; border-radius:9999px; }
  .filter-btn.active .filter-count { background:rgba(217,161,40,0.20); color:var(--adm-gold); }

  .search-wrap { position:relative; margin-bottom:1rem; }
  .search-icon { position:absolute; left:0.75rem; top:50%; transform:translateY(-50%); color:var(--adm-faint); pointer-events:none; }
  .search-input {
    width:100%; padding:0.5625rem 0.75rem 0.5625rem 2.25rem;
    background:var(--adm-card); border:1px solid var(--adm-border); border-radius:0.625rem;
    color:var(--adm-text); font-size:0.875rem; outline:none; transition:border-color 150ms;
  }
  .search-input::placeholder { color:var(--adm-faint); }
  .search-input:focus { border-color:rgba(217,161,40,0.35); }

  .tbl-wrap { overflow-x:auto; border-radius:0.75rem; border:1px solid var(--adm-border); }
  table { width:100%; border-collapse:collapse; font-size:0.875rem; }
  th {
    padding:0.75rem 1rem; text-align:left; font-size:0.6875rem; font-weight:600;
    letter-spacing:0.07em; text-transform:uppercase; color:var(--adm-faint);
    background:var(--adm-card); border-bottom:1px solid var(--adm-border); white-space:nowrap;
  }
  td { padding:0.875rem 1rem; border-bottom:1px solid rgba(161,116,24,0.07); vertical-align:middle; }
  tr:last-child td { border-bottom:none; }
  tr { transition:background 120ms; }
  tr:hover td { background:var(--adm-card-h); }

  .badge { display:inline-flex; align-items:center; gap:.25rem; padding:.1875rem .625rem; border-radius:9999px; font-size:.6875rem; font-weight:600; white-space:nowrap; }
  .badge-green  { background:rgba(74,222,128,0.10); color:rgba(74,222,128,0.9); border:1px solid rgba(74,222,128,0.22); }
  .badge-amber  { background:rgba(251,191,36,0.10); color:rgba(251,191,36,0.9); border:1px solid rgba(251,191,36,0.22); }

  .tag-pill { display:inline-flex; background:rgba(217,161,40,0.10); color:var(--adm-gold); border:1px solid rgba(217,161,40,0.20); border-radius:9999px; font-size:.625rem; font-weight:600; padding:.125rem .5rem; margin:.0625rem; }

  .text-muted { color:var(--adm-muted); font-size:0.8125rem; }
  .text-faint { color:var(--adm-faint); font-size:0.75rem; white-space:nowrap; }

  .actions { display:flex; gap:0.375rem; align-items:center; }
  .act-btn {
    display:inline-flex; align-items:center; gap:0.25rem;
    padding:0.3125rem 0.625rem; border-radius:0.5rem; border:1px solid var(--adm-border);
    font-size:0.75rem; font-weight:500; color:var(--adm-muted);
    background:transparent; cursor:pointer; text-decoration:none; transition:all 120ms; white-space:nowrap;
  }
  .act-btn:hover { color:var(--adm-text); border-color:var(--adm-border-h); background:rgba(255,255,255,0.04); }
  .act-btn.danger:hover { color:var(--adm-red); border-color:rgba(248,113,113,0.28); background:rgba(248,113,113,0.06); }

  .empty { padding:4rem 2rem; text-align:center; color:var(--adm-faint); }
  .empty svg { margin:0 auto 1rem; opacity:.3; display:block; }
</style>

<div class="page-header">
  <div>
    <div class="page-title">Blog Yazıları</div>
    <div class="page-sub">Tüm içerikleri buradan yönetin</div>
  </div>
  <a href="/admin/blog/yeni" class="btn-new">
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
    Yeni Yazı
  </a>
</div>

{saved   && <div class="toast toast-green"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg> Yazı başarıyla kaydedildi.</div>}
{deleted && <div class="toast toast-red"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg> Yazı silindi.</div>}

<!-- Filter -->
<div class="filter-bar">
  {([['tumu','Tümü'], ['yayinda','Yayında'], ['taslak','Taslak']] as [string,string][]).map(([k,l]) => (
    <a href={`?filter=${k}`} class={`filter-btn${filter===k?' active':''}`}>
      {l} <span class="filter-count">{counts[k as keyof typeof counts]}</span>
    </a>
  ))}
</div>

<!-- Search -->
<div class="search-wrap">
  <svg class="search-icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
  <input id="srch" type="text" class="search-input" placeholder="Başlık veya tag ara…"/>
</div>

<!-- Table -->
<div class="tbl-wrap">
  {posts.length === 0 ? (
    <div class="empty">
      <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round">
        <path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/>
      </svg>
      <p>Henüz blog yazısı yok.</p>
    </div>
  ) : (
    <table id="blog-table">
      <thead>
        <tr>
          <th>Durum</th>
          <th>Başlık</th>
          <th>Etiketler</th>
          <th>Yayın Tarihi</th>
          <th>İşlemler</th>
        </tr>
      </thead>
      <tbody>
        {posts.map(p => (
          <tr data-search={`${p.fm.title} ${p.fm.tags.join(' ')}`}>
            <td>
              {p.fm.draft
                ? <span class="badge badge-amber">Taslak</span>
                : <span class="badge badge-green">Yayında</span>
              }
            </td>
            <td>
              <div style="font-weight:500; color:var(--adm-text)">{p.fm.title}</div>
              <div class="text-faint" style="margin-top:.125rem">{p.slug}</div>
            </td>
            <td>
              <div style="display:flex;flex-wrap:wrap;gap:.125rem">
                {p.fm.tags.map(t => <span class="tag-pill">{t}</span>)}
              </div>
            </td>
            <td class="text-faint">{fmt(p.fm.publishDate)}</td>
            <td>
              <div class="actions">
                <a href={`/admin/blog/${p.slug}`} class="act-btn">
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                  Düzenle
                </a>
                <a href={`/blog/${p.slug}`} target="_blank" class="act-btn">
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
                  Görüntüle
                </a>
                <form method="post" action="/api/admin/blog-delete" onsubmit="return confirm('Bu yazı kalıcı olarak silinecek. Emin misiniz?')">
                  <input type="hidden" name="slug" value={p.slug}/>
                  <button type="submit" class="act-btn danger">Sil</button>
                </form>
              </div>
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  )}
</div>

<script is:inline>
document.getElementById('srch').addEventListener('input', function() {
  var q = this.value.toLowerCase();
  document.querySelectorAll('#blog-table tbody tr').forEach(function(tr) {
    tr.style.display = tr.dataset.search.toLowerCase().includes(q) ? '' : 'none';
  });
});
</script>

</AdminLayout>
