---
const currentYear = new Date().getFullYear();
---
<footer
  class="mt-auto"
  style="
    background-image: linear-gradient(rgba(5,5,9,0.82), rgba(5,5,9,0.82)), url('/arkaplan.png');
    background-size: cover;
    background-position: center center;
    border-top: 1px solid rgba(212,168,70,0.28);
  "
>
  <div class="site-container py-12">
    <div class="grid grid-cols-1 gap-8 md:grid-cols-4">

      <!-- Brand -->
      <div class="md:col-span-1">
        <a href="/" class="inline-block" aria-label="AKA Software Ana Sayfa">
          <img
            src="/ana_logo.png"
            alt="AKA Software"
            height="52"
            width="182"
            class="w-auto object-contain"
            style="height: 52px; max-width: 220px;"
            loading="lazy"
            decoding="async"
          />
        </a>
        <p class="mt-4 text-sm leading-relaxed" style="color: rgba(255,255,255,0.42);">
          AI ve modern yazilim teknolojileriyle isletmenizin dijital donusumune rehberlik ediyoruz.
        </p>
      </div>

      <!-- Links -->
      <div>
        <h3 class="text-sm font-semibold mb-4" style="color: rgba(255,255,255,0.82);">Hizmetler</h3>
        <ul class="space-y-2 text-sm">
          <li><a href="/hizmetler" class="transition-colors duration-150 hover:underline" style="color: rgba(255,255,255,0.48);">Hizmetler</a></li>
          <li><a href="/vaka-calismalari" class="transition-colors duration-150 hover:underline" style="color: rgba(255,255,255,0.48);">Vaka Calismalari</a></li>
          <li><a href="/blog" class="transition-colors duration-150 hover:underline" style="color: rgba(255,255,255,0.48);">Blog</a></li>
          <li><a href="/hakkimizda" class="transition-colors duration-150 hover:underline" style="color: rgba(255,255,255,0.48);">Hakkimizda</a></li>
        </ul>
      </div>

      <!-- Legal -->
      <div>
        <h3 class="text-sm font-semibold mb-4" style="color: rgba(255,255,255,0.82);">Yasal</h3>
        <ul class="space-y-2 text-sm">
          <li><a href="/gizlilik" class="transition-colors duration-150 hover:underline" style="color: rgba(255,255,255,0.48);">Gizlilik Politikasi</a></li>
          <li><a href="/kullanim-sartlari" class="transition-colors duration-150 hover:underline" style="color: rgba(255,255,255,0.48);">Kullanim Sartlari</a></li>
          <li><a href="/sss" class="transition-colors duration-150 hover:underline" style="color: rgba(255,255,255,0.48);">SSS</a></li>
        </ul>
      </div>

      <!-- Contact -->
      <div>
        <h3 class="text-sm font-semibold mb-4" style="color: rgba(255,255,255,0.82);">Iletisim</h3>
        <address class="text-sm not-italic space-y-2" style="color: rgba(255,255,255,0.48);">
          <p>Ahmet Fatih Kahya</p>
          <p><a href="mailto:info@akasoftware.com" class="hover:underline" style="color: rgb(212,168,70);">info@akasoftware.com</a></p>
        </address>
      </div>
    </div>

    <div class="mt-10 pt-6 border-t flex flex-col sm:flex-row items-center justify-between gap-3 text-xs" style="border-color: rgba(255,255,255,0.08); color: rgba(255,255,255,0.3);">
      <span>&copy; {currentYear} AKA Software. Tum haklari saklidir.</span>
      <span>AI ve Yazilim Danismanligi</span>
    </div>
  </div>
</footer>
