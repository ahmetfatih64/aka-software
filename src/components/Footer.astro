---
const currentYear = new Date().getFullYear();
---

<footer class="site-footer mt-auto">

  <!-- Top gradient separator — connects to page content above -->
  <div class="footer-fade-in" aria-hidden="true"></div>

  <!-- Main footer body -->
  <div class="footer-body">
    <div class="site-container">

      <!-- ═══ Top rule with gold bloom ════════════════════════ -->
      <div class="footer-rule" aria-hidden="true"></div>

      <!-- ═══ Main grid ════════════════════════════════════════ -->
      <div class="footer-grid">

        <!-- Brand column -->
        <div class="footer-brand">
          <a href="/" class="footer-logo-link" aria-label="AKA Software Ana Sayfa" data-i18n-aria="nav.homeAria">
            <img
              src="/ana_logo.png"
              alt="AKA Software"
              height="48"
              width="168"
              class="w-auto object-contain"
              style="height: 48px; max-width: 210px;"
              loading="lazy"
              decoding="async"
            />
          </a>
          <p class="footer-tagline" data-i18n="footer.tagline">
            AI ve modern yazılım teknolojileriyle işletmenizin dijital dönüşümüne rehberlik ediyoruz.
          </p>

          <!-- Gold accent line under tagline -->
          <div class="footer-brand-line" aria-hidden="true"></div>
        </div>

        <!-- Nav columns wrapper -->
        <div class="footer-nav-cols">

          <!-- Hizmetler -->
          <div class="footer-nav-col">
            <h3 class="footer-nav-heading" data-i18n="footer.servicesHeading">Hizmetler</h3>
            <ul class="footer-nav-list">
              <li><a href="/hizmetler"        class="footer-nav-link" data-i18n="nav.services">Hizmetler</a></li>
              <li><a href="/vaka-calismalari" class="footer-nav-link" data-i18n="nav.caseStudies">Vaka Çalışmaları</a></li>
              <li><a href="/blog"             class="footer-nav-link" data-i18n="nav.blog">Blog</a></li>
              <li><a href="/hakkimizda"       class="footer-nav-link" data-i18n="nav.about">Hakkımızda</a></li>
            </ul>
          </div>

          <!-- Yasal -->
          <div class="footer-nav-col">
            <h3 class="footer-nav-heading" data-i18n="footer.legalHeading">Yasal</h3>
            <ul class="footer-nav-list">
              <li><a href="/gizlilik"          class="footer-nav-link" data-i18n="footer.privacy">Gizlilik Politikası</a></li>
              <li><a href="/kullanim-sartlari" class="footer-nav-link" data-i18n="footer.terms">Kullanım Şartları</a></li>
              <li><a href="/sss"               class="footer-nav-link" data-i18n="footer.faq">SSS</a></li>
            </ul>
          </div>

          <!-- İletişim -->
          <div class="footer-nav-col">
            <h3 class="footer-nav-heading" data-i18n="footer.contactHeading">İletişim</h3>
            <address class="footer-address">
              <span class="footer-address-name">Ahmet Fatih Kahya</span>
              <a href="mailto:info@akasoftware.com.tr" class="footer-email">
                info@akasoftware.com.tr
              </a>
            </address>
          </div>

        </div><!-- /footer-nav-cols -->

      </div><!-- /footer-grid -->

      <!-- ═══ Bottom bar ════════════════════════════════════════ -->
      <div class="footer-bottom-rule" aria-hidden="true"></div>
      <div class="footer-bottom">
        <span class="footer-copyright">
          &copy; {currentYear} AKA Software. <span data-i18n="footer.rights">Tüm hakları saklıdır.</span>
        </span>
        <span class="footer-bottom-tag" data-i18n="footer.tag">AI ve Yazılım Danışmanlığı</span>
      </div>

    </div>
  </div>

</footer>

<style>
  /* ════ Footer wrapper ═══════════════════════════════════════ */
  .site-footer {
    position: relative;
  }

  /* Gradient fade connecting page body to footer — smooth transition */
  .footer-fade-in {
    height    : 5rem;
    background: linear-gradient(
      to bottom,
      transparent,
      rgba(14, 11, 10, 0.55)
    );
    pointer-events: none;
  }

  /* Footer body — dark obsidian surface */
  .footer-body {
    background:
      radial-gradient(ellipse 70% 50% at 50% 0%,
        rgba(161, 116, 24, 0.06) 0%, transparent 65%),
      rgba(12, 10, 9, 0.98);
    border-top: 1px solid rgba(161, 116, 24, 0.20);
    padding-top   : 3rem;
    padding-bottom: 2rem;
  }
  @media (min-width: 768px) {
    .footer-body { padding-top: 4rem; padding-bottom: 2.5rem; }
  }

  /* ════ Top rule ═════════════════════════════════════════════ */
  .footer-rule {
    height    : 1px;
    margin-bottom: 3rem;
    background: linear-gradient(
      to right,
      transparent        0%,
      rgba(161,116,24,0.28) 20%,
      rgba(217,161,40,0.38) 50%,
      rgba(161,116,24,0.28) 80%,
      transparent       100%
    );
  }

  /* ════ Main grid ════════════════════════════════════════════ */
  .footer-grid {
    display              : grid;
    grid-template-columns: 1fr;
    gap                  : 2.5rem;
  }
  @media (min-width: 768px) {
    .footer-grid {
      grid-template-columns: 1fr 2fr;
      gap                  : 4rem;
      align-items          : start;
    }
  }

  /* ════ Brand column ═════════════════════════════════════════ */
  .footer-brand {
    display       : flex;
    flex-direction: column;
    gap           : 1rem;
  }

  .footer-logo-link {
    display   : inline-block;
    transition: filter 200ms ease;
  }
  .footer-logo-link:hover {
    filter: drop-shadow(0 0 8px rgba(217, 161, 40, 0.28));
  }
  .footer-logo-link:focus-visible {
    outline       : 2px solid rgba(245, 214, 92, 0.80);
    outline-offset: 3px;
    border-radius : 4px;
  }

  .footer-tagline {
    font-size  : 0.875rem;
    line-height: 1.68;
    color      : rgba(255, 255, 255, 0.38);
    max-width  : 28ch;
  }

  /* Short gold accent line under tagline */
  .footer-brand-line {
    width     : 2rem;
    height    : 1.5px;
    border-radius: 9999px;
    background: linear-gradient(
      to right,
      rgba(217, 161, 40, 0.60),
      rgba(161, 116, 24, 0.30)
    );
  }

  /* ════ Nav columns ══════════════════════════════════════════ */
  .footer-nav-cols {
    display              : grid;
    grid-template-columns: 1fr 1fr;
    gap                  : 2rem;
  }
  @media (min-width: 640px) {
    .footer-nav-cols {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .footer-nav-col {
    display       : flex;
    flex-direction: column;
    gap           : 0.75rem;
  }

  /* Column heading */
  .footer-nav-heading {
    font-size     : 0.6875rem;
    font-weight   : 700;
    letter-spacing: 0.10em;
    text-transform: uppercase;
    color         : rgba(255, 255, 255, 0.55);
    margin-bottom : 0.125rem;
  }

  /* Nav links list */
  .footer-nav-list {
    list-style: none;
    padding   : 0;
    margin    : 0;
    display   : flex;
    flex-direction: column;
    gap       : 0.5rem;
  }

  .footer-nav-link {
    font-size     : 0.875rem;
    color         : rgba(255, 255, 255, 0.40);
    text-decoration: none;
    transition    :
      color        160ms ease,
      padding-left 160ms ease;
    display       : inline-block;
  }
  .footer-nav-link:hover {
    color       : rgba(255, 255, 255, 0.80);
    padding-left: 0.25rem;
  }
  .footer-nav-link:focus-visible {
    outline       : 2px solid rgba(245, 214, 92, 0.70);
    outline-offset: 2px;
    border-radius : 3px;
  }

  /* ════ Address / Contact ════════════════════════════════════ */
  .footer-address {
    display       : flex;
    flex-direction: column;
    gap           : 0.5rem;
    font-style    : normal;
  }

  .footer-address-name {
    font-size  : 0.875rem;
    color      : rgba(255, 255, 255, 0.40);
  }

  .footer-email {
    font-size     : 0.875rem;
    font-weight   : 500;
    color         : rgba(217, 161, 40, 0.80);
    text-decoration: none;
    transition    : color 160ms ease;
  }
  .footer-email:hover { color: rgba(245, 214, 92, 0.90); }
  .footer-email:focus-visible {
    outline       : 2px solid rgba(245, 214, 92, 0.70);
    outline-offset: 2px;
    border-radius : 3px;
  }

  /* ════ Bottom bar ════════════════════════════════════════════ */
  .footer-bottom-rule {
    height     : 1px;
    margin-top : 3rem;
    margin-bottom: 1.25rem;
    background : linear-gradient(
      to right,
      transparent,
      rgba(255, 255, 255, 0.07) 30%,
      rgba(255, 255, 255, 0.07) 70%,
      transparent
    );
  }

  .footer-bottom {
    display        : flex;
    flex-direction : column;
    align-items    : center;
    justify-content: space-between;
    gap            : 0.5rem;
    font-size      : 0.75rem;
  }
  @media (min-width: 640px) {
    .footer-bottom {
      flex-direction: row;
    }
  }

  .footer-copyright {
    color: rgba(255, 255, 255, 0.22);
  }

  .footer-bottom-tag {
    color         : rgba(255, 255, 255, 0.18);
    letter-spacing: 0.04em;
  }
</style>
