---
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'blog'>;
}
const { post } = Astro.props;
const { title, description, publishDate, tags } = post.data;
---
<a
  href={`/blog/${post.slug}`}
  class="post-card card card-hover"
  aria-label={title}
>
  <!-- Top accent line — consistent with svc-card treatment -->
  <div class="post-card-accent" aria-hidden="true"></div>

  <div class="post-card-body">

    <!-- Tags -->
    {tags.length > 0 && (
      <div class="post-tags">
        {tags.map((tag: string, i: number) => (
          <span class="badge badge-gold" data-i18n={`blog.${post.slug}.tag${i}`}>{tag}</span>
        ))}
      </div>
    )}

    <!-- Title -->
    <h3 class="post-title" data-i18n={`blog.${post.slug}.title`}>{title}</h3>

    <!-- Description -->
    <p class="post-desc" data-i18n={`blog.${post.slug}.description`}>{description}</p>

    <!-- Footer: date + read more -->
    <div class="post-footer">
      <time class="post-date" datetime={publishDate.toISOString()} data-i18n-date>
        {publishDate.toLocaleDateString('tr-TR', { year: 'numeric', month: 'long', day: 'numeric' })}
      </time>
      <span class="post-read-more" aria-hidden="true" data-i18n="insights.readMore">
        Devamı
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none"
             stroke="currentColor" stroke-width="2.2"
             stroke-linecap="round" stroke-linejoin="round">
          <path d="M5 12h14M12 5l7 7-7 7"/>
        </svg>
      </span>
    </div>

  </div>
</a>

<style>
  .post-card {
    display       : flex;
    flex-direction: column;
    position      : relative;
    padding       : 1.5rem;
    text-decoration: none;
  }
  .post-card:focus-visible {
    outline       : 2px solid rgb(var(--color-ring));
    outline-offset: 3px;
    border-radius : 1rem;
  }

  /* Top accent line — gold gradient */
  .post-card-accent {
    position  : absolute;
    top       : 0;
    left      : 1.5rem;
    right     : 1.5rem;
    height    : 1px;
    background: linear-gradient(
      to right,
      transparent,
      rgb(var(--color-accent) / 0.35) 30%,
      rgb(var(--color-accent) / 0.45) 50%,
      rgb(var(--color-accent) / 0.35) 70%,
      transparent
    );
  }

  .post-card-body {
    display       : flex;
    flex-direction: column;
    gap           : 0.875rem;
    flex          : 1;
  }

  /* Tags */
  .post-tags {
    display  : flex;
    gap      : 0.375rem;
    flex-wrap: wrap;
  }

  /* Title */
  .post-title {
    font-size     : 1.0625rem;
    font-weight   : 700;
    letter-spacing: -0.016em;
    line-height   : 1.3;
    color         : rgb(var(--color-fg));
    transition    : color 160ms ease;
  }
  .post-card:hover .post-title {
    color: rgb(var(--color-accent));
  }

  /* Description */
  .post-desc {
    font-size  : 0.875rem;
    line-height: 1.72;
    color      : rgb(var(--color-fg-muted));
    flex       : 1;
  }

  /* Footer */
  .post-footer {
    display        : flex;
    align-items    : center;
    justify-content: space-between;
    margin-top     : 0.25rem;
    padding-top    : 0.875rem;
    border-top     : 1px solid rgb(var(--color-border-subtle));
  }

  .post-date {
    font-size : 0.75rem;
    font-weight: 500;
    color     : rgb(var(--color-fg-faint));
  }

  /* "Devamı →" affordance */
  .post-read-more {
    display    : inline-flex;
    align-items: center;
    gap        : 0.3125rem;
    font-size  : 0.75rem;
    font-weight: 600;
    color      : rgb(var(--color-accent) / 0.70);
    transition :
      color       160ms ease,
      gap         160ms ease,
      opacity     160ms ease;
  }
  .post-card:hover .post-read-more {
    color  : rgb(var(--color-accent));
    gap    : 0.4375rem;
  }
</style>
