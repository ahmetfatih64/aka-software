---
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const recent = allPosts
  .sort((a, b) => new Date(b.data.publishDate).getTime() - new Date(a.data.publishDate).getTime())
  .slice(0, 3);

function formatDate(date: string | Date) {
  return new Date(date).toLocaleDateString('tr-TR', {
    year: 'numeric', month: 'long', day: 'numeric'
  });
}
---

{recent.length > 0 && (
<section class="fi-section section-block" id="insights">
  <div class="site-container">

    <!-- Header -->
    <div class="fi-header reveal">
      <p class="section-eyebrow" data-i18n="insights.eyebrow">Teknik İçgörüler</p>
      <h2 class="section-title" data-i18n="insights.title">Blog & Makaleler</h2>
      <p class="section-description" data-i18n="insights.description">
        AI entegrasyonu, yazılım mimarisi ve modern mühendislik üzerine notlar.
      </p>
    </div>

    <!-- Posts grid -->
    <div class="fi-grid">
      {recent.map((post, i) => (
        <a href={`/blog/${post.slug}`} class="fi-card card card-hover reveal-scale" style={`transition-delay:${i * 90}ms`}>

          <!-- Top rule -->
          <div class="fi-card-rule" aria-hidden="true"></div>

          <!-- Tags -->
          {post.data.tags && post.data.tags.length > 0 && (
            <div class="fi-tags">
              {post.data.tags.slice(0, 2).map((tag: string) => (
                <span class="fi-tag">{tag}</span>
              ))}
            </div>
          )}

          <!-- Title -->
          <h3 class="fi-title">{post.data.title}</h3>

          <!-- Description -->
          <p class="fi-desc">{post.data.description}</p>

          <!-- Footer: date + read link -->
          <div class="fi-foot">
            <time class="fi-date" datetime={post.data.publishDate instanceof Date ? post.data.publishDate.toISOString() : String(post.data.publishDate)}>
              {formatDate(post.data.publishDate)}
            </time>
            <span class="fi-read-link" aria-hidden="true" data-i18n="insights.read">
              Oku
              <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M5 12h14M12 5l7 7-7 7"/>
              </svg>
            </span>
          </div>

        </a>
      ))}
    </div>

    <!-- Footer link -->
    <div class="fi-footer reveal">
      <a href="/blog" class="fi-viewall" data-i18n="insights.viewAll">
        Tüm makaleleri gör
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M5 12h14M12 5l7 7-7 7"/>
        </svg>
      </a>
    </div>

  </div>
</section>
)}

<style>
  /* ════ Section ══════════════════════════════════════════════ */
  .fi-section { background: transparent; }

  /* ════ Header ═══════════════════════════════════════════════ */
  .fi-header {
    text-align : center;
    max-width  : 42rem;
    margin     : 0 auto 3rem;
  }

  /* ════ Grid ═════════════════════════════════════════════════ */
  .fi-grid {
    display              : grid;
    grid-template-columns: 1fr;
    gap                  : 1.125rem;
  }
  @media (min-width: 640px) {
    .fi-grid { grid-template-columns: 1fr 1fr; }
  }
  @media (min-width: 1024px) {
    .fi-grid { grid-template-columns: repeat(3, 1fr); }
  }

  /* ════ Card ═════════════════════════════════════════════════ */
  .fi-card {
    display        : flex;
    flex-direction : column;
    gap            : 0.875rem;
    padding        : 1.625rem;
    text-decoration: none;
    color          : inherit;
    background-image: linear-gradient(
      140deg,
      rgb(var(--color-accent) / 0.04) 0%,
      transparent 45%
    );
  }

  /* Top accent rule */
  .fi-card-rule {
    position  : absolute;
    top       : 0;
    left      : 1.5rem;
    right     : 1.5rem;
    height    : 1px;
    background: linear-gradient(
      to right,
      transparent,
      rgb(var(--color-accent) / 0.35) 30%,
      rgb(var(--color-accent) / 0.50) 50%,
      rgb(var(--color-accent) / 0.35) 70%,
      transparent
    );
  }

  /* Tags */
  .fi-tags {
    display  : flex;
    flex-wrap: wrap;
    gap      : 0.3125rem;
  }
  .fi-tag {
    font-size     : 0.5625rem;
    font-weight   : 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color         : rgb(var(--color-accent));
    padding       : 0.1875rem 0.4375rem;
    border-radius : 0.25rem;
    background    : rgb(var(--color-accent) / 0.09);
    border        : 1px solid rgb(var(--color-accent) / 0.20);
  }

  /* Title */
  .fi-title {
    font-size     : 1rem;
    font-weight   : 700;
    letter-spacing: -0.018em;
    line-height   : 1.35;
    color         : rgb(var(--color-fg));
    flex          : 1;
    transition    : color 200ms ease;
  }
  .fi-card:hover .fi-title { color: rgb(var(--color-accent)); }

  /* Description */
  .fi-desc {
    font-size  : 0.8125rem;
    line-height: 1.72;
    color      : rgb(var(--color-fg-muted));
    /* Clamp to 3 lines */
    display            : -webkit-box;
    -webkit-line-clamp : 3;
    -webkit-box-orient : vertical;
    overflow           : hidden;
  }

  /* Footer row */
  .fi-foot {
    display        : flex;
    align-items    : center;
    justify-content: space-between;
    margin-top     : auto;
    padding-top    : 0.875rem;
    border-top     : 1px solid rgb(var(--color-border) / 0.6);
  }

  .fi-date {
    font-size  : 0.75rem;
    color      : rgb(var(--color-fg-faint));
  }

  .fi-read-link {
    display    : inline-flex;
    align-items: center;
    gap        : 0.3125rem;
    font-size  : 0.75rem;
    font-weight: 600;
    color      : rgb(var(--color-accent));
    transition : gap 200ms var(--ease-spring);
  }
  .fi-card:hover .fi-read-link { gap: 0.5rem; }

  /* ════ Footer ═══════════════════════════════════════════════ */
  .fi-footer {
    display        : flex;
    justify-content: center;
    margin-top     : 2.5rem;
  }
  .fi-viewall {
    display        : inline-flex;
    align-items    : center;
    gap            : 0.5rem;
    font-size      : 0.875rem;
    font-weight    : 600;
    color          : rgb(var(--color-accent));
    text-decoration: none;
    padding        : 0.625rem 1.25rem;
    border-radius  : 0.5rem;
    border         : 1px solid rgb(var(--color-accent) / 0.25);
    background     : rgb(var(--color-accent) / 0.06);
    transition     : background 200ms ease, border-color 200ms ease, gap 200ms var(--ease-spring);
  }
  .fi-viewall:hover {
    background  : rgb(var(--color-accent) / 0.12);
    border-color: rgb(var(--color-accent) / 0.45);
    gap         : 0.75rem;
  }
  .fi-viewall:focus-visible {
    outline       : 2px solid rgb(var(--color-ring));
    outline-offset: 3px;
  }
</style>
