---
interface Props {
  title?: string;
  description?: string;
  buttonText?: string;
  buttonLink?: string;
}
const {
  title = "Projeleriniz için AI destekli çözümler",
  description = "İşletmenizi bir adım öteye taşımak için uzman ekibimizle tanışın.",
  buttonText = "Ücretsiz Keşif Görüşmesi",
  buttonLink = "/iletisim"
} = Astro.props;
---
<section class="section-block">
  <div class="site-container">
    <div
      class="relative overflow-hidden rounded-2xl px-6 py-12 text-center sm:px-10 md:px-16 md:py-16"
      style="background: rgb(var(--color-accent)); box-shadow: 0 20px 60px rgba(0,0,0,0.12);"
    >
      <!-- Decorative dot grid overlay -->
      <div
        aria-hidden="true"
        style="
          position: absolute; inset: 0;
          background-image: radial-gradient(rgb(0 0 0 / 0.12) 1px, transparent 1px);
          background-size: 20px 20px;
          pointer-events: none;
        "
      ></div>
      <!-- Bottom dark fade -->
      <div
        aria-hidden="true"
        style="
          position: absolute; bottom: 0; left: 0; right: 0; height: 40%;
          background: linear-gradient(to top, rgb(0 0 0 / 0.08), transparent);
          pointer-events: none;
        "
      ></div>

      <div class="relative mx-auto max-w-2xl" style="display: flex; flex-direction: column; gap: 1.5rem; align-items: center;">
        <h2 class="text-2xl font-semibold tracking-tight sm:text-3xl" style="color: rgb(var(--color-accent-fg));">
          {title}
        </h2>
        <p class="text-sm leading-relaxed md:text-base" style="color: rgb(var(--color-accent-fg) / 0.8);">
          {description}
        </p>
        <div>
          <a
            href={buttonLink}
            style="
              display: inline-flex;
              align-items: center;
              justify-content: center;
              gap: 0.5rem;
              border-radius: 0.75rem;
              padding: 0.875rem 2rem;
              font-size: 0.9375rem;
              font-weight: 500;
              text-decoration: none;
              transition: transform 200ms ease-out, box-shadow 200ms ease-out;
              background: rgb(var(--color-accent-fg));
              color: rgb(var(--color-accent));
              box-shadow: 0 2px 12px rgba(0,0,0,0.2);
            "
            onmouseover="this.style.transform='translateY(-2px)'; this.style.boxShadow='0 8px 24px rgba(0,0,0,0.25)'"
            onmouseout="this.style.transform=''; this.style.boxShadow='0 2px 12px rgba(0,0,0,0.2)'"
          >
            {buttonText}
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
