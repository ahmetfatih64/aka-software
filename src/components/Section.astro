---
interface Props {
  title?: string;
  description?: string;
  eyebrow?: string;
  class?: string;
  id?: string;
  bg?: 'default' | 'muted';
}
const { title, description, eyebrow, class: className = '', id, bg = 'default' } = Astro.props;
---

<section
  id={id}
  class={`section-block sec-bg-${bg} ${className}`}
>
  <div class="site-container">
    {(title || description || eyebrow) && (
      <div class="sec-header reveal">
        {eyebrow && (
          <div class="sec-eyebrow-wrap">
            <span class="section-eyebrow">{eyebrow}</span>
          </div>
        )}
        {title && <h2 class="section-title">{title}</h2>}
        {description && <p class="section-description mx-auto">{description}</p>}
      </div>
    )}
    <slot />
  </div>
</section>

<style>
  /* ─── Default: transparent — canvas/body bg shows through ─── */
  .sec-bg-default {
    /* inherits body bg */
  }

  /* ─── Muted: feathered-edge surface — fades in/out of page bg ─── */
  .sec-bg-muted {
    position: relative; /* needed for ::before / ::after pseudo-elements */
    background:
      /* Top gold halo — warm glow at section entrance */
      radial-gradient(ellipse 90% 65% at 50% 0%,
        rgb(var(--color-accent) / 0.065) 0%,
        rgb(var(--color-accent) / 0.015) 50%,
        transparent 66%),
      /* Bottom ambient — anchors section, avoids cold cut-off */
      radial-gradient(ellipse 70% 45% at 50% 100%,
        rgb(var(--color-accent) / 0.028) 0%, transparent 56%),
      /* Surface fill: fades from transparent → surface → transparent
         so section "floats" out of the page instead of hard-boxing */
      linear-gradient(
        to bottom,
        transparent                          0%,
        rgb(var(--color-surface) / 0.72)    7%,
        rgb(var(--color-surface) / 0.72)   93%,
        transparent                        100%
      );
  }

  /* Top: feathered gold rule — appears at 7% so it aligns with the fill start */
  .sec-bg-muted::before {
    content   : '';
    position  : absolute;
    top       : 0;
    left      : 0;
    right     : 0;
    /* Tall gradient so the "line" fades in over ~48px, not a hard 1px cut */
    height    : 3rem;
    background: linear-gradient(
      to bottom,
      rgb(var(--color-accent) / 0.00) 0%,
      rgb(var(--color-accent) / 0.22) 40%,
      rgb(var(--color-accent) / 0.30) 50%,
      rgb(var(--color-accent) / 0.10) 70%,
      transparent                    100%
    );
    /* Horizontal mask: bright in center, fades to edges */
    mask-image: linear-gradient(
      to right,
      transparent  0%,
      black       18%,
      black       82%,
      transparent 100%
    );
    -webkit-mask-image: linear-gradient(
      to right,
      transparent  0%,
      black       18%,
      black       82%,
      transparent 100%
    );
    pointer-events: none;
  }

  /* Bottom: mirror of top — gentle dissolve back into page */
  .sec-bg-muted::after {
    content   : '';
    position  : absolute;
    bottom    : 0;
    left      : 0;
    right     : 0;
    height    : 3rem;
    background: linear-gradient(
      to top,
      rgb(var(--color-accent) / 0.00) 0%,
      rgb(var(--color-border-subtle) / 0.60) 40%,
      transparent 100%
    );
    mask-image: linear-gradient(
      to right,
      transparent  0%,
      black       22%,
      black       78%,
      transparent 100%
    );
    -webkit-mask-image: linear-gradient(
      to right,
      transparent  0%,
      black       22%,
      black       78%,
      transparent 100%
    );
    pointer-events: none;
  }

  /* ─── Section header block ─── */
  .sec-header {
    margin-left  : auto;
    margin-right : auto;
    margin-bottom: 3.5rem;
    max-width    : 42rem;
    text-align   : center;
  }

  /* Eyebrow spacing — controls gap between eyebrow badge and section title */
  .sec-eyebrow-wrap {
    margin-bottom: 1.25rem;
    display: flex;
    justify-content: center;
  }
</style>
