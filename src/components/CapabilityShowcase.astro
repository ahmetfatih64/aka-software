---
// No props — content is inline, styled for the design system
---

<section class="cap-section section-block">
  <div class="site-container">

    <!-- Section header -->
    <div class="cap-header reveal">
      <p class="section-eyebrow" data-i18n="capability.eyebrow">Neden AKA Software?</p>
      <h2 class="section-title" data-i18n="capability.title">Teknik Derinlik, Gerçek Teslimat</h2>
      <p class="section-description" data-i18n="capability.description">
        Generic ajans çözümleri değil — AI entegrasyonu, mimari tasarım ve ölçeklenebilir ürün mühendisliğinde odaklanmış uzmanlık.
      </p>
    </div>

    <!-- Capability grid -->
    <div class="cap-grid">

      <!-- 1: AI & LLM -->
      <div class="cap-card card card-hover reveal-scale" style="transition-delay:0ms">
        <div class="cap-card-top">
          <div class="cap-icon" aria-hidden="true">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 2a2 2 0 0 1 2 2v2a2 2 0 0 1-4 0V4a2 2 0 0 1 2-2z"/>
              <path d="M12 16a2 2 0 0 1 2 2v2a2 2 0 0 1-4 0v-2a2 2 0 0 1 2-2z"/>
              <path d="M4.93 4.93a2 2 0 0 1 2.83 0l1.41 1.41a2 2 0 0 1-2.83 2.83L4.93 7.76a2 2 0 0 1 0-2.83z"/>
              <path d="M14.83 14.83a2 2 0 0 1 2.83 0l1.41 1.41a2 2 0 0 1-2.83 2.83l-1.41-1.41a2 2 0 0 1 0-2.83z"/>
              <path d="M2 12a2 2 0 0 1 2-2h2a2 2 0 0 1 0 4H4a2 2 0 0 1-2-2z"/>
              <path d="M16 12a2 2 0 0 1 2-2h2a2 2 0 0 1 0 4h-2a2 2 0 0 1-2-2z"/>
            </svg>
          </div>
          <h3 class="cap-title" data-i18n="capability.card0.title">AI & LLM Sistemleri</h3>
        </div>
        <p class="cap-desc" data-i18n="capability.card0.desc">
          Büyük dil modellerini canlı ürünlere taşıyoruz. RAG mimarisi, streaming, prompt güvenliği ve maliyet optimizasyonu dahil.
        </p>
        <div class="cap-tag" data-i18n="capability.card0.tag">GPT-4o · Claude · Custom Models</div>
      </div>

      <!-- 2: AI Creative Video -->
      <div class="cap-card card card-hover reveal-scale" style="transition-delay:60ms">
        <div class="cap-card-top">
          <div class="cap-icon" aria-hidden="true">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <polygon points="23 7 16 12 23 17 23 7"/>
              <rect x="1" y="5" width="15" height="14" rx="2"/>
            </svg>
          </div>
          <h3 class="cap-title">AI Creative Video</h3>
        </div>
        <p class="cap-desc">
          Yapay zeka ile markanız için etkileyici tanıtım, reklam ve sosyal medya video içerikleri üretiyoruz.
        </p>
        <div class="cap-tag">Sora · Runway · Sosyal Medya</div>
      </div>

      <!-- 3: Modern Product Engineering -->
      <div class="cap-card card card-hover reveal-scale" style="transition-delay:120ms">
        <div class="cap-card-top">
          <div class="cap-icon" aria-hidden="true">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="16 18 22 12 16 6"/>
              <polyline points="8 6 2 12 8 18"/>
            </svg>
          </div>
          <h3 class="cap-title" data-i18n="capability.card1.title">Modern Ürün Mühendisliği</h3>
        </div>
        <p class="cap-desc" data-i18n="capability.card1.desc">
          Astro, Next.js, Node.js ve TypeScript ile hızlı, test edilebilir ve sürdürülebilir kod tabanları inşa ediyoruz.
        </p>
        <div class="cap-tag" data-i18n="capability.card1.tag">Full-Stack · TypeScript · Performance</div>
      </div>

      <!-- 4: B2B & B2C Platformlar -->
      <div class="cap-card card card-hover reveal-scale" style="transition-delay:180ms">
        <div class="cap-card-top">
          <div class="cap-icon" aria-hidden="true">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/>
              <path d="M3 6h18"/>
              <path d="M16 10a4 4 0 0 1-8 0"/>
            </svg>
          </div>
          <h3 class="cap-title">B2B & B2C Platformlar</h3>
        </div>
        <p class="cap-desc">
          E-ticaret, pazar yeri ve dijital ticaret platformları geliştiriyoruz. Ödeme, kargo ve bayi entegrasyonları dahil.
        </p>
        <div class="cap-tag">E-Ticaret · Pazar Yeri · Bayi Portalı</div>
      </div>

      <!-- 5: Müşteri Portalları -->
      <div class="cap-card card card-hover reveal-scale" style="transition-delay:240ms">
        <div class="cap-card-top">
          <div class="cap-icon" aria-hidden="true">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/>
              <circle cx="9" cy="7" r="4"/>
              <path d="M22 21v-2a4 4 0 0 0-3-3.87"/>
              <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
            </svg>
          </div>
          <h3 class="cap-title">Müşteri Portalları</h3>
        </div>
        <p class="cap-desc">
          Self-servis müşteri panelleri ile destek, sipariş takibi ve doküman paylaşımı süreçlerini dijitalleştiriyoruz.
        </p>
        <div class="cap-tag">Self-Servis · Bilet Sistemi · Bildirimler</div>
      </div>

      <!-- 6: CRM Otomasyon & Entegrasyon -->
      <div class="cap-card card card-hover reveal-scale" style="transition-delay:300ms">
        <div class="cap-card-top">
          <div class="cap-icon" aria-hidden="true">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 22c5.523 0 10-4.477 10-10S17.523 2 12 2 2 6.477 2 12s4.477 10 10 10z"/>
              <path d="m9 12 2 2 4-4"/>
              <path d="M21 12a9 9 0 1 1-9-9"/>
              <path d="M22 2 13 11"/>
            </svg>
          </div>
          <h3 class="cap-title">CRM Otomasyon & Entegrasyon</h3>
        </div>
        <p class="cap-desc">
          Satış pipeline, lead yönetimi, e-posta otomasyonu ve ERP/muhasebe entegrasyonları ile süreçleri otomatikleştiriyoruz.
        </p>
        <div class="cap-tag">CRM · Otomasyon · ERP Entegrasyon</div>
      </div>

      <!-- 7: Mimari & Teknik Liderlik -->
      <div class="cap-card card card-hover reveal-scale" style="transition-delay:360ms">
        <div class="cap-card-top">
          <div class="cap-icon" aria-hidden="true">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="3"/>
              <path d="M19.07 4.93a10 10 0 0 1 0 14.14M4.93 4.93a10 10 0 0 0 0 14.14"/>
              <path d="M15.54 8.46a5 5 0 0 1 0 7.07M8.46 8.46a5 5 0 0 0 0 7.07"/>
            </svg>
          </div>
          <h3 class="cap-title" data-i18n="capability.card2.title">Mimari & Teknik Liderlik</h3>
        </div>
        <p class="cap-desc" data-i18n="capability.card2.desc">
          Monolith'ten mikro-servise, bulut geçişinden CTO as a Service'e — teknik stratejinizi birlikte tasarlıyoruz.
        </p>
        <div class="cap-tag" data-i18n="capability.card2.tag">Microservices · Cloud · CTO as a Service</div>
      </div>

      <!-- 8: Güvenlik & Gizlilik -->
      <div class="cap-card card card-hover reveal-scale" style="transition-delay:420ms">
        <div class="cap-card-top">
          <div class="cap-icon" aria-hidden="true">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
            </svg>
          </div>
          <h3 class="cap-title" data-i18n="capability.card3.title">Güvenlik & Gizlilik</h3>
        </div>
        <p class="cap-desc" data-i18n="capability.card3.desc">
          NDA ile çalışıyoruz. GDPR uyumlu veri akışları, prompt injection koruması ve güvenli deployment süreçleri.
        </p>
        <div class="cap-tag" data-i18n="capability.card3.tag">NDA · GDPR · Secure by Design</div>
      </div>

    </div><!-- /cap-grid -->
  </div>
</section>

<style>
  /* ════ Section ══════════════════════════════════════════════ */
  .cap-section {
    /* Subtle top/bottom separation from surrounding sections */
    background: transparent;
  }

  /* ════ Header ═══════════════════════════════════════════════ */
  .cap-header {
    text-align   : center;
    max-width    : 42rem;
    margin       : 0 auto 3.5rem;
  }

  /* ════ Grid ═════════════════════════════════════════════════ */
  .cap-grid {
    display              : grid;
    grid-template-columns: 1fr;
    gap                  : 1.125rem;
  }
  @media (min-width: 600px) {
    .cap-grid { grid-template-columns: 1fr 1fr; }
  }
  @media (min-width: 1024px) {
    .cap-grid { grid-template-columns: repeat(4, 1fr); }
  }

  /* ════ Card ═════════════════════════════════════════════════ */
  .cap-card {
    display       : flex;
    flex-direction: column;
    gap           : 1rem;
    padding       : 1.625rem;
    /* Diagonal accent background */
    background-image: linear-gradient(
      145deg,
      rgb(var(--color-accent) / 0.04) 0%,
      transparent 40%
    );
    transition: transform 220ms cubic-bezier(0.22, 1, 0.36, 1),
                box-shadow 220ms ease;
  }

  /* Top-edge gold rule */
  .cap-card::before {
    content  : '';
    position : absolute;
    top      : 0;
    left     : 1.5rem;
    right    : 1.5rem;
    height   : 1px;
    background: linear-gradient(
      to right,
      transparent,
      rgb(var(--color-accent) / 0.40) 30%,
      rgb(var(--color-accent) / 0.55) 50%,
      rgb(var(--color-accent) / 0.40) 70%,
      transparent
    );
  }

  .cap-card-top {
    display    : flex;
    align-items: center;
    gap        : 0.875rem;
  }

  /* ── Icon ── */
  .cap-icon {
    display        : inline-flex;
    align-items    : center;
    justify-content: center;
    width          : 2.625rem;
    height         : 2.625rem;
    border-radius  : 0.75rem;
    flex-shrink    : 0;
    background     : rgb(var(--color-accent) / 0.10);
    color          : rgb(var(--color-accent));
    border         : 1px solid rgb(var(--color-accent) / 0.22);
    box-shadow     : 0 0 12px rgb(var(--color-glow) / 0.12);
    /* Subtle glow on hover (parent triggers) */
    transition     : box-shadow 220ms ease, background 220ms ease;
  }
  .cap-card:hover .cap-icon {
    background: rgb(var(--color-accent) / 0.15);
    box-shadow: 0 0 20px rgb(var(--color-glow) / 0.22);
  }

  /* ── Title ── */
  .cap-title {
    font-size     : 1rem;
    font-weight   : 700;
    letter-spacing: -0.016em;
    line-height   : 1.28;
    color         : rgb(var(--color-fg));
  }

  /* ── Description ── */
  .cap-desc {
    font-size  : 0.875rem;
    line-height: 1.74;
    color      : rgb(var(--color-fg-muted));
    flex       : 1;
  }

  /* ── Capability tag ── */
  .cap-tag {
    display        : inline-flex;
    align-items    : center;
    font-size      : 0.6875rem;
    font-weight    : 600;
    letter-spacing : 0.02em;
    color          : rgb(var(--color-accent) / 0.75);
    padding        : 0.3125rem 0.625rem;
    border-radius  : 0.375rem;
    background     : rgb(var(--color-accent) / 0.07);
    border         : 1px solid rgb(var(--color-accent) / 0.15);
    white-space    : nowrap;
    width          : fit-content;
    margin-top     : auto;
  }
</style>
