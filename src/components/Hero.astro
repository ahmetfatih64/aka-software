---
interface Props {
  title: string;
  description: string;
  primaryCtaText?: string;
  primaryCtaLink?: string;
  secondaryCtaText?: string;
  secondaryCtaLink?: string;
}
const { title, description, primaryCtaText, primaryCtaLink, secondaryCtaText, secondaryCtaLink } = Astro.props;
---
<section class="relative pt-32 pb-20 md:pt-40 md:pb-28 overflow-hidden">

  <!-- Background: gold radial glow — crystal facet texture comes from body -->
  <div
    class="absolute inset-0 -z-10 pointer-events-none"
    aria-hidden="true"
    style="background: radial-gradient(ellipse at 50% -5%, rgb(var(--color-accent) / 0.11) 0%, transparent 58%);"
  ></div>

  <div class="site-container relative z-10">
    <div class="mx-auto max-w-3xl text-center" style="display: flex; flex-direction: column; gap: 1.75rem; align-items: center;">

      <!-- Eyebrow pill -->
      <div>
        <span
          class="inline-flex items-center gap-2 rounded-full border text-xs font-medium"
          style="
            padding: 0.375rem 1rem;
            border-color: rgb(var(--color-accent) / 0.35);
            background: rgb(var(--color-accent) / 0.07);
            color: rgb(var(--color-accent));
          "
        >
          <span class="h-1.5 w-1.5 rounded-full" style="background: rgb(var(--color-accent)); flex-shrink: 0;"></span>
          AI destekli yazılım danışmanlığı
        </span>
      </div>

      <!-- Headline -->
      <h1
        class="text-4xl font-semibold sm:text-5xl md:text-[3.5rem]"
        style="color: rgb(var(--color-fg)); letter-spacing: -0.03em; line-height: 1.06;"
      >
        {title}
      </h1>

      <!-- Description -->
      <p class="max-w-2xl text-base leading-relaxed md:text-lg" style="color: rgb(var(--color-fg-muted));">
        {description}
      </p>

      <!-- CTAs -->
      <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-center">
        {primaryCtaText && primaryCtaLink && (
          <a href={primaryCtaLink} class="btn-primary" style="padding: 0.875rem 2rem; font-size: 0.9375rem;">
            {primaryCtaText}
          </a>
        )}
        {secondaryCtaText && secondaryCtaLink && (
          <a href={secondaryCtaLink} class="btn-secondary" style="padding: 0.875rem 2rem; font-size: 0.9375rem;">
            {secondaryCtaText}
          </a>
        )}
      </div>

      <!-- Trust signals -->
      <div class="flex flex-wrap items-center justify-center gap-x-5 gap-y-2 text-xs" style="color: rgb(var(--color-fg-faint));">
        <div class="flex items-center gap-2">
          <span class="flex h-6 min-w-[1.5rem] px-1.5 items-center justify-center rounded-md text-[0.6rem] font-semibold" style="background: rgb(var(--color-accent) / 0.12); color: rgb(var(--color-accent));">24s</span>
          Ortalama ilk dönüş
        </div>
        <span class="h-3.5 w-px" style="background: rgb(var(--color-border));"></span>
        <div class="flex items-center gap-2">
          <span class="flex h-6 min-w-[1.5rem] px-1.5 items-center justify-center rounded-md text-[0.6rem] font-semibold" style="background: rgb(var(--color-accent) / 0.12); color: rgb(var(--color-accent));">NDA</span>
          Gizlilik odaklı
        </div>
      </div>
    </div>
  </div>
</section>
