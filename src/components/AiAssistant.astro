---
// AKA AI Assistant — floating chat widget
---

<!-- ── Floating toggle button ── -->
<button
  id="ai-btn"
  aria-label="AKA AI Asistan"
  aria-expanded="false"
  aria-controls="ai-panel"
>
  <span class="ai-btn-ring" aria-hidden="true"></span>
  <img src="/aka_aiAsistan.png" alt="AKA AI Asistan" class="ai-btn-img" draggable="false"/>
  <span class="ai-btn-badge" id="ai-badge" aria-hidden="true"></span>
</button>

<!-- ── Chat panel ── -->
<div id="ai-panel" role="dialog" aria-label="AKA AI Asistan" aria-modal="true" hidden>

  <header class="ai-head">
    <div class="ai-head-info">
      <img src="/aka_aiAsistan.png" alt="" class="ai-head-avatar" aria-hidden="true"/>
      <div>
        <div class="ai-head-name">AKA AI Asistan</div>
        <div class="ai-head-status" id="ai-status">
          <span class="ai-dot"></span> Çevrimiçi
        </div>
      </div>
    </div>
    <button class="ai-close" id="ai-close" aria-label="Kapat">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
      </svg>
    </button>
  </header>

  <div class="ai-messages" id="ai-messages" role="log" aria-live="polite" aria-label="Sohbet mesajları">
    <!-- Welcome message -->
    <div class="ai-msg ai-msg--bot">
      <img src="/aka_aiAsistan.png" alt="" class="ai-msg-avatar" aria-hidden="true"/>
      <div class="ai-msg-bubble">
        Merhaba! Ben AKA AI Asistan. Size AKA Software'in hizmetleri hakkında yardımcı olmaktan mutluluk duyarım. Nasıl yardımcı olabilirim?
      </div>
    </div>
  </div>

  <form class="ai-form" id="ai-form" autocomplete="off">
    <input
      type="text"
      id="ai-input"
      class="ai-input"
      placeholder="Mesajınızı yazın…"
      maxlength="500"
      aria-label="Mesaj girin"
      autocomplete="off"
    />
    <button type="submit" class="ai-send" id="ai-send" aria-label="Gönder">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/>
      </svg>
    </button>
  </form>
</div>

<style>
  /* ─── CSS Variables (inherited from :root or standalone) ─── */
  :root {
    --ai-gold    : rgb(217,161,40);
    --ai-gold-b  : rgb(245,214,92);
    --ai-bg      : #0c0b09;
    --ai-card    : #131109;
    --ai-border  : rgba(161,116,24,0.22);
    --ai-border-h: rgba(161,116,24,0.40);
    --ai-text    : rgba(242,236,224,0.92);
    --ai-muted   : rgba(178,164,144,0.72);
    --ai-faint   : rgba(120,110,90,0.55);
  }

  /* ─── Toggle button ─── */
  #ai-btn {
    position: fixed;
    bottom: 1.75rem;
    right: 1.75rem;
    z-index: 9990;
    width: 62px;
    height: 62px;
    border-radius: 9999px;
    border: none;
    background: transparent;
    cursor: pointer;
    padding: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    -webkit-tap-highlight-color: transparent;
  }

  .ai-btn-img {
    width: 62px;
    height: 62px;
    border-radius: 9999px;
    object-fit: cover;
    display: block;
    position: relative;
    z-index: 2;
    transition: transform 280ms cubic-bezier(0.34,1.56,0.64,1);
    box-shadow: 0 0 0 2px rgba(217,161,40,0.35), 0 4px 20px rgba(0,0,0,0.55);
  }
  #ai-btn:hover .ai-btn-img { transform: scale(1.07); }

  .ai-btn-ring {
    position: absolute;
    inset: -5px;
    border-radius: 9999px;
    border: 1.5px solid rgba(217,161,40,0.50);
    animation: aiRingPulse 2.8s ease-in-out infinite;
    pointer-events: none;
  }
  @keyframes aiRingPulse {
    0%,100% { opacity:0.5; transform:scale(1); }
    50%      { opacity:1;   transform:scale(1.06); }
  }

  /* Unread badge */
  .ai-btn-badge {
    position: absolute;
    top: 2px; right: 2px;
    width: 12px; height: 12px;
    border-radius: 9999px;
    background: var(--ai-gold);
    border: 2px solid #0c0b09;
    display: none;
    z-index: 3;
  }
  .ai-btn-badge.show { display: block; }

  /* ─── Panel ─── */
  #ai-panel {
    position: fixed;
    bottom: 6.25rem;
    right: 1.75rem;
    z-index: 9991;
    width: 370px;
    max-width: calc(100vw - 2rem);
    height: 520px;
    max-height: calc(100dvh - 8rem);
    background: var(--ai-bg);
    border: 1px solid var(--ai-border);
    border-radius: 1.25rem;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    box-shadow: 0 24px 64px rgba(0,0,0,0.70), 0 0 0 1px rgba(217,161,40,0.08);
    transform-origin: bottom right;
    transition: transform 260ms cubic-bezier(0.22,1,0.36,1), opacity 260ms ease;
  }

  #ai-panel[hidden] {
    display: flex !important; /* override hidden so we can animate */
    opacity: 0;
    transform: scale(0.88) translateY(16px);
    pointer-events: none;
    visibility: hidden;
  }

  #ai-panel.open {
    opacity: 1;
    transform: scale(1) translateY(0);
    pointer-events: auto;
    visibility: visible;
  }

  /* ─── Header ─── */
  .ai-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.875rem 1rem 0.875rem 1rem;
    border-bottom: 1px solid var(--ai-border);
    background: rgba(217,161,40,0.04);
    flex-shrink: 0;
  }
  .ai-head-info { display:flex; align-items:center; gap:0.625rem; }
  .ai-head-avatar {
    width: 36px; height: 36px; border-radius: 9999px;
    object-fit: cover; border: 1px solid rgba(217,161,40,0.30);
    flex-shrink: 0;
  }
  .ai-head-name { font-size:0.9rem; font-weight:700; color:var(--ai-text); font-family:'Inter',system-ui,sans-serif; }
  .ai-head-status { display:flex; align-items:center; gap:0.3rem; font-size:0.6875rem; color:var(--ai-muted); font-family:'Inter',system-ui,sans-serif; }
  .ai-dot {
    width: 6px; height: 6px; border-radius: 9999px;
    background: rgba(74,222,128,0.85);
    animation: aiDotPulse 2s ease-in-out infinite;
  }
  @keyframes aiDotPulse {
    0%,100% { opacity:0.7; } 50% { opacity:1; }
  }
  .ai-close {
    display: flex; align-items:center; justify-content:center;
    width: 2rem; height: 2rem; border-radius: 0.5rem; border: 1px solid var(--ai-border);
    background: transparent; color: var(--ai-muted); cursor: pointer;
    transition: color 150ms, border-color 150ms, background 150ms;
  }
  .ai-close:hover { color:var(--ai-text); border-color:var(--ai-border-h); background:rgba(255,255,255,0.04); }

  /* ─── Messages ─── */
  .ai-messages {
    flex: 1;
    overflow-y: auto;
    padding: 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
    scroll-behavior: smooth;
  }
  .ai-messages::-webkit-scrollbar { width: 3px; }
  .ai-messages::-webkit-scrollbar-track { background: transparent; }
  .ai-messages::-webkit-scrollbar-thumb { background: rgba(161,116,24,0.25); border-radius:9999px; }

  .ai-msg { display:flex; gap:0.5rem; align-items:flex-end; }
  .ai-msg--user { flex-direction: row-reverse; }

  .ai-msg-avatar {
    width: 26px; height: 26px; border-radius: 9999px;
    object-fit: cover; flex-shrink: 0;
    border: 1px solid rgba(217,161,40,0.25);
  }

  .ai-msg-bubble {
    max-width: 82%;
    padding: 0.625rem 0.875rem;
    border-radius: 1rem;
    font-size: 0.875rem;
    line-height: 1.55;
    font-family: 'Inter', system-ui, sans-serif;
  }

  .ai-msg--bot .ai-msg-bubble {
    background: rgba(255,255,255,0.05);
    border: 1px solid var(--ai-border);
    color: var(--ai-text);
    border-bottom-left-radius: 0.25rem;
  }
  .ai-msg--user .ai-msg-bubble {
    background: rgba(217,161,40,0.14);
    border: 1px solid rgba(217,161,40,0.25);
    color: var(--ai-text);
    border-bottom-right-radius: 0.25rem;
  }

  /* Typing indicator */
  .ai-typing .ai-msg-bubble {
    display: flex; align-items: center; gap: 4px;
    padding: 0.75rem 1rem;
  }
  .ai-typing-dot {
    width: 5px; height: 5px; border-radius: 9999px;
    background: var(--ai-muted);
    animation: aiTypingBounce 1.2s ease-in-out infinite;
  }
  .ai-typing-dot:nth-child(2) { animation-delay: 0.18s; }
  .ai-typing-dot:nth-child(3) { animation-delay: 0.36s; }
  @keyframes aiTypingBounce {
    0%,60%,100% { transform:translateY(0); opacity:.5; }
    30%          { transform:translateY(-5px); opacity:1; }
  }

  /* Error bubble */
  .ai-msg-bubble.error {
    background: rgba(248,113,113,0.08);
    border-color: rgba(248,113,113,0.22);
    color: rgba(248,113,113,0.88);
  }

  /* ─── Input form ─── */
  .ai-form {
    display: flex;
    gap: 0.5rem;
    padding: 0.75rem 1rem;
    border-top: 1px solid var(--ai-border);
    background: rgba(255,255,255,0.015);
    flex-shrink: 0;
  }
  .ai-input {
    flex: 1;
    padding: 0.5625rem 0.875rem;
    background: rgba(255,255,255,0.06);
    border: 1px solid var(--ai-border);
    border-radius: 0.75rem;
    color: var(--ai-text);
    font-size: 0.875rem;
    font-family: 'Inter', system-ui, sans-serif;
    outline: none;
    transition: border-color 150ms;
    min-width: 0;
  }
  .ai-input::placeholder { color: var(--ai-faint); }
  .ai-input:focus { border-color: rgba(217,161,40,0.45); }

  .ai-send {
    width: 2.5rem; height: 2.5rem;
    border-radius: 0.75rem;
    background: var(--ai-gold);
    border: none;
    color: #0b0a09;
    cursor: pointer;
    display: flex; align-items: center; justify-content: center;
    flex-shrink: 0;
    transition: background 150ms, transform 120ms;
  }
  .ai-send:hover { background: var(--ai-gold-b); }
  .ai-send:active { transform: scale(0.94); }
  .ai-send:disabled { opacity: 0.45; cursor: not-allowed; }

  /* ─── Mobile ─── */
  @media (max-width: 480px) {
    #ai-btn { bottom: 1.25rem; right: 1.25rem; }
    #ai-panel { right: 0.75rem; bottom: 5.5rem; width: calc(100vw - 1.5rem); }
  }
</style>

<script is:inline>
(function () {
  'use strict';

  var btn      = document.getElementById('ai-btn');
  var panel    = document.getElementById('ai-panel');
  var closeBtn = document.getElementById('ai-close');
  var form     = document.getElementById('ai-form');
  var input    = document.getElementById('ai-input');
  var messages = document.getElementById('ai-messages');
  var badge    = document.getElementById('ai-badge');
  var isOpen   = false;
  var isLoading = false;

  // Conversation history for context
  var history = [];

  function openPanel() {
    isOpen = true;
    panel.classList.add('open');
    btn.setAttribute('aria-expanded', 'true');
    badge.classList.remove('show');
    setTimeout(function() { input.focus(); }, 280);
    scrollBottom();
  }

  function closePanel() {
    isOpen = false;
    panel.classList.remove('open');
    btn.setAttribute('aria-expanded', 'false');
  }

  btn.addEventListener('click', function() {
    isOpen ? closePanel() : openPanel();
  });
  closeBtn.addEventListener('click', closePanel);

  // Close on Escape
  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape' && isOpen) closePanel();
  });

  function scrollBottom() {
    setTimeout(function() {
      messages.scrollTop = messages.scrollHeight;
    }, 40);
  }

  function addMsg(role, text, typing) {
    var msg = document.createElement('div');
    msg.className = 'ai-msg ai-msg--' + (role === 'user' ? 'user' : 'bot');
    if (typing) msg.className += ' ai-typing';

    var parts = [];

    if (role === 'bot') {
      parts.push('<img src="/aka_aiAsistan.png" alt="" class="ai-msg-avatar" aria-hidden="true"/>');
    }

    var bubble = document.createElement('div');
    bubble.className = 'ai-msg-bubble';

    if (typing) {
      bubble.innerHTML = '<span class="ai-typing-dot"></span><span class="ai-typing-dot"></span><span class="ai-typing-dot"></span>';
    } else {
      bubble.textContent = text;
    }

    if (role === 'bot') {
      msg.innerHTML = parts.join('');
      msg.appendChild(bubble);
    } else {
      msg.appendChild(bubble);
    }

    messages.appendChild(msg);
    scrollBottom();
    return bubble;
  }

  function addError(text) {
    var msg = document.createElement('div');
    msg.className = 'ai-msg ai-msg--bot';
    msg.innerHTML = '<img src="/aka_aiAsistan.png" alt="" class="ai-msg-avatar" aria-hidden="true"/>';
    var bubble = document.createElement('div');
    bubble.className = 'ai-msg-bubble error';
    bubble.textContent = text;
    msg.appendChild(bubble);
    messages.appendChild(msg);
    scrollBottom();
  }

  function setLoading(v) {
    isLoading = v;
    document.getElementById('ai-send').disabled = v;
    input.disabled = v;
  }

  form.addEventListener('submit', function(e) {
    e.preventDefault();
    var text = input.value.trim();
    if (!text || isLoading) return;

    input.value = '';
    addMsg('user', text);

    // Add to history
    history.push({ role: 'user', content: text });

    setLoading(true);

    // Show typing indicator
    var typingMsg = document.createElement('div');
    typingMsg.className = 'ai-msg ai-msg--bot ai-typing';
    typingMsg.innerHTML = '<img src="/aka_aiAsistan.png" alt="" class="ai-msg-avatar" aria-hidden="true"/><div class="ai-msg-bubble"><span class="ai-typing-dot"></span><span class="ai-typing-dot"></span><span class="ai-typing-dot"></span></div>';
    messages.appendChild(typingMsg);
    scrollBottom();

    // SSE streaming
    fetch('/api/chat', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ message: text, history: history.slice(-10) }),
    })
    .then(function(res) {
      if (!res.ok) throw new Error('Sunucu hatası: ' + res.status);

      // Replace typing indicator with real bubble
      messages.removeChild(typingMsg);
      var bubble = addMsg('bot', '');
      var fullText = '';

      var reader = res.body.getReader();
      var decoder = new TextDecoder();
      var buffer = '';

      function read() {
        return reader.read().then(function(result) {
          if (result.done) {
            setLoading(false);
            history.push({ role: 'assistant', content: fullText });

            // Show badge if panel is closed
            if (!isOpen) badge.classList.add('show');
            return;
          }

          buffer += decoder.decode(result.value, { stream: true });
          var lines = buffer.split('\n');
          buffer = lines.pop();

          for (var i = 0; i < lines.length; i++) {
            var line = lines[i];
            if (!line.startsWith('data: ')) continue;
            var raw = line.slice(6);
            if (raw === '[DONE]') continue;
            try {
              var parsed = JSON.parse(raw);
              if (parsed.error) {
                bubble.textContent = parsed.error;
                bubble.classList.add('error');
                return;
              }
              if (parsed.text) {
                fullText += parsed.text;
                bubble.textContent = fullText;
                scrollBottom();
              }
            } catch (_) {}
          }

          return read();
        });
      }

      return read();
    })
    .catch(function(err) {
      if (typingMsg.parentNode) messages.removeChild(typingMsg);
      addError('Bağlantı hatası. Lütfen tekrar deneyin.');
      setLoading(false);
      console.error('AI chat error:', err);
    });
  });

  // Enter key sends (Shift+Enter for newline if we ever switch to textarea)
  input.addEventListener('keydown', function(e) {
    if (e.key === 'Enter' && !e.shiftKey) {
      e.preventDefault();
      form.dispatchEvent(new Event('submit'));
    }
  });

}());
</script>
