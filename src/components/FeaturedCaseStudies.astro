---
import { getCollection } from 'astro:content';

const allStudies = await getCollection('case-studies', ({ data }) => !data.draft);
// Show up to 2 featured studies, sorted by publishDate desc
const featured = allStudies
  .sort((a, b) => new Date(b.data.publishDate).getTime() - new Date(a.data.publishDate).getTime())
  .slice(0, 2);
---

{featured.length > 0 && (
<section class="fcs-section section-block" id="vaka-calismalari-onizleme">
  <div class="site-container">

    <!-- Header -->
    <div class="fcs-header reveal">
      <p class="section-eyebrow" data-i18n="caseStudies.eyebrow">Kanıtlanmış Sonuçlar</p>
      <h2 class="section-title" data-i18n="caseStudies.title">Gerçek Projeler, Ölçülebilir Çıktılar</h2>
      <p class="section-description" data-i18n="caseStudies.description">
        NDA kapsamında çalıştığımız bazı projelerde elde ettiğimiz somut sonuçlar.
      </p>
    </div>

    <!-- Case study cards -->
    <div class="fcs-grid">
      {featured.map((study, i) => (
        <a href={`/vaka-calismalari/${study.slug}`} class={`fcs-card card card-hover reveal-scale fcs-card--${i === 0 ? 'primary' : 'secondary'}`} style={`transition-delay:${i * 120}ms`}>

          <!-- Top rule -->
          <div class="fcs-card-rule" aria-hidden="true"></div>

          <!-- Industry badge -->
          <div class="fcs-meta">
            <span class="fcs-industry" data-i18n={`cases.${study.slug}.industry`}>{study.data.industry}</span>
            <span class="fcs-arrow" aria-hidden="true">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M5 12h14M12 5l7 7-7 7"/>
              </svg>
            </span>
          </div>

          <!-- Title -->
          <h3 class="fcs-title" data-i18n={`cases.${study.slug}.title`}>{study.data.title}</h3>

          <!-- Description -->
          <p class="fcs-desc" data-i18n={`cases.${study.slug}.description`}>{study.data.description}</p>

          <!-- Highlights / outcome metrics -->
          {study.data.highlights && study.data.highlights.length > 0 && (
            <div class="fcs-outcomes">
              {study.data.highlights.slice(0, 2).map((h: string, hi: number) => (
                <div class="fcs-outcome">
                  <span class="fcs-outcome-dot" aria-hidden="true"></span>
                  <span data-i18n={`cases.${study.slug}.highlight${hi}`}>{h}</span>
                </div>
              ))}
            </div>
          )}

          <!-- Services row -->
          {study.data.services && study.data.services.length > 0 && (
            <div class="fcs-services">
              {study.data.services.map((s: string, si: number) => (
                <span class="fcs-svc-tag" data-i18n={`cases.${study.slug}.service${si}`}>{s}</span>
              ))}
            </div>
          )}

        </a>
      ))}
    </div>

    <!-- View all link -->
    <div class="fcs-footer reveal">
      <a href="/vaka-calismalari" class="fcs-viewall" data-i18n="caseStudies.viewAll">
        Tüm vaka çalışmalarını gör
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M5 12h14M12 5l7 7-7 7"/>
        </svg>
      </a>
    </div>

  </div>
</section>
)}

<style>
  /* ════ Section ══════════════════════════════════════════════ */
  .fcs-section { background: transparent; }

  /* ════ Header ═══════════════════════════════════════════════ */
  .fcs-header {
    text-align : center;
    max-width  : 42rem;
    margin     : 0 auto 3rem;
  }

  /* ════ Grid ═════════════════════════════════════════════════ */
  .fcs-grid {
    display              : grid;
    grid-template-columns: 1fr;
    gap                  : 1.25rem;
  }
  @media (min-width: 768px) {
    .fcs-grid { grid-template-columns: 1fr 1fr; gap: 1.5rem; }
  }

  /* ════ Card ═════════════════════════════════════════════════ */
  .fcs-card {
    display        : flex;
    flex-direction : column;
    gap            : 1rem;
    padding        : 2rem;
    text-decoration: none;
    color          : inherit;
    /* Richer gradient for feature cards */
    background-image: linear-gradient(
      150deg,
      rgb(var(--color-accent) / 0.05) 0%,
      transparent 50%
    );
  }

  /* Primary card: slightly more prominent */
  .fcs-card--primary {
    background-image: linear-gradient(
      150deg,
      rgb(var(--color-accent) / 0.08) 0%,
      transparent 55%
    );
  }

  /* Top gold gradient rule */
  .fcs-card-rule {
    position  : absolute;
    top       : 0;
    left      : 1.75rem;
    right     : 1.75rem;
    height    : 1px;
    background: linear-gradient(
      to right,
      transparent,
      rgb(var(--color-accent) / 0.45) 25%,
      rgb(var(--color-accent) / 0.65) 50%,
      rgb(var(--color-accent) / 0.45) 75%,
      transparent
    );
  }
  .fcs-card--primary .fcs-card-rule {
    background: linear-gradient(
      to right,
      transparent,
      rgb(var(--color-accent) / 0.55) 25%,
      rgb(var(--color-accent) / 0.80) 50%,
      rgb(var(--color-accent) / 0.55) 75%,
      transparent
    );
  }

  /* Meta row: industry + arrow */
  .fcs-meta {
    display        : flex;
    align-items    : center;
    justify-content: space-between;
  }

  .fcs-industry {
    font-size     : 0.6875rem;
    font-weight   : 700;
    letter-spacing: 0.10em;
    text-transform: uppercase;
    color         : rgb(var(--color-accent));
    padding       : 0.25rem 0.625rem;
    border-radius : 0.3125rem;
    background    : rgb(var(--color-accent) / 0.09);
    border        : 1px solid rgb(var(--color-accent) / 0.20);
  }

  .fcs-arrow {
    color    : rgb(var(--color-fg-faint));
    display  : flex;
    transition: transform 220ms var(--ease-spring), color 220ms ease;
  }
  .fcs-card:hover .fcs-arrow {
    transform: translateX(4px);
    color    : rgb(var(--color-accent));
  }

  /* Title */
  .fcs-title {
    font-size     : 1.125rem;
    font-weight   : 700;
    letter-spacing: -0.022em;
    line-height   : 1.3;
    color         : rgb(var(--color-fg));
    transition    : color 200ms ease;
  }
  .fcs-card:hover .fcs-title { color: rgb(var(--color-accent)); }
  @media (min-width: 768px) {
    .fcs-title { font-size: 1.25rem; }
  }

  /* Description */
  .fcs-desc {
    font-size  : 0.875rem;
    line-height: 1.7;
    color      : rgb(var(--color-fg-muted));
    flex       : 1;
  }

  /* Outcomes */
  .fcs-outcomes {
    display       : flex;
    flex-direction: column;
    gap           : 0.5rem;
    padding       : 1rem;
    border-radius : 0.75rem;
    background    : rgb(var(--color-accent) / 0.05);
    border        : 1px solid rgb(var(--color-accent) / 0.14);
    margin-top    : 0.25rem;
  }
  .fcs-outcome {
    display    : flex;
    align-items: flex-start;
    gap        : 0.625rem;
    font-size  : 0.8125rem;
    line-height: 1.5;
    color      : rgb(var(--color-fg));
  }
  .fcs-outcome-dot {
    width        : 6px;
    height       : 6px;
    border-radius: 9999px;
    background   : rgb(var(--color-accent));
    flex-shrink  : 0;
    margin-top   : 0.35em;
    box-shadow   : 0 0 6px rgb(var(--color-glow) / 0.40);
  }

  /* Services tags */
  .fcs-services {
    display  : flex;
    flex-wrap: wrap;
    gap      : 0.375rem;
    margin-top: 0.25rem;
  }
  .fcs-svc-tag {
    font-size     : 0.6875rem;
    font-weight   : 500;
    color         : rgb(var(--color-fg-faint));
    padding       : 0.1875rem 0.5rem;
    border-radius : 0.3125rem;
    background    : rgb(var(--color-muted));
    border        : 1px solid rgb(var(--color-border));
    white-space   : nowrap;
  }

  /* ════ Footer link ══════════════════════════════════════════ */
  .fcs-footer {
    display        : flex;
    justify-content: center;
    margin-top     : 2.5rem;
  }

  .fcs-viewall {
    display        : inline-flex;
    align-items    : center;
    gap            : 0.5rem;
    font-size      : 0.875rem;
    font-weight    : 600;
    color          : rgb(var(--color-accent));
    text-decoration: none;
    padding        : 0.625rem 1.25rem;
    border-radius  : 0.5rem;
    border         : 1px solid rgb(var(--color-accent) / 0.25);
    background     : rgb(var(--color-accent) / 0.06);
    transition     : background 200ms ease, border-color 200ms ease, gap 200ms var(--ease-spring);
  }
  .fcs-viewall:hover {
    background  : rgb(var(--color-accent) / 0.12);
    border-color: rgb(var(--color-accent) / 0.45);
    gap         : 0.75rem;
  }
  .fcs-viewall:focus-visible {
    outline       : 2px solid rgb(var(--color-ring));
    outline-offset: 3px;
  }
</style>
