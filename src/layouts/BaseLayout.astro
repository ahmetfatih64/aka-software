---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
  seoTitle?: string;
  seoDescription?: string;
}

const { title, description, seoTitle, seoDescription } = Astro.props;

const siteName = "AKA Software";
const metaTitle = seoTitle || `${title} | ${siteName}`;
const metaDesc = seoDescription || description || "Modern ve kurumsal AI Yazilim Danismanlik hizmetleri.";
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/ana_logo.png', Astro.site);
---

<html lang="tr" class="scroll-smooth dark">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/png" href="/ana_logo.png" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{metaTitle}</title>
    <meta name="description" content={metaDesc} />
    <link rel="canonical" href={canonicalURL} />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:title" content={metaTitle} />
    <meta property="og:description" content={metaDesc} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:image" content={ogImage} />

    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={Astro.url} />
    <meta property="twitter:title" content={metaTitle} />
    <meta property="twitter:description" content={metaDesc} />
    <meta property="twitter:image" content={ogImage} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <script is:inline src="/i18n.js" defer></script>
  </head>
  <body class="flex min-h-screen flex-col">

    <!-- Circuit board canvas background -->
    <canvas id="circuit-bg" aria-hidden="true"></canvas>

    <!-- Fixed ambient glow field — layered behind all scrolling content -->
    <div id="page-ambient" aria-hidden="true"></div>

    <Header />
    <main class="flex-1" style="position: relative; z-index: 2;">
      <slot />
    </main>
    <div style="position: relative; z-index: 2;"><Footer /></div>

    <script is:inline>
    /* ═══════════════════════════════════════════════════════════
       AKA Software — Crystal Gem Facet Background  (perf-optimised)
       ZERO shadowBlur · 30fps cap · small mesh · GPU compositing
    ═══════════════════════════════════════════════════════════ */
    (function () {
      'use strict';

      var canvas = document.getElementById('circuit-bg');
      if (!canvas) return;
      var ctx = canvas.getContext('2d');
      var W = 0, H = 0, dpr = 1;

      /* ── Mesh ── */
      var TRIS  = [];   /* {pts[3], cx, cy, seed, phase} */
      var EDGES = [];   /* {ax,ay,bx,by, mx,my, _b} — deduped */

      /* ── Particles ── */
      var PARTS = [];

      /* ── Mouse ── */
      var mx = 0.5, my = 0.35, tmx = 0.5, tmy = 0.35;

      /* ── 30 fps cap ── */
      var lastTs = 0;
      var FPS_INTERVAL = 1000 / 30;

      /* ════ Resize ════════════════════════════════════════════ */
      function resize() {
        dpr = Math.min(window.devicePixelRatio || 1, 2);
        W   = window.innerWidth;
        H   = window.innerHeight;
        canvas.width  = W * dpr;
        canvas.height = H * dpr;
        canvas.style.width  = W + 'px';
        canvas.style.height = H + 'px';
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
        buildMesh();
        buildParticles();
      }

      /* ════ Build mesh — 10×7 = ~140 tris, ~260 edges ════════ */
      function buildMesh() {
        var COLS = 10, ROWS = 7;
        TRIS = []; EDGES = [];
        var verts = [], edgeSet = {};

        for (var r = 0; r <= ROWS; r++) {
          for (var c = 0; c <= COLS; c++) {
            var nx = c / COLS, ny = r / ROWS;
            if (r > 0 && r < ROWS && c > 0 && c < COLS) {
              nx += (Math.random() - 0.5) * 0.06;
              ny += (Math.random() - 0.5) * 0.06;
            }
            verts.push([nx * W, ny * H]);
          }
        }

        function addEdge(ia, ib) {
          var key = ia < ib ? ia+'_'+ib : ib+'_'+ia;
          if (edgeSet[key]) return;
          edgeSet[key] = 1;
          var pa = verts[ia], pb = verts[ib];
          EDGES.push({ ax:pa[0],ay:pa[1],bx:pb[0],by:pb[1],
                       mx:(pa[0]+pb[0])/2, my:(pa[1]+pb[1])/2, _b:0 });
        }

        for (var r = 0; r < ROWS; r++) {
          for (var c = 0; c < COLS; c++) {
            var i00=r*(COLS+1)+c, i10=i00+1, i01=(r+1)*(COLS+1)+c, i11=i01+1;
            var p00=verts[i00],p10=verts[i10],p01=verts[i01],p11=verts[i11];
            if (Math.random()>0.5) {
              addTri(p00,p10,p11); addTri(p00,p11,p01);
              addEdge(i00,i10); addEdge(i10,i11); addEdge(i11,i00);
              addEdge(i11,i01); addEdge(i01,i00);
            } else {
              addTri(p00,p10,p01); addTri(p10,p11,p01);
              addEdge(i00,i10); addEdge(i10,i01); addEdge(i01,i00);
              addEdge(i10,i11); addEdge(i11,i01);
            }
          }
        }
      }
      function addTri(pa,pb,pc) {
        TRIS.push({ pts:[pa,pb,pc],
          cx:(pa[0]+pb[0]+pc[0])/3, cy:(pa[1]+pb[1]+pc[1])/3,
          seed:Math.random(), phase:Math.random()*Math.PI*2 });
      }

      /* ════ Particles — max 20, zero glow ════════════════════ */
      function buildParticles() {
        PARTS = [];
        var n = Math.min(Math.floor((W*H)/22000), 20);
        for (var i=0;i<n;i++) {
          PARTS.push({ x:Math.random()*W, y:Math.random()*H,
            vx:(Math.random()-0.5)*0.12, vy:-(0.06+Math.random()*0.16),
            r:0.5+Math.random()*1.2, a:0.10+Math.random()*0.30,
            ph:Math.random()*Math.PI*2, sp:0.4+Math.random()*0.8 });
        }
      }

      /* ════ Light system ══════════════════════════════════════ */
      function getLights(ts) {
        var S = Math.min(W,H), a1 = ts * 0.000155, a2 = a1 + Math.PI*1.35;
        return [
          { x:W*(0.5+Math.cos(a1)*0.44), y:H*(0.28+Math.sin(a1*1.22)*0.24),
            z:S*(0.52+Math.sin(a1*0.6)*0.14), str:1.00 },
          { x:W*(0.5+Math.cos(a2)*0.28), y:H*(0.55+Math.sin(a2*0.8)*0.18),
            z:S*0.40, str:0.44 },
          { x:mx*W, y:my*H, z:S*0.36, str:0.28 }
        ];
      }
      function ptBright(cx,cy,L) {
        var dx=cx-L.x, dy=cy-L.y;
        return L.str/(1+(dx*dx+dy*dy)/(L.z*L.z));
      }
      function brt(cx,cy,L) {
        var v=ptBright(cx,cy,L[0])+ptBright(cx,cy,L[1])+ptBright(cx,cy,L[2]);
        return v>1?1:v;
      }

      /* ════ Frame — 30fps capped ══════════════════════════════ */
      function frame(ts) {
        requestAnimationFrame(frame);
        if (ts - lastTs < FPS_INTERVAL) return;
        lastTs = ts;

        mx += (tmx-mx)*0.05; my += (tmy-my)*0.05;
        ctx.clearRect(0,0,W,H);

        var L = getLights(ts);
        drawFacets(L, ts);
        drawEdges(L);
        drawParticles(ts);
      }

      /* ─── Facet fills — no shadowBlur ─── */
      function drawFacets(L, ts) {
        for (var i=0; i<TRIS.length; i++) {
          var t = TRIS[i];
          var b = brt(t.cx,t.cy,L) + Math.sin(ts*0.00032+t.phase)*0.025;
          if (b<0) b=0;
          var base = (11 + t.seed*10)|0;
          var lit  = (b*24)|0;
          ctx.beginPath();
          ctx.moveTo(t.pts[0][0],t.pts[0][1]);
          ctx.lineTo(t.pts[1][0],t.pts[1][1]);
          ctx.lineTo(t.pts[2][0],t.pts[2][1]);
          ctx.closePath();
          ctx.fillStyle = 'rgba('+(base+lit)+','+(base+((lit*0.80)|0))+','+((base*0.83)|0+((lit*0.36)|0))+',0.90)';
          ctx.fill();
        }
      }

      /* ─── Crystal edges — NO shadowBlur, bright via lineWidth+alpha ─── */
      function drawEdges(L) {
        /* Single pass — group by brightness bucket to minimise state changes */
        for (var i=0; i<EDGES.length; i++) EDGES[i]._b = brt(EDGES[i].mx,EDGES[i].my,L);

        /* Dim edges: one batched path per alpha bucket (3 buckets) */
        var buckets = [[],[],[]]; /* 0-0.25 | 0.25-0.55 | 0.55-1 */
        for (var i=0; i<EDGES.length; i++) {
          var b = EDGES[i]._b;
          buckets[b<0.25?0:b<0.55?1:2].push(EDGES[i]);
        }

        /* Bucket 0 — very dim */
        ctx.beginPath(); ctx.lineWidth=0.5; ctx.strokeStyle='rgba(161,116,24,0.07)';
        for (var i=0;i<buckets[0].length;i++) {
          var e=buckets[0][i]; ctx.moveTo(e.ax,e.ay); ctx.lineTo(e.bx,e.by);
        }
        ctx.stroke();

        /* Bucket 1 — mid */
        ctx.beginPath(); ctx.lineWidth=0.8; ctx.strokeStyle='rgba(200,148,35,0.18)';
        for (var i=0;i<buckets[1].length;i++) {
          var e=buckets[1][i]; ctx.moveTo(e.ax,e.ay); ctx.lineTo(e.bx,e.by);
        }
        ctx.stroke();

        /* Bucket 2 — bright: draw twice for soft halo without shadowBlur */
        /* Halo pass — wide, low alpha */
        ctx.beginPath(); ctx.lineWidth=2.8; ctx.strokeStyle='rgba(245,214,92,0.10)';
        for (var i=0;i<buckets[2].length;i++) {
          var e=buckets[2][i]; ctx.moveTo(e.ax,e.ay); ctx.lineTo(e.bx,e.by);
        }
        ctx.stroke();
        /* Core pass — thin, high alpha */
        ctx.beginPath(); ctx.lineWidth=1.0; ctx.strokeStyle='rgba(245,214,92,0.70)';
        for (var i=0;i<buckets[2].length;i++) {
          var e=buckets[2][i]; ctx.moveTo(e.ax,e.ay); ctx.lineTo(e.bx,e.by);
        }
        ctx.stroke();
      }

      /* ─── Particles — simple circles, zero glow ─── */
      function drawParticles(ts) {
        for (var i=0; i<PARTS.length; i++) {
          var p=PARTS[i];
          p.x+=p.vx; p.y+=p.vy;
          if (p.y<-8) { p.y=H+8; p.x=Math.random()*W; }
          if (p.x<-8) p.x=W+8; if (p.x>W+8) p.x=-8;
          var pulse = 0.5+0.5*Math.sin(ts*0.00065*p.sp+p.ph);
          var alpha = p.a*pulse*0.50;
          if (alpha<0.02) continue;
          ctx.beginPath();
          ctx.arc(p.x,p.y,p.r*(0.7+pulse*0.3),0,Math.PI*2);
          ctx.fillStyle='rgba(245,214,92,'+alpha+')';
          ctx.fill();
        }
      }

      /* ════ Events ════════════════════════════════════════════ */
      document.addEventListener('mousemove', function(e) {
        tmx=e.clientX/W; tmy=e.clientY/H;
      });
      window.addEventListener('resize', resize);

      /* ════ Boot ══════════════════════════════════════════════ */
      resize();
      requestAnimationFrame(frame);
    }());
    </script>

    <!-- ─── Motion reveal: scroll-triggered entrance animations ─── -->
    <script is:inline>
    (function () {
      /* Skip if user prefers reduced motion */
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      /* Skip if IntersectionObserver not available */
      if (!('IntersectionObserver' in window)) return;

      /* Signal CSS that JS motion is active */
      document.documentElement.setAttribute('data-motion', '');

      var io = new IntersectionObserver(function (entries) {
        entries.forEach(function (e) {
          if (e.isIntersecting) {
            e.target.setAttribute('data-revealed', '');
            io.unobserve(e.target);
          }
        });
      }, { threshold: 0.07, rootMargin: '0px 0px -44px 0px' });

      function observe() {
        document.querySelectorAll('.reveal, .reveal-scale, .reveal-fade')
          .forEach(function (el) { io.observe(el); });
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', observe);
      } else {
        observe();
      }
    }());
    </script>
  </body>
</html>
