---
import { db, ContactMessages, ServiceRequests } from 'astro:db';

interface Props {
  title: string;
  section: 'dashboard' | 'mesajlar' | 'talepler' | 'blog' | 'kullanicilar' | 'ayarlar';
}
const { title, section } = Astro.props;

const allMsgs = await db.select().from(ContactMessages);
const unreadCount = allMsgs.filter((m: any) => !m.isRead).length;
const allReqs = await db.select().from(ServiceRequests);
const pendingCount = allReqs.filter((r: any) => r.status === 'beklemede').length;
const adminUser = import.meta.env.ADMIN_USER ?? 'admin';
---

<!DOCTYPE html>
<html lang="tr">
<head>
  <meta charset="utf-8"/>
  <meta name="viewport" content="width=device-width,initial-scale=1"/>
  <meta name="robots" content="noindex,nofollow"/>
  <title>{title} — AKA Admin</title>
  <link rel="icon" type="image/png" href="/ana_logo.png"/>
  <link rel="preconnect" href="https://fonts.googleapis.com"/>
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet"/>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    :root {
      --adm-bg       : #0b0a09;
      --adm-sidebar  : #0f0d0b;
      --adm-card     : #161310;
      --adm-card-h   : #1d1a16;
      --adm-border   : rgba(161,116,24,0.14);
      --adm-border-h : rgba(161,116,24,0.30);
      --adm-gold     : rgb(217,161,40);
      --adm-gold-b   : rgb(245,214,92);
      --adm-text     : rgba(242,236,224,0.92);
      --adm-muted    : rgba(178,164,144,0.72);
      --adm-faint    : rgba(120,110,90,0.60);
      --adm-green    : rgba(74,222,128,0.90);
      --adm-red      : rgba(248,113,113,0.88);
      --adm-amber    : rgba(251,191,36,0.90);
      --adm-sidebar-w: 240px;
    }
    html, body { height: 100%; }
    body {
      font-family: 'Inter', system-ui, sans-serif;
      background : var(--adm-bg);
      color      : var(--adm-text);
      display    : flex;
      min-height : 100vh;
    }

    /* ─── Sidebar ──────────────────────────────── */
    .adm-sidebar {
      position  : fixed;
      top       : 0; left: 0; bottom: 0;
      width     : var(--adm-sidebar-w);
      background: var(--adm-sidebar);
      border-right: 1px solid var(--adm-border);
      display   : flex;
      flex-direction: column;
      z-index   : 100;
      transition: transform 280ms cubic-bezier(0.22,1,0.36,1);
    }

    /* ─── Sidebar: logo area ────────────────────── */
    .adm-logo-area {
      padding     : 1.5rem 1.25rem 1.25rem;
      border-bottom: 1px solid var(--adm-border);
    }
    .adm-logo-img {
      height    : 36px;
      width     : auto;
      object-fit: contain;
      display   : block;
    }
    .adm-logo-badge {
      margin-top    : 0.5rem;
      font-size     : 0.625rem;
      font-weight   : 600;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color         : rgba(217,161,40,0.60);
    }

    /* ─── Sidebar: nav ──────────────────────────── */
    .adm-nav {
      flex   : 1;
      padding: 1rem 0.625rem;
      display: flex;
      flex-direction: column;
      gap    : 2px;
    }
    .adm-nav-label {
      font-size     : 0.5625rem;
      font-weight   : 600;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color         : var(--adm-faint);
      padding       : 0 0.625rem;
      margin-bottom : 0.375rem;
      margin-top    : 0.75rem;
    }
    .adm-nav-label:first-child { margin-top: 0; }

    .adm-nav-link {
      display       : flex;
      align-items   : center;
      gap           : 0.625rem;
      padding       : 0.5625rem 0.75rem;
      border-radius : 0.625rem;
      font-size     : 0.875rem;
      font-weight   : 500;
      color         : var(--adm-muted);
      text-decoration: none;
      border        : 1px solid transparent;
      transition    : color 150ms ease, background 150ms ease, border-color 150ms ease;
      position      : relative;
    }
    .adm-nav-link:hover {
      color      : var(--adm-text);
      background : rgba(255,255,255,0.04);
    }
    .adm-nav-link.active {
      color       : var(--adm-text);
      background  : rgba(217,161,40,0.10);
      border-color: rgba(217,161,40,0.22);
    }
    .adm-nav-link.active .adm-nav-icon { color: var(--adm-gold); }
    .adm-nav-icon { width: 16px; height: 16px; flex-shrink: 0; }

    .adm-nav-badge {
      margin-left  : auto;
      background   : var(--adm-gold);
      color        : #0b0a09;
      font-size    : 0.5625rem;
      font-weight  : 700;
      padding      : 0.0625rem 0.375rem;
      border-radius: 9999px;
      min-width    : 1.125rem;
      text-align   : center;
    }

    /* ─── Sidebar: bottom user/logout ───────────── */
    .adm-sidebar-bottom {
      padding     : 0.875rem 0.625rem;
      border-top  : 1px solid var(--adm-border);
    }
    .adm-user-info {
      display     : flex;
      align-items : center;
      gap         : 0.625rem;
      padding     : 0.5rem 0.625rem;
      border-radius: 0.625rem;
      margin-bottom: 0.25rem;
    }
    .adm-user-avatar {
      width          : 1.875rem;
      height         : 1.875rem;
      border-radius  : 9999px;
      background     : rgba(217,161,40,0.14);
      border         : 1px solid rgba(217,161,40,0.28);
      display        : inline-flex;
      align-items    : center;
      justify-content: center;
      font-size      : 0.75rem;
      font-weight    : 700;
      color          : var(--adm-gold);
      flex-shrink    : 0;
      text-transform : uppercase;
    }
    .adm-user-name { font-size: 0.8125rem; font-weight: 600; color: var(--adm-text); }
    .adm-user-role { font-size: 0.6875rem; color: var(--adm-faint); }

    .adm-logout-btn {
      display       : flex;
      align-items   : center;
      gap           : 0.5rem;
      width         : 100%;
      padding       : 0.5rem 0.75rem;
      border-radius : 0.625rem;
      font-size     : 0.8125rem;
      font-weight   : 500;
      color         : var(--adm-muted);
      background    : transparent;
      border        : 1px solid transparent;
      cursor        : pointer;
      transition    : color 150ms ease, background 150ms ease, border-color 150ms ease;
      text-align    : left;
    }
    .adm-logout-btn:hover {
      color       : var(--adm-red);
      background  : rgba(248,113,113,0.06);
      border-color: rgba(248,113,113,0.18);
    }

    /* ─── Main content area ─────────────────────── */
    .adm-main {
      flex        : 1;
      margin-left : var(--adm-sidebar-w);
      display     : flex;
      flex-direction: column;
      min-height  : 100vh;
    }

    /* ─── Top bar ───────────────────────────────── */
    .adm-topbar {
      position    : sticky;
      top         : 0;
      z-index     : 50;
      display     : flex;
      align-items : center;
      gap         : 0.75rem;
      padding     : 0 2rem;
      height      : 4rem;
      background  : rgba(11,10,9,0.92);
      border-bottom: 1px solid var(--adm-border);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
    }
    .adm-hamburger {
      display : none;
      align-items: center;
      justify-content: center;
      width   : 2rem;
      height  : 2rem;
      border  : 1px solid var(--adm-border);
      border-radius: 0.5rem;
      background: transparent;
      color   : var(--adm-muted);
      cursor  : pointer;
    }
    .adm-topbar-title {
      font-size  : 0.9375rem;
      font-weight: 600;
      color      : var(--adm-text);
      flex       : 1;
    }
    .adm-topbar-breadcrumb {
      font-size : 0.75rem;
      color     : var(--adm-faint);
    }
    .adm-topbar-breadcrumb span { color: var(--adm-muted); }

    /* ─── Page content ──────────────────────────── */
    .adm-content {
      flex   : 1;
      padding: 2rem;
    }

    /* ─── Mobile overlay ────────────────────────── */
    .adm-overlay {
      display : none;
      position: fixed;
      inset   : 0;
      z-index : 90;
      background: rgba(0,0,0,0.60);
      backdrop-filter: blur(4px);
    }

    /* ─── Responsive ────────────────────────────── */
    @media (max-width: 768px) {
      .adm-sidebar { transform: translateX(-100%); }
      .adm-sidebar.open { transform: translateX(0); }
      .adm-main { margin-left: 0; }
      .adm-hamburger { display: inline-flex; }
      .adm-overlay.open { display: block; }
      .adm-content { padding: 1.25rem; }
      .adm-topbar { padding: 0 1.25rem; }
    }
  </style>
</head>
<body>

  <!-- Sidebar -->
  <aside class="adm-sidebar" id="adm-sidebar">

    <div class="adm-logo-area">
      <img src="/ana_logo.png" alt="AKA Software" class="adm-logo-img"/>
      <div class="adm-logo-badge">Yönetim Paneli</div>
    </div>

    <nav class="adm-nav">
      <div class="adm-nav-label">Genel</div>

      <a href="/admin/dashboard" class={`adm-nav-link${section === 'dashboard' ? ' active' : ''}`}>
        <svg class="adm-nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
          <rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/>
          <rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/>
        </svg>
        Dashboard
      </a>

      <a href="/admin/mesajlar" class={`adm-nav-link${section === 'mesajlar' ? ' active' : ''}`}>
        <svg class="adm-nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
        </svg>
        Mesajlar
        {unreadCount > 0 && <span class="adm-nav-badge">{unreadCount}</span>}
      </a>

      <a href="/admin/talepler" class={`adm-nav-link${section === 'talepler' ? ' active' : ''}`}>
        <svg class="adm-nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
          <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
          <polyline points="14 2 14 8 20 8"/>
          <line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/>
          <polyline points="10 9 9 9 8 9"/>
        </svg>
        Talepler
        {pendingCount > 0 && <span class="adm-nav-badge">{pendingCount}</span>}
      </a>

      <a href="/admin/blog" class={`adm-nav-link${section === 'blog' ? ' active' : ''}`}>
        <svg class="adm-nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/>
        </svg>
        Blog
      </a>

      <div class="adm-nav-label">Yönetim</div>

      <a href="/admin/kullanicilar" class={`adm-nav-link${section === 'kullanicilar' ? ' active' : ''}`}>
        <svg class="adm-nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
          <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
          <circle cx="9" cy="7" r="4"/>
          <path d="M23 21v-2a4 4 0 0 0-3-3.87"/>
          <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
        </svg>
        Kullanıcılar
      </a>

      <a href="/admin/ayarlar" class={`adm-nav-link${section === 'ayarlar' ? ' active' : ''}`}>
        <svg class="adm-nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="3"/>
          <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/>
        </svg>
        Ayarlar
      </a>
    </nav>

    <div class="adm-sidebar-bottom">
      <div class="adm-user-info">
        <div class="adm-user-avatar">{adminUser.charAt(0)}</div>
        <div>
          <div class="adm-user-name">{adminUser}</div>
          <div class="adm-user-role">Yönetici</div>
        </div>
      </div>
      <form method="post" action="/api/admin/logout">
        <button type="submit" class="adm-logout-btn">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
            <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/>
            <polyline points="16 17 21 12 16 7"/>
            <line x1="21" y1="12" x2="9" y2="12"/>
          </svg>
          Çıkış Yap
        </button>
      </form>
    </div>

  </aside>

  <!-- Mobile overlay -->
  <div class="adm-overlay" id="adm-overlay"></div>

  <!-- Main -->
  <div class="adm-main">

    <header class="adm-topbar">
      <button class="adm-hamburger" id="adm-hamburger" aria-label="Menü">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <path d="M3 12h18M3 6h18M3 18h18"/>
        </svg>
      </button>
      <div class="adm-topbar-title">{title}</div>
      <div class="adm-topbar-breadcrumb">
        <span>AKA Software</span> / {title}
      </div>
    </header>

    <main class="adm-content">
      <slot />
    </main>

  </div>

  <script is:inline>
    var hamburger = document.getElementById('adm-hamburger');
    var sidebar   = document.getElementById('adm-sidebar');
    var overlay   = document.getElementById('adm-overlay');
    function toggleSidebar() {
      sidebar.classList.toggle('open');
      overlay.classList.toggle('open');
    }
    hamburger.addEventListener('click', toggleSidebar);
    overlay.addEventListener('click', toggleSidebar);
  </script>

</body>
</html>
