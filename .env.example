# ── AKA Software — Environment Variables ─────────────────────────────────
# Copy this file to .env for local development.
# In production, set these as environment variables on your server/platform.
# .env is gitignored — NEVER commit secrets.
# ─────────────────────────────────────────────────────────────────────────

# SQLite database path for @astrojs/db.
# LOCAL: .astro/ is auto-created at build time. This default is fine.
# PRODUCTION: use a PERSISTENT path (e.g. mounted volume) — data is lost
#             on redeploy if you point to a path inside the project dir.
# Example server path: /data/aka/astro.db
ASTRO_DATABASE_FILE=./.astro/astro.db

# Admin panel access token — /admin/mesajlar?token=<value>
# Generate a secure value: openssl rand -base64 32
ADMIN_SECRET=change-me-to-a-secure-random-string

# Backend API URL — only needed when the frontend is served from a different
# origin than the API. Leave empty for the single-server deployment.
PUBLIC_API_URL=

# n8n webhook powering the AI assistant (self-hosted n8n).
# Optional — chat.ts falls back to the production webhook when unset.
N8N_WEBHOOK_URL=https://62.238.105.156.sslip.io/webhook/aka-chat
